#!/usr/bin/env bash
# pa <proyecto> "<tarea>" — delega una tarea a un Claude que corre DENTRO del proyecto.
#
# Es el gemelo no interactivo de `p`. `p` abre una sesión para que la maneje el dueño con el
# teclado; `pa` la corre en modo -p (headless) para que la maneje el orquestador de ~ por
# Bash. Misma ventaja que `p`: al hacer cd a la ruta real, el worker carga el CLAUDE.md del
# proyecto y su memoria propia (Claude indexa la memoria por cwd), sin el contexto de los
# otros 30 proyectos.
#
# Lo que vuelve por stdout es SOLO el resultado corto del worker. El JSON completo queda en
# ~/.local/state/pa/<proyecto>/. Esa asimetría es todo el punto: la delegación le tiene que
# costar diez líneas de contexto al orquestador, no un volcado.
#
# Uso:
#   pa <proyecto> "<tarea>"              delegar (el worker puede escribir)
#   pa <proyecto> --leer "<pregunta>"    sólo lectura (Read/Grep/Glob + git de lectura por Bash, sin Edit)
#                                        NO toma el lock: corre en paralelo con el que escribe y con otros --leer
#                                        (pero sí cuenta para el tope global, PA_TOPE)
#   pa <proyecto> --seguir "<tarea>"     retomar la conversación guardada (default: limpia)
#                                        (se niega si esa sesión ya compactó; --force lo saltea)
#                                        Si su último uso fue hace más de PA_CACHE_FRIO_MIN (default 55; 0 = apagado)
#                                        el caché de prompt (1 h) ya se enfrió: NO la retoma, arranca una sesión
#                                        nueva (en el mismo puesto y rama) y lo avisa por stderr
#   pa <proyecto> --aca "<tarea>"        correr en el tree principal, no en un worktree (ve lo sin commitear)
#   pa <proyecto> --integrar <id>        mergear la rama de esa corrida en el tree principal (ff, sin forzar)
#   pa <proyecto> --actualizar <id>      rebasear la rama de esa corrida sobre main (sesión limpia, en su
#                                        puesto, resolviendo conflictos): lo que se hace después de un 80
#   pa <proyecto> --ramas                ramas de workers sin integrar
#   pa <proyecto> --descartar <id>       tirar la rama de esa corrida (borra sus commits: confirmarlo antes)
#   pa <proyecto> --async "<tarea>"      lanzar desacoplado y volver enseguida
#   pa <proyecto> -m <modelo> "<tarea>"  elegir modelo (sin -m elige `reparto` según --tipo y el cupo de cada
#                                        suscripción; si reparto no responde, ~/.config/trama/modelos.json o el
#                                        default de pa: claude-sonnet-5-5 high, claude-haiku-5-5 xhigh para
#                                        --tipo mecanico). -m acepta claude-…, gemini-{4-argon,3.8-flash}-{low,medium,high},
#                                        agy:{claude-{opus,sonnet}-5-5-{low,medium,high},gpt-oss-120b-medium},
#                                        codex:{gpt-6.1-sol,gpt-6-sol,gpt-6-luna,gpt-6-astra}-{low,medium,high} (ChatGPT) y
#                                        ollama:<modelo> (sin effort; servidor caído o sin el modelo → sale 95)
#   pa --modelos [--json]                tabla efectiva tipo → modelo (de dónde salió y qué elige reparto hoy), Gemini y locales
#   pa --cupo-gemini [--json]            cupo de cada suscripción (Claude oficial y Google AI Pro/agy; alias de reparto --cupos)
#   pa <proyecto> --effort medium "<t>"  esfuerzo del worker (o env PA_EFFORT). haiku low..max (default xhigh);
#                                        sonnet low|medium|high|xhigh (default high, también --leer; es el modelo default);
#                                        opus (sólo con -m) low|medium|high|xhigh (default: plan pro → medium,
#                                        plan max → el de settings). Sale 2: max fuera de haiku y
#                                        cualquier fable, salvo con --ok-dueno
#   pa <proyecto> --ok-dueno ...         el dueño aprobó ESTA corrida: deja pasar opus max, sonnet max y fable.
#                                        Sin variable de entorno; un --seguir no lo hereda (va de nuevo)
#   pa <proyecto> --tipo <tipo> "<t>"    clasificar la corrida (o env PA_TIPO): mecanico | lectura | codigo-acotado |
#                                        codigo-multi | frontend | diseno | debug | final. Va a medicion.tsv y al .hilo;
#                                        es lo que agrupa `pa --rinde`. Un --seguir sin --tipo hereda el de la retomada
#   pa <proyecto> --cuenta <id> "<t>"   correr con esa cuenta de la suscripción (bin/cuentas; default: la de
#                                        más cupo libre del proveedor del modelo, o la de siempre si hay una sola)
#   pa --plan [pro|max]                  ver / cambiar el plan de la suscripción (pro = modo ahorro, el default)
#                                        (se guarda en ~/.local/state/pa/plan; PA_PLAN del entorno le gana)
#   pa <proyecto> --mcp "<tarea>"        dejarle los MCP de claude.ai (default: apagados)
#   pa <proyecto> --matar                matar el worker que escribe ahí (los --leer no)
#   pa <proyecto> --matar --leer|--id ID bajar todos los --leer vivos / una corrida puntual
#   pa <proyecto> --olvidar              descartar la sesión guardada
#   pa --esperar <proyecto> [--timeout N] [--id ID]
#                          entregar el resultado más viejo no entregado (o el de la corrida ID);
#                          si no hay ninguno, bloquear hasta que el worker termine
#   pa --nota "<texto>"                  nota del jefe para el traspaso (también combinable: pa <p> --nota '…' '<tarea>')
#   pa --limpiar [--si]                  build viejo (>7 días) de worktrees libres; dry-run sin --si
#   pa --traspaso                       armar el traspaso del jefe desde el estado (para retomar a mano)
#   pa --bien <id> si|no|parcial         anotar si esa corrida salió bien (columna `bien` de medicion.tsv)
#   pa --bien-auto                       completar solo `bien`, `integrada` y `retrabajo` desde integradas.tsv
#   pa --rinde [--dias N] [--json]       tipo × modelo × effort: n, % integrada sin retrabajo, mediana de turnos,
#                                        costo medio y % que compactó (default: últimos 30 días)
#   pa --esperar-todos [--timeout N]     cobrar TODAS tus corridas async pendientes, de todos los proyectos,
#                                        en una sola llamada (un turno del jefe para N resultados)
#   pa --estado                          qué corre ahora y qué sesión hay guardada por proyecto
#
# Códigos de salida: 0 ok · 1 el worker falló · 2 error de uso · 75 ya hay uno corriendo (o el tope global PA_TOPE está lleno) ·
#                    76 límite de sesión de la suscripción · 77 API sobrecargada ·
#                    78 terminó sin RESULTADO · 79/80 --integrar se negó / chocó ·
#                    81 la instalación de claude está rota · 84 claude no está en el PATH ·
#                    83 --integrar se negó: la rama trae un symlink peligroso ·
#                    87 no pude preparar el worktree del puesto (nunca cae al tree principal) · 130 matado.
#
# Puestos: hasta PA_PUESTOS (default 3) workers que escriben corren EN PARALELO en el mismo
# proyecto, cada uno en su worktree fijo (`worktrees/<slug>`, `worktrees/<slug>@2`, …) y su rama.
# Ver PLAN-puestos.md.
# Tope global: nunca más de PA_TOPE (o $STATE/tope; default 10) workers vivos entre TODOS los proyectos y jefes,
# contando writers, --leer y --aca, y además sólo se admite uno si hay RAM (MemAvailable >= PA_RAM_WORKER_MB +
# PA_RAM_RESERVA_MB, menos lo reservado para los recién admitidos; el primero entra siempre). Sin lugar o sin RAM:
# 75 en primer plano, EN COLA con --async. Nunca mata a nadie.
set -euo pipefail

# Los scripts de ~/orquestador se llaman entre ellos por nombre (`proyecto-ruta`). Ponemos
# nuestro propio directorio adelante del PATH en vez de confiar en que quien nos llama lo
# tenga: un timer de systemd, un cron o un hook arrancan con un PATH pelado y todo salía 127.
_BIN="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
case ":$PATH:" in *":$_BIN:"*) ;; *) export PATH="$_BIN:$PATH" ;; esac

# Nombre del dueño de esta instalación: TRAMA_DUENO -> `dueno` de perfil.json -> $USER con mayúscula
# inicial -> "el usuario". Nunca un nombre fijo en el código. `D` arma un texto con @DUENO@.
nombre_dueno() {
  local n="${TRAMA_DUENO:-}" p u
  if [[ -z "$n" ]]; then
    p="${TRAMA_PERFIL:-${XDG_CONFIG_HOME:-$HOME/.config}/trama/perfil.json}"
    [[ -r "$p" ]] && n="$(jq -r '.dueno // empty' "$p" 2>/dev/null)"
  fi
  if [[ -z "$n" ]]; then u="${USER:-$(id -un 2>/dev/null)}"; [[ -n "$u" ]] && n="${u^}"; fi
  printf '%s' "${n:-el usuario}"
}
D() {
  local t="${1//@DUENO@/$(nombre_dueno)}"
  t="${t// a el usuario/ al usuario}"; t="${t// de el usuario/ del usuario}"
  printf '%s' "$t"
}

# PA_STATE existe para los tests: les deja un estado de mentira aparte y así no pisan las
# sesiones guardadas de verdad. En uso normal nadie lo setea.
STATE="${PA_STATE:-$HOME/.local/state/pa}"
LOCKDIR="$STATE/lock"
# PA_PROJ, igual que PA_STATE: sólo para los tests (pa le crea al worktree su carpeta de proyecto).
PROJ="${PA_PROJ:-$HOME/.claude/projects}"
LIMITE="$STATE/limite.hasta"
# Los hooks salen de al lado nuestro, no de una ruta fija: si no, un checkout de prueba
# (o tests/run.sh) lanza workers con los hooks INSTALADOS y no con los que está probando.
_HOOKS="$(dirname "$_BIN")/hooks"
LATIDO="$_HOOKS/latido.sh"
GUARD="$_HOOKS/destructive-guard.sh"
mkdir -p "$STATE" "$LOCKDIR"

# --- puestos ------------------------------------------------------------------------------
# Cuántos workers que ESCRIBEN pueden correr a la vez en un mismo proyecto. Cada puesto es un
# worktree FIJO con su lock (cargo hashea la ruta del crate: un worktree por corrida recompilaría
# todo cada vez; uno fijo por puesto paga el recompilado una sola vez en la vida). El puesto 1 usa
# los nombres de antes de los puestos (`lock/<slug>`, `worktrees/<slug>`, `<slug>.running`), así
# que nada existente se movió; el k>=2 lleva `@k`, y el tree principal (--aca) `@aca`.
# PA_PUESTOS=1 es el comportamiento de antes: un writer por proyecto y el resto en cola.
# --- plan de la suscripción (2026-10-02) --------------------------------------------------
# `pro` = modo ahorro: un punto menos de effort (opus medium), menos turnos, sin subagentes y sin el
# SendMessage del resultado (cada mensaje le abre al jefe un turno con TODO su contexto). `max` =
# opus con el effort de settings y 150 turnos. Sale de PA_PLAN, si no de `$STATE/plan`, si no `pro`.
# Volver a Max: `pa --plan max` (lo corre el jefe cuando el dueño avisa que cambió de suscripción).
plan_de() {
  local p="${PA_PLAN:-}"
  [[ -z "$p" && -f "$STATE/plan" ]] && p="$(head -n1 "$STATE/plan" | tr -d '[:space:]')"
  p="${p,,}"; printf '%s' "${p:-pro}"
}
PLAN="$(plan_de)"
# Un plan inválido no traba nada (tampoco la gestión: --matar, --integrar): avisa y ahorra.
[[ "$PLAN" == pro || "$PLAN" == max ]] || { echo "pa: plan '$PLAN' no existe (PA_PLAN o $STATE/plan: pro o max); sigo como pro." >&2; PLAN=pro; }

# Umbral de compactación de los workers. Con los modelos de 1M (Opus 5.5, Sonnet 5.5) el default
# del CLI es ~967k: un worker sin tope relee casi un millón de tokens por turno antes de compactar.
# Ya no hay recargo arriba de 200k (doc model-config, 2026-10): el tope es por volumen, no por precio.
# PA_AUTOCOMPACT existe para el experimento de "compactar antes" (se anota en medicion.tsv).
AUTOCOMPACT="${PA_AUTOCOMPACT:-180000}"
if ! [[ "$AUTOCOMPACT" =~ ^[0-9]+$ ]] || (( AUTOCOMPACT < 100000 || AUTOCOMPACT > 1000000 )); then
  echo "pa: PA_AUTOCOMPACT='$AUTOCOMPACT' no va (tokens, entre 100000 y 1000000); sigo con 180000." >&2
  AUTOCOMPACT=180000
fi

PUESTOS="${PA_PUESTOS:-3}"
[[ "$PUESTOS" =~ ^[1-9][0-9]*$ ]] || { echo "pa: PA_PUESTOS tiene que ser un número >= 1 (vino '$PUESTOS')." >&2; exit 2; }

# --- tope global de workers (2026-10-11) --------------------------------------------------
# Cuántos workers pueden estar vivos a la vez entre TODOS los proyectos y todos los jefes: writers,
# --leer y --aca. PA_PUESTOS es por proyecto y los --leer no toman puesto, así que nada frenaba a un
# jefe que lanzaba veinte juntos: el 2026-10-11 la RAM llegó a 30,4 de 32,7 GB más swap y
# systemd-oomd cerró la pestaña entera del jefe, con sus 396 procesos. Ver tomar_lugar.
# Sale de PA_TOPE, si no de `$STATE/tope` (lo deja `scripts/instalar.sh --servidor`: 2 en el Dell), si no 10.
# Desde 2026-10-21 ese número es un TECHO duro (el límite de la suscripción): el freno de verdad es la RAM
# (ver ram_alcanza): un worker entra sólo si MemAvailable alcanza para su costo más la reserva del jefe.
TOPE="${PA_TOPE:-}"
[[ -z "$TOPE" && -f "$STATE/tope" ]] && { read -r TOPE <"$STATE/tope" || true; TOPE="${TOPE//[[:space:]]/}"; }
TOPE="${TOPE:-10}"
[[ "$TOPE" =~ ^[1-9][0-9]*$ ]] || { echo "pa: PA_TOPE (o $STATE/tope) tiene que ser un número >= 1 (vino '$TOPE')." >&2; exit 2; }
# Admisión por RAM (MB). Costo: pico medido de un worker (árbol claude + hijos, RSS) el 2026-10-21: 0,3-0,6 GB
# en lo normal, 1,3-1,7 GB con cargo/node/tests en marcha; 2048 cubre el pico. Reserva: lo que tiene que
# quedar libre para el jefe, el escritorio y el swap (6 GB). 0 y 0 apagan la regla (queda sólo el techo).
# PA_RAM_RECIEN_MIN: cuántos minutos se le reserva su costo a un worker recién admitido (su RAM todavía no
# aparece en MemAvailable). PA_MEMINFO apunta a otro meminfo (para los tests).
RAM_WORKER_MB="${PA_RAM_WORKER_MB:-2048}"
RAM_RESERVA_MB="${PA_RAM_RESERVA_MB:-6144}"
RAM_RECIEN_MIN="${PA_RAM_RECIEN_MIN:-3}"
for _v in RAM_WORKER_MB RAM_RESERVA_MB RAM_RECIEN_MIN; do
  [[ "${!_v}" =~ ^[0-9]+$ ]] || { echo "pa: PA_${_v} tiene que ser un número >= 0 (vino '${!_v}')." >&2; exit 2; }
done
unset _v

# --- candado anti-recursión -------------------------------------------------------------
# ~/CLAUDE.md se carga tambien dentro del worker (Claude busca CLAUDE.md hacia arriba desde
# el cwd, y los proyectos cuelgan de ~). Ahí dice "delegá con pa", así que un worker podría
# llamarse a sí mismo y quedar esperando el lock que tiene su propio padre. El env var corta
# eso de raíz; el contrato de abajo se lo dice ademas en castellano, y el flock es -n.
if [[ -n "${PA_WORKER:-}" ]]; then
  echo "pa: sos un worker delegado, no podés delegar de nuevo. Hacé la tarea vos." >&2
  exit 1
fi

# --- candado de modelo local (2026-10-02) -----------------------------------------------
# Una sesión de Claude Code apuntada a un modelo LOCAL (claude-local exporta CLAUDE_LOCAL=1 y un
# ANTHROPIC_BASE_URL a 127.0.0.1) no delega: la GPU no entra dos modelos locales a la vez, y el
# worker heredaría el BASE_URL local o pediría otro modelo. Sale 88 antes de cualquier lock o
# worktree. Pasan sólo las consultas que no lanzan ni retoman nada: --estado, --hilos, --hilo, --plan sin
# argumento, `pa <proy> --ramas` y la ayuda.
modelo_local() {
  [[ "${CLAUDE_LOCAL:-}" == 1 ]] && return 0
  [[ "${ANTHROPIC_BASE_URL:-}" =~ ^([a-zA-Z]+://)?(localhost|127\.[0-9.]+|\[::1\]|::1)([:/]|$) ]]
}
if modelo_local; then
  case "${1:-}" in
    --estado|--hilos|--hilo|--modelos|-h|--help|--ayuda) local_pasa=1 ;;
    --plan) [[ -z "${2:-}" ]] && local_pasa=1 ;;
    *) [[ $# -eq 2 && "${2:-}" == --ramas ]] && local_pasa=1 ;;
  esac
  if [[ -z "${local_pasa:-}" ]]; then
    echo "pa: esta sesión corre contra un modelo LOCAL (CLAUDE_LOCAL=${CLAUDE_LOCAL:-} ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL:-}); no delego. La GPU no entra dos modelos locales a la vez, y el worker heredaría el BASE_URL local o pediría otro modelo. Delegá desde una sesión normal de claude. (Pasan sólo pa --estado, pa --plan, pa --hilos/--hilo, pa <proy> --ramas.)" >&2
    exit 88
  fi
fi

# --- contrato de salida -----------------------------------------------------------------
# Sin esto el worker contesta como si hablara con una persona y devuelve diffs y logs que se
# comen el contexto del orquestador. La linea de "no preguntes" evita el cuelgue clasico del
# headless: un worker esperando una respuesta que nadie va a escribir.
CONTRATO='Te delegó una tarea el orquestador de @DUENO@ (una sesión de Claude que corre en ~).
NO estás hablando con @DUENO@: tu respuesta final la lee otro modelo.

Respondé corto, en este formato exacto:
RESULTADO: 1-3 oraciones de qué hiciste o qué encontraste.
ARCHIVOS: rutas que tocaste, o "ninguno".
DECISION: qué tiene que decidir @DUENO@, o "nada".
SIGUE: una línea con el próximo paso del proyecto si el trabajo sigue, o "nada" si quedó cerrado.

Qué merece DECISION o PREGUNTA: SÓLO el rumbo: publicar, borrar algo que no se recupera, plata, qué
se muestra al público o un cambio de alcance. Todo lo demás lo resolvés vos con un default razonable y
lo contás como supuesto en RESULTADO: lo mecánico o técnico (numeración de migraciones, versión de
caché de sw.js, conflictos de merge, nombres de archivos, orden de commits) y también las
microdecisiones de gusto (un celeste más claro o más oscuro, el texto de un botón, el orden de dos
columnas). Desplegar o no lo decide el jefe: no preguntes, ponelo en SIGUE. No son preguntas para
@DUENO@: "¿Cómo resolvemos el choque de la migración 0008?", "¿Subo CACHE de sw.js a v12?", "¿Subo el
caché en esta rama?", "¿El celeste más claro o más oscuro?". Tus suposiciones van en RESULTADO,
nunca en DECISION: un "nada. Supuestos: …" cuenta como pendiente.

Verificá vos todo lo que puedas verificar (tests, ejecución headless, el medidor, curl a un servidor
local, un screenshot que puedas mirar) y contá el resultado en RESULTADO: "probé X y anda" va ahí,
NO en PROBAR. @DUENO@ no es tu tester: cada PROBAR es un pendiente suyo.

Idioma: el texto de RESULTADO, DECISION y SIGUE va en español, con oraciones completas y sin
jerga abreviada: los tres van tal cual al tablero de @DUENO@ y nadie los traduce. La primera oración
de DECISION es el título del pendiente: tiene que decir qué hay que decidir y entenderse sola, sin
haber leído el resto (mal: "Dos cosas para @DUENO@."; bien: "Decidir si se borra la tabla vieja de
sesiones."). Los cuatro encabezados van literales; escribí exactamente `DECISION: nada` cuando no
hay nada que decidir y `SIGUE: nada` cuando el trabajo quedó cerrado.
Si hay una decisión genuina, además de la DECISION en prosa podés sumar, al final (después del SIGUE,
separado por una línea vacía), un bloque de preguntas para que @DUENO@ conteste con un toque. Una
pregunta por cada PREGUNTA:, un campo por línea:
PREGUNTA: la pregunta en una línea, con palabras simples (sin ids, rutas ni jerga)
CONTEXTO: una o dos líneas que alcancen para decidir
OPCION: una opción corta (de 2 a 4 líneas OPCION:)
DEFECTO: el número de la opción que elegirías vos (1 a 4)
Si el bloque no respeta el formato se ignora entero y queda sólo la DECISION: por eso la DECISION en
prosa tiene que seguir diciendo todo. PROBAR sólo si probarlo exige algo que vos no tenés: el hardware
o la cuenta de @DUENO@, otra persona, o su juicio sobre un cambio visual GRANDE. Como máximo UNA línea
`PROBAR: <qué mirar, en palabras simples>` por corrida, al final; nunca un comando (los comandos los
corrés vos), ni una línea por variante o caso. Si no hay nada así, no pongas PROBAR. Ambos bloques
son opcionales.
Think and talk in terse English while you work (the tokenizer is cheaper in English). Files you
write (code, comments, docs, CLAUDE.md, commit messages) keep the language the project already uses.

Nada de diffs, logs ni volcados de código, salvo que la tarea los pida explícitamente.
Commiteá ANTES de cualquier comando largo (tests, builds), no al final: si te quedás sin
turnos, lo commiteado no se pierde. Lo largo va en FOREGROUND pasándole al tool Bash su
parámetro `timeout` en MILISEGUNDOS (ej. timeout: 600000 = 10 min, que es el máximo). El
`timeout 540 <cmd>` del SHELL no alcanza: el tool corta a los 120s igual y te manda el
comando a background. `run_in_background` está BLOQUEADO por un hook, no lo intentes: en
headless nadie te despierta cuando termina y morís polleando la salida.
Vos sos el worker: no delegues a nadie. No llames a `pa` ni a `p`. El trabajo lo hacés vos.
No uses `git stash` ni `git add -A`: puede haber otra sesión trabajando en el mismo repo sin
commitear. Agregá los archivos que tocaste, uno por uno. (Hay un hook que lo bloquea igual.)
No compiles release ni instales nada (`tauri build`, `cargo <sub> --release`, `cargo install`): lo
hace el jefe después de integrar (un hook lo bloquea). Probá con cargo test/check o build debug.'

# --- tarea de cierre --------------------------------------------------------------------
# Lo que se le manda a un worker que se quedó sin turnos, como resume de su propia sesión. Es
# corto a propósito: cerrar no es seguir trabajando. 15 turnos alcanzan de sobra (el cierre
# real del 2026-09-13 usó 9) y el tope evita que un cierre desbocado cueste más que la tarea.
CIERRE_TURNOS=15
CIERRE_TAREA='Te quedaste sin turnos. NO sigas con la tarea: cerrá.
1) Commiteá, archivo por archivo, SOLO lo que tocaste vos (nada de `git add -A`, `-u` ni `.`).
2) Respondé con el bloque RESULTADO / ARCHIVOS / DECISION / SIGUE, y en DECISION decí explícitamente
   qué quedó sin terminar.
Si no hay nada tuyo para commitear, decilo y reportá igual. Nada de empezar trabajo nuevo.'

# Sin jefe alcanzable (cron, timer, terminal suelta) el worker no tiene a quién preguntar.
SIN_JEFE='No hagas preguntas: no hay nadie del otro lado para contestarlas. Si te falta información,
tomá la suposición más razonable, seguí, y decí cuál tomaste en DECISION.'

# El contrato de un worker Gemini (agy): el mismo, sin lo que es del harness de Claude (el
# parámetro timeout del tool Bash, run_in_background). En agy un comando largo pasa solo a async
# y el modelo lo sigue con command_status, sin perder la corrida.
CONTRATO_AGY="${CONTRATO%%Commiteá ANTES*}Commiteá ANTES de cualquier comando largo (tests, builds), no al final: si la corrida se corta,
lo commiteado no se pierde. Un comando largo pasa solo a segundo plano: seguilo con command_status
hasta que termine y no lances otro encima. Tu respuesta final es texto plano con el bloque de arriba.
Vos sos el worker:${CONTRATO#*Vos sos el worker:}"
# El de un worker de codex (ChatGPT): sin el parámetro timeout del tool Bash ni run_in_background,
# y sin command_status (eso es de agy). En codex un comando bloquea hasta que termina.
CONTRATO_CODEX="${CONTRATO%%Commiteá ANTES*}Commiteá ANTES de cualquier comando largo (tests, builds), no al final: si la corrida se corta,
lo commiteado no se pierde. Corré los comandos en primer plano (nada de &, nohup ni setsid): nadie te
avisa cuando termina algo que quedó en segundo plano. Tu respuesta final es texto plano con el bloque de arriba.
Vos sos el worker:${CONTRATO#*Vos sos el worker:}"

# Con jefe (una sesión de Claude viva en esta máquina) hay canal de ida y vuelta por
# SendMessage, pero SÓLO para preguntas. El resultado NO viaja por mensaje: el jefe ya lo
# recibe por `pa --esperar`, y el mensaje del worker (bypass) le queda "held" al jefe cuando
# éste está en otra clase de modo (plan mode): el dueño veía el diálogo "Held message from
# another session" por cada worker que terminaba (2026-10-01). Probado el 2026-09-09: el
# mensaje del jefe llega al worker porque los dos corren con bypassPermissions (y el
# settings_json pone crossSessionInbound=accept por las dudas).
con_jefe() {   # $1 = nombre del jefe
  # Vale en los dos planes: además del "held" en plan mode, el mensaje le costaba al worker
  # ~2 turnos con todo su contexto y al jefe un turno entero con TODO el suyo por worker;
  # --esperar puede juntar varios resultados en un solo turno.
  printf '%s' "Tu jefe es la sesión de Claude llamada \"$1\". NO le mandes el resultado por
SendMessage: tu respuesta final con el bloque RESULTADO/ARCHIVOS/DECISION/SIGUE ya le llega sola. Si
te trabás en algo que sólo él puede decidir (no lo técnico que podés resolver), preguntale con SendMessage
(to: \"$1\"; no hace falta ListAgents) y seguí con lo demás: la respuesta llega entre herramientas. Si después de 3
herramientas no llegó, tomá la suposición más razonable y decila en DECISION. Nada de avisos de
progreso ni de \"terminé\"."
}

# El jefe es la sesión de Claude que está arriba nuestro en el árbol de procesos: subimos por
# el ppid hasta un pid que tenga registro en ~/.claude/sessions/. Con --async el hijo queda
# huérfano (setsid), así que el nombre se calcula ANTES del fork y viaja en PA_JEFE.
jefe_campo() {   # $1 = campo del json de la sesión (name | sessionId)
  local p="$PPID" f
  while [[ -n "$p" && "$p" != 1 && "$p" != 0 ]]; do
    f="$HOME/.claude/sessions/$p.json"
    [[ -f "$f" ]] && { jq -r --arg c "$1" '.[$c] // empty' "$f" 2>/dev/null; return; }
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')"
  done
}
jefe_nombre() {
  if [[ -n "${PA_JEFE+x}" ]]; then printf '%s' "$PA_JEFE"; return; fi
  jefe_campo name
}
# El nombre sirve para SendMessage, pero NO para saber de quién es una corrida: Shark cambia de
# nombre cada vez que reinicia (shark-0d, shark-4a, shark-dd) y conserva el sessionId. Con varios
# writers por proyecto, "cuál es mío" (--esperar pelado, --matar pelado, --seguir sin --id) se
# decide por esto. Si el nombre vino fijado a mano (PA_JEFE, tests, --sin-jefe) y el id no, el id
# es el nombre: así no se mezcla el nombre de uno con el sessionId de la sesión que está arriba.
jefe_id() {
  if [[ -n "${PA_JEFE_ID+x}" ]]; then printf '%s' "$PA_JEFE_ID"; return; fi
  if [[ -n "${PA_JEFE+x}" ]]; then printf '%s' "$PA_JEFE"; return; fi
  jefe_campo sessionId
}

# --- helpers compartidos ----------------------------------------------------------------
leer_campo() { sed -n "/^$2=/{s///p;q}" "$1" 2>/dev/null; }

# `tablero` (bin/tablero) nunca rompe ni demora a pa: toda llamada va con tope de tiempo, sin
# stderr ni stdin, y el que llama le pone `|| true` (o tira lo que dijo: una ficha a medias no va).
# Con un PA_STATE de mentira (tests) y sin TABLERO_DIR no se llama: escribiría en el tablero real.
# PA_TABLERO: otro binario (tests: uno ausente o colgado).
TABLERO="${PA_TABLERO:-$_BIN/tablero}"
tablero_mudo() {   # $1 = tope en segundos, resto = argumentos de tablero
  [[ -x "$TABLERO" ]] || return 1
  [[ -n "${TABLERO_DIR:-}" || -z "${PA_STATE:-}" ]] || return 1
  timeout -k 1 "$1" "$TABLERO" "${@:2}" 2>/dev/null </dev/null
}

# Después de un --integrar que entró: `main` al remoto del repo. Lo hace bin/repos-empujar --repo, que
# es quien sabe cuál es ese remoto, que nunca se fuerza y que a GitHub no se empuja. Nunca rompe ni
# frena la integración: sin un remoto de los configurados ni se lanza; con uno, va con tope corto
# (PA_EMPUJE_MAX, default 10s) y lo que falle es una línea: lo reintenta el timer repos-empujar.
# Qué remotos cuentan y cómo se llama el servidor en las líneas de aviso salen de config, no del
# código: PA_EMPUJE_REMOTOS ("nombre1 nombre2") y PA_EMPUJE_ETIQUETA, o ~/.config/trama/empuje.json
# ({"remotos":["…"],"etiqueta":"…"}; TRAMA_EMPUJE lo redirige). Sin nada configurado la función
# está apagada (en la instalación de un tercero ni existe repos-empujar).
# PA_EMPUJAR: otro binario (tests). Con un PA_STATE de mentira su estado cae ahí adentro y, sin
# TABLERO_DIR, no anota en el tablero (mismo criterio que tablero_mudo).
EMPUJAR="${PA_EMPUJAR:-$_BIN/repos-empujar}"
empujar_main() {   # $1 = tree principal
  local rs tope="${PA_EMPUJE_MAX:-10}" sal rc=0 l tb="$TABLERO" st="${REPOS_EMPUJAR_STATE:-}"
  local remotos="${PA_EMPUJE_REMOTOS:-}" etq="${PA_EMPUJE_ETIQUETA:-}" cfg r hay=0
  [[ -x "$EMPUJAR" ]] || return 0
  if [[ -z "$remotos" ]]; then
    cfg="${TRAMA_EMPUJE:-${XDG_CONFIG_HOME:-$HOME/.config}/trama/empuje.json}"
    [[ -r "$cfg" ]] || return 0
    remotos="$(jq -r '(.remotos // []) | map(strings) | join(" ")' "$cfg" 2>/dev/null)"
    [[ -n "$etq" ]] || etq="$(jq -r '.etiqueta // "" | strings' "$cfg" 2>/dev/null)"
  fi
  [[ -n "$remotos" ]] || return 0
  [[ "$tope" =~ ^[0-9]+$ ]] && (( tope > 0 )) || tope=10
  rs=$'\n'"$(git -C "$1" remote 2>/dev/null || true)"$'\n'
  for r in $remotos; do [[ "$rs" == *$'\n'"$r"$'\n'* ]] && hay=1; done
  (( hay )) || return 0
  etq="${etq:-Remoto}"
  if [[ -n "${PA_STATE:-}" ]]; then
    [[ -n "$st" ]] || st="$STATE/repos-empujar"
    [[ -n "${TABLERO_DIR:-}" ]] || tb="/no-hay-tablero"
  fi
  sal="$(env REPOS_EMPUJAR_TABLERO="$tb" ${st:+REPOS_EMPUJAR_STATE="$st"} \
         timeout -k 2 "$((tope + 5))" "$EMPUJAR" --repo "$1" --tope "$tope" 2>&1 </dev/null)" || rc=$?
  if (( rc == 124 || rc == 137 )); then
    echo "— $etq: el empuje de main no terminó en ${tope}s; queda para la próxima pasada de repos-empujar."
    return 0
  fi
  while IFS= read -r l; do
    if [[ -n "$l" ]]; then echo "— $etq: $l"; fi
  done <<<"$sal"
  return 0
}

# El tree principal de un repo, visto desde cualquiera de sus worktrees (el primero que lista git).
tree_principal() { git -C "$1" worktree list --porcelain 2>/dev/null | sed -n '1s/^worktree //p'; }

# Cuántos commits de la rama le faltan al HEAD del tree principal. Es LA medida de "trabajo sin
# integrar": los commits de la rama (base..rama) no sirven, porque una rama ya mergeada los sigue
# teniendo. El 2026-09-14 `workers` gritaba "ramas sin integrar" por cuatro ramas 100% en main y
# el jefe lanzó tres workers de auditoría sobre diffs vacíos.
commits_pendientes() {   # $1 = repo o worktree, $2 = rama
  local ppal; ppal="$(tree_principal "$1")"; [[ -n "$ppal" ]] || ppal="$1"
  git -C "$ppal" rev-list --count "HEAD..$2" 2>/dev/null || echo 0
}

# --- archivos sin commitear ---------------------------------------------------------------
# Todos los workers de un repo comparten UN working tree, así que "hay N archivos sucios" no
# quiere decir "el worker perdió N archivos". El 2026-09-13 el jefe reportó como trabajo
# perdido de un worker dos archivos que llevaban OCHO días modificados por otra sesión: `pa`
# calculaba el baseline al arrancar y después, al salir, contaba el total. De acá en adelante
# siempre se compara contra el baseline.
# Sin las líneas de symlinks sueltos que apuntan FUERA del propio repo: cache enlazada a mano
# (o por pa, con un nombre que enlazar_caches no conoce — "venv" a secas en vez de ".venv") no
# es trabajo del worker, aunque el .gitignore del proyecto no la tape (barra final: sólo
# matchea directorios, no el symlink). Mismo criterio que excluir_symlinks_externos, pero acá
# filtra el status en vez del staging: gym-tracker 2026-09-27, --integrar salía 86 por esto.
sucios_de() {   # $1 = repo o worktree
  local ruta="$1" l p resuelto build
  # en un worktree de pa, un dir de build suelto (dirs_de_build) tampoco es trabajo: ni abre
  # una rama huérfana vacía ni frena un --integrar con 86
  build="$(dirs_de_build "$ruta")"
  while IFS= read -r l; do
    [[ -n "$l" ]] || continue
    p="$(ruta_porcelain "$l")"
    [[ -n "$build" && "$l" == '??'* ]] && grep -qxF -- "${p%/}" <<<"$build" && continue
    # sólo lo SUELTO (`??`): un symlink trackeado reapuntado afuera es un cambio de verdad
    if [[ "$l" == '??'* && -L "$ruta/$p" ]]; then
      resuelto="$(readlink -f -- "$ruta/$p" 2>/dev/null)"
      [[ -n "$resuelto" && "$resuelto" != "$ruta"/* ]] && continue
    fi
    printf '%s\n' "$l"
  done < <(git -C "$ruta" status --porcelain 2>/dev/null)
  return 0
}
contar_lineas() { [[ -z "$1" ]] && { printf 0; return; }; printf '%s\n' "$1" | grep -c . || true; }

# Ruta de una línea porcelain: dos chars de estado + espacio, y en un rename lo que vale es el
# destino ("R  viejo -> nuevo"). Las rutas con caracteres raros vienen entre comillas.
ruta_porcelain() {
  local l="${1:3}"
  [[ "$l" == *" -> "* ]] && l="${l##* -> }"
  l="${l%\"}"; l="${l#\"}"
  printf '%s' "$l"
}

# " (el más viejo de hace 8 días)" — o vacío si no se pudo medir. Es lo que distingue "el
# worker anterior murió hace diez minutos" de "esto es trabajo huérfano que nadie va a cerrar".
edad_sucios() {   # $1 = ruta del repo, $2 = lista porcelain
  local ruta="$1" lista="$2" ahora viejo="" m f l
  [[ -n "$lista" ]] || return 0
  ahora="$(date +%s)"
  while IFS= read -r l; do
    [[ -n "$l" ]] || continue
    f="$(ruta_porcelain "$l")"
    m="$(stat -c %Y "$ruta/$f" 2>/dev/null)" || continue
    [[ -n "$m" ]] || continue
    [[ -z "$viejo" || "$m" -lt "$viejo" ]] && viejo="$m"
  done <<<"$lista"
  [[ -n "$viejo" ]] || return 0
  local dias=$(( (ahora - viejo) / 86400 ))
  if (( dias >= 1 )); then printf ', el más viejo de hace %d día(s)' "$dias"
  else printf ', el más viejo de hace %dh' $(( (ahora - viejo) / 3600 )); fi
}

# Qué quedó sucio POR CULPA DE ESTA CORRIDA. Es lo único que el jefe tiene que mirar para
# decidir si hay que cerrar al worker: lo que ya estaba antes no es trabajo en riesgo.
# Imprime una frase lista para pegar en un mensaje de error, y sale 0 si hay delta, 1 si no.
delta_sucios() {   # $1 = ruta del repo, $2 = lista porcelain del arranque, $3 = epoch del arranque (opcional)
  local ruta="$1" base="$2" ini="${3:-}" ahora nuevos total l m
  ahora="$(sucios_de "$ruta")"
  total="$(contar_lineas "$ahora")"
  if (( total == 0 )); then
    printf 'El repo quedó limpio: no hay trabajo en riesgo.\n'
    return 1
  fi
  # Comparación por línea porcelain completa: un archivo que el worker MODIFICÓ encima de uno
  # ajeno cambia de estado (" M" -> "MM", "??" -> " M") y tiene que contar como suyo.
  nuevos="$(printf '%s\n' "$ahora" | grep -vxF -f <(printf '%s\n' "$base") 2>/dev/null || true)"
  # El que lo editó sin cambiarle el estado (" M foo" sigue " M foo") no aparece arriba: con el
  # arranque a mano, un archivo del baseline con mtime POSTERIOR cuenta como tocado.
  if [[ "$ini" =~ ^[0-9]+$ && -n "$base" ]]; then
    while IFS= read -r l; do
      [[ -n "$l" ]] || continue
      [[ $'\n'"$nuevos"$'\n' == *$'\n'"$l"$'\n'* ]] && continue
      m="$(stat -c %Y -- "$ruta/$(ruta_porcelain "$l")" 2>/dev/null)" || continue
      [[ "$m" =~ ^[0-9]+$ ]] && (( m > ini )) && nuevos+="${nuevos:+$'\n'}$l"
    done <<<"$ahora"
  fi
  local n; n="$(contar_lineas "$nuevos")"
  if (( n == 0 )); then
    printf 'Archivos sin commitear: %d — NINGUNO es de este worker (los %d ya estaban al arrancar%s). No hay trabajo suyo en riesgo.\n' \
           "$total" "$total" "$(edad_sucios "$ruta" "$base")"
    return 1
  fi
  printf 'Archivos sin commitear: %d — %d de este worker (%s)' "$total" "$n" \
         "$(printf '%s\n' "$nuevos" | while IFS= read -r l; do [[ -n "$l" ]] && ruta_porcelain "$l"; done | sed -n 1,5p | paste -sd' ')"
  (( total > n )) && printf '; los otros %d ya estaban al arrancar%s' $(( total - n )) "$(edad_sucios "$ruta" "$base")"
  printf '.\n'
  return 0
}

# ~/llama.cpp -> -home-<usuario>-llama-cpp  (igual que hace Claude Code)
escapar() { printf '%s' "$1" | sed 's/[^A-Za-z0-9]/-/g'; }

slug_de() {   # ruta real -> clave de estado. Minúscula: `pa miapp` y `pa MiApp` comparten
  local s; s="$(basename "$1")"; s="${s//[^A-Za-z0-9._-]/-}"; printf '%s' "${s,,}"
}

# Un `.running` puede quedar colgado si al `pa` lo matan con -9. El pid que guarda es el del
# CLAUDE (no el de pa): si ese proceso ya no está, no hay worker.
# El primer .running se escribe ANTES del fork, con pid vacío. En esa ventana (que --async
# deja ver: vuelve apenas el hijo toma el lock) el pid vacío se leía como "muerto" y
# `workers` cantaba HUÉRFANO sobre un worker sano. Si no hay pid todavía, vale el de pa.
# ========================================================================================
# worktree por proyecto
# ========================================================================================
# El flock serializa a los workers en el TIEMPO, pero hasta el 2026-09-13 todos compartían
# UN working tree: uno que moría sin commitear le dejaba los archivos al siguiente (BUGS.md 5),
# y una sesión `p` del dueño compartía tree con el worker. Ahora cada corrida que ESCRIBE corre
# en `$STATE/worktrees/<slug>`, en su rama `pa/<slug>/<ts>`, sacada del HEAD del tree
# principal. El jefe integra con `pa <proyecto> --integrar <ts>`; pa nunca mergea solo.
#
# Worktrees FIJOS, reusados, no uno por corrida: cargo mete el path del crate en el hash de los
# artefactos, así que un path nuevo recompila el workspace (en un proyecto Rust grande: 43 s y +7 GB de target la
# primera vez; después, caliente). Medido el 2026-09-13. Desde 2026-09-26 son uno por PUESTO
# (worktrees/<slug>, worktrees/<slug>@2, …: ver tomar_puesto), no uno por proyecto.
#
# Lo que NO va al worktree: `--leer` (no escribe), `--aca` / `--sucio-mio` (el worker tiene
# que ver lo sin commitear del tree principal), y los proyectos sin git.
usa_worktree=0
ruta_trabajo=""      # dónde corre el claude: el worktree o el tree principal
rama=""; base=""     # rama de esta corrida y el commit del que salió

# El build cache no se copia: se comparte. El target de cargo va por env (cargo toma un lock
# de archivo sobre él, y el flock de pa ya serializa igual); node_modules, .venv y .env por
# symlink. Lo demás que esté gitignoreado (data/, sqlite) NO está: si un worker lo necesita
# falla ruidoso y se relanza con --aca. Se agrega acá cuando pase de verdad, no antes.
enlazar_caches() {   # $1 = tree principal, $2 = worktree
  local d rel f
  while IFS= read -r d; do
    rel="${d#"$1"/}"
    [[ -e "$2/$rel" ]] || { mkdir -p "$2/$(dirname "$rel")"; ln -s "$d" "$2/$rel"; }
  done < <(find "$1" -maxdepth 3 -type d -name node_modules -prune 2>/dev/null)
  # .venv/.env son cache y config; CLAUDE.local.md y .claude/settings.local.json son las
  # instrucciones locales del proyecto (gitignoreadas): sin ellas el worker perdería lo que
  # El dueño le dijo a ese proyecto sin que nada falle.
  for f in .venv .env CLAUDE.local.md .claude/settings.local.json; do
    [[ -e "$1/$f" && ! -e "$2/$f" ]] && { mkdir -p "$2/$(dirname "$f")"; ln -s "$1/$f" "$2/$f"; }
  done
  [[ -f "$1/Cargo.toml" ]] && export CARGO_TARGET_DIR="$1/target"
  return 0
}

# El reverso de enlazar_caches: saca esos symlinks del disco. Se llama SIEMPRE antes de tocar
# HEAD en el worktree (commit huérfano, checkout, rebase). Así el huérfano nunca los trackea —
# sin depender del .gitignore del proyecto, que con `node_modules/` A SECAS (barra final) sólo
# matchea DIRECTORIOS, no el symlink que dejamos ahí: eso fue lo que rompió un proyecto Rust el
# 2026-09-17 (f662d98/8581de0/2725726/2db70e1). También evita que un checkout adentro del
# worktree falle con "untracked would be overwritten". enlazar_caches los vuelve a poner
# después: sólo crea lo que falta, así que llamarla de nuevo es gratis.
desenlazar_caches() {   # $1 = worktree
  local f
  while IFS= read -r f; do rm -f "$f"; done < <(find "$1" -maxdepth 3 -type l -name node_modules 2>/dev/null)
  for f in .venv .env CLAUDE.local.md .claude/settings.local.json; do
    [[ -L "$1/$f" ]] && rm -f "$1/$f"
  done
  return 0
}

# Red de seguridad además de desenlazar_caches: cualquier symlink que esté por entrar al commit
# huérfano y cuyo destino resuelva FUERA del worktree se saca del staging, venga de donde venga
# (no sólo de la lista de arriba). Tampoco depende del .gitignore del proyecto.
excluir_symlinks_externos() {   # $1 = worktree
  local wt="$1" p modo resuelto
  while IFS= read -r p; do
    modo="$(git -C "$wt" ls-files -s -- "$p" 2>/dev/null | cut -d' ' -f1)"
    [[ "$modo" == "120000" ]] || continue
    resuelto="$(readlink -f -- "$wt/$p" 2>/dev/null)"
    if [[ -z "$resuelto" || "$resuelto" != "$wt"/* ]]; then
      git -C "$wt" reset -q -- "$p" 2>/dev/null
      echo "pa: OJO: '$p' es un symlink que apunta fuera del worktree ($resuelto); no lo commiteo." >&2
    fi
  done < <(git -C "$wt" diff --cached --name-only 2>/dev/null)
  return 0
}

# Directorios de build/cache de un worktree de pa (rutas relativas, uno por línea): por nombre
# (target, target-wt, node_modules, .venv, dist, __pycache__) o porque tienen CACHEDIR.TAG
# (cargo lo pone en todo target dir, se llame como se llame). Nunca symlinks (find -type d), y
# nunca uno con archivos trackeados (un dist/ versionado es del proyecto). Sólo adentro de
# $STATE/worktrees: un tree principal nunca entra acá. Un proyecto Rust, 2026-10-02: un huérfano (d35795cc)
# metió target-wt/ (5261 archivos) en main porque target-wt no estaba en su .gitignore.
# Con $2 = borrar, un dir con CACHEDIR.TAG que no está en la lista de nombres sólo vale si es de
# cargo (.rustc_info.json): huggingface también pone CACHEDIR.TAG en su hub (decisor, 1.1 GB de
# modelos en models/hf/hub). Para commitear se excluyen igual; para borrar, no.
dirs_de_build() {   # $1 = worktree, $2 = "borrar" (opcional)
  local wt="$1" modo="${2:-}" d rel
  [[ "$wt" == "$STATE/worktrees/"* && -e "$wt/.git" ]] || return 0
  while IFS= read -r d; do
    rel="${d#"$wt"/}"
    if [[ "$modo" == borrar ]]; then
      case "${d##*/}" in
        target|target-wt|node_modules|.venv|dist|__pycache__) ;;
        *) [[ -e "$d/.rustc_info.json" ]] || continue ;;
      esac
    fi
    [[ -n "$(git -C "$wt" ls-files -- "$rel" 2>/dev/null)" ]] && continue
    printf '%s\n' "$rel"
  done < <(find "$wt" -maxdepth 4 -name .git -prune -o -type d \
             \( -name target -o -name 'target-wt' -o -name node_modules -o -name .venv -o -name dist \
                -o -name __pycache__ -o -exec test -e '{}/CACHEDIR.TAG' \; \) -print -prune 2>/dev/null)
  return 0
}

# Borra los dirs de build de un worktree de pa. El que llama tiene que tener el puesto (flock).
# Sin barra final en el rm: con barra, un symlink se atravesaría hasta el tree principal.
limpiar_build() {   # $1 = worktree
  local wt="$1" rel
  while IFS= read -r rel; do
    [[ -n "$rel" ]] && rm -rf -- "${wt:?}/$rel"
  done < <(dirs_de_build "$wt" borrar)
  return 0
}

# La memoria de proyecto de Claude se indexa por cwd: un worker en el worktree escribiría en
# `~/.claude/projects/<worktree escapado>/memory` y el proyecto tendría dos memorias. Se
# apunta la del worktree a la del tree principal ANTES de lanzar el claude.
compartir_memoria() {   # $1 = tree principal, $2 = worktree
  local de="$PROJ/$(escapar "$1")/memory" a="$PROJ/$(escapar "$2")"
  mkdir -p "$de" "$a"
  [[ -e "$a/memory" ]] || ln -s "$de" "$a/memory"
}

# --- puestos: nombres, candado de git --------------------------------------------------------
# Sufijo de estado/lock/worktree de un puesto: 1 -> "" (los nombres de siempre), k -> "@k", aca -> "@aca".
suf_puesto() { [[ "${1:-1}" == 1 ]] || printf '@%s' "$1"; }
wt_de_puesto()   { printf '%s' "$STATE/worktrees/$slug$(suf_puesto "$1")"; }
lock_de_puesto() { printf '%s' "$LOCKDIR/$slug$(suf_puesto "$1")"; }
# Libre = nadie tiene su flock. Se sonda con un open nuevo: ojo, desde el mismo proceso que ya lo
# tiene tomado por otro fd da "ocupado" (flock es por open file description).
# Compartido (-s): dos sondeos a la vez no se ven "ocupado" entre ellos (con exclusivo, dos
# --integrar simultáneos se daban 75 el uno al otro); un holder exclusivo sí da ocupado.
puesto_libre() { flock -n -s "$(lock_de_puesto "$1")" true 2>/dev/null; }

# El puesto donde corrió una corrida. Las de antes de los puestos no tienen `puesto=`: se deduce
# de `ruta_trabajo` (worktrees/<slug> -> 1, worktrees/<slug>@k -> k, cualquier otra -> tree principal).
puesto_de_corrida() {   # $1 = .corrida
  local p rt
  p="$(leer_campo "$1" puesto)"; [[ -n "$p" ]] && { printf '%s' "$p"; return; }
  rt="$(leer_campo "$1" ruta_trabajo)"
  case "$rt" in
    "$STATE/worktrees/$slug")    printf 1 ;;
    "$STATE/worktrees/$slug@"*)  printf '%s' "${rt##*@}" ;;
    *)                           printf aca ;;
  esac
}
# El puesto de un worktree por su ruta (para las ramas checkouteadas que lista `git worktree list`).
puesto_de_ruta() {   # $1 = ruta de un worktree
  case "$1" in
    "$STATE/worktrees/$slug")    printf 1 ;;
    "$STATE/worktrees/$slug@"*)  printf '%s' "${1##*@}" ;;
    *)                           printf aca ;;
  esac
}
# El worktree donde está checkouteada una rama, o nada.
# Nada en un pipe de pa puede dejar de leer antes de tiempo (`| head`, `awk …exit`, `grep -q`):
# el de la izquierda muere por SIGPIPE, pipefail lo vuelve el status del pipe y `set -e` mata a
# pa sin decir nada (rc 141). Pasó acá con la rama en un puesto que no era el último de la lista
# (2026-09-26). Lo cuida un test de tests/run.sh.
wt_de_rama() {   # $1 = rama
  git -C "$ruta" worktree list --porcelain 2>/dev/null \
    | awk -v b="branch refs/heads/$1" '/^worktree /{w=substr($0,10)} $0==b && !f{print w; f=1}'
}

# Candado de git: `lock/<slug>@git`, siempre CORTO (segundos). Envuelve toda mutación de refs o
# worktrees del repo (worktree add/prune, checkout, commit huérfano, integrar, descartar, podar):
# con varios puestos arrancando a la vez, un `worktree prune` le borraba el registro a un
# `worktree add` a medio hacer. Orden fijo: primero el puesto, después git. Quien tiene git sólo
# prueba puestos con -n, así que no hay deadlock. fd 8 (el 9 es el del puesto).
tomar_git() {   # $@ = flags de flock (-n | -w N)
  exec 8>"$LOCKDIR/$slug@git"
  flock "$@" 8 || { exec 8>&-; return 1; }
}
soltar_git() { exec 8>&-; }

# Huérfanos: en un worktree de pa TODO es de pa, así que lo que quedó sin commitear (un worker que
# murió) se commitea entero en la rama que estaba, y listo. Es lo que no se podía hacer en el tree
# principal, donde lo sucio podía ser del dueño. Los symlinks que pa mismo puso (enlazar_caches) se
# sacan ANTES de mirar el status, así que ni aparecen como sucios. Con puestos esto es lo NORMAL:
# el puesto k lo usó otra corrida después de X y quedó en otra rama, con restos; por eso se llama
# antes de CUALQUIER checkout en un puesto reusado. Requiere el candado de git.
commitear_huerfano() {   # $1 = worktree
  local wt="$1" anterior
  desenlazar_caches "$wt"
  # mismo filtro que sucios_de: con sólo un symlink suelto externo abría una rama huérfana vacía
  [[ -n "$(sucios_de "$wt")" ]] || return 0
  anterior="$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)"
  [[ "$anterior" == HEAD ]] && { anterior="pa/$slug/huerfano-$ts"; git -C "$wt" checkout -qB "$anterior"; }
  # Nunca artefactos de build (dirs_de_build), estén o no en el .gitignore del proyecto.
  local -a fuera=(); local rel
  while IFS= read -r rel; do [[ -n "$rel" ]] && fuera+=(":(exclude,literal)$rel"); done < <(dirs_de_build "$wt")
  git -C "$wt" add -A -- . "${fuera[@]}"
  (( ${#fuera[@]} )) && echo "pa: no commiteo artefactos de build del huérfano: ${fuera[*]#:(exclude,literal)}" >&2
  excluir_symlinks_externos "$wt"
  if ! git -C "$wt" diff --cached --quiet 2>/dev/null; then
    git -C "$wt" commit -qm "pa: huérfano de $anterior" >/dev/null 2>&1
    echo "pa: el worktree $(basename "$wt") tenía trabajo huérfano; quedó commiteado en '$anterior'." >&2
  fi
  return 0
}

# El worktree de un puesto, creado si no existe. Requiere el candado de git.
asegurar_worktree() {   # $1 = worktree
  local wt="$1"
  [[ -e "$wt/.git" ]] && return 0
  mkdir -p "$(dirname "$wt")"
  # Si alguien borró el directorio a mano, git lo sigue teniendo registrado y el `add` falla.
  git -C "$ruta" worktree prune >/dev/null 2>&1 || true
  git -C "$ruta" worktree add --detach "$wt" HEAD >/dev/null 2>&1 \
    || { echo "pa: no pude crear el worktree en $wt." >&2; return 1; }
}

# Deja $ruta_trabajo/$rama/$base/$usa_worktree listos en el puesto que ya tomamos. Con una corrida
# a retomar ($1 = su ts) vuelve a ESA rama en ESE puesto; sin ella, rama nueva desde el HEAD.
# NUNCA cae al tree principal: si no puede, sale 87 (hasta el 2026-09-26 un checkout fallido
# corría el `--seguir` en el tree del dueño, sin avisar).
preparar_worktree() {   # $1 = ts de la corrida que se retoma (o vacío / "-"), $2 = puesto
  local retomada="${1:-}" p="$2" wt
  ruta_trabajo="$ruta"; rama=""; base=""
  (( leer )) && return 0
  [[ "$p" == aca ]] && return 0
  git -C "$ruta" rev-parse -q --verify HEAD >/dev/null 2>&1 || return 0   # sin git o sin commits: tree principal
  wt="$(wt_de_puesto "$p")"
  if ! tomar_git -w 60; then
    echo "pa: el candado de git de '$slug' ($LOCKDIR/$slug@git) sigue tomado después de 60s. No arranco." >&2
    return 87
  fi
  if ! asegurar_worktree "$wt"; then soltar_git; return 87; fi
  commitear_huerfano "$wt"
  if [[ -n "$retomada" && "$retomada" != "-" ]]; then
    rama="$(leer_campo "$dir/$retomada.corrida" rama)"; base="$(leer_campo "$dir/$retomada.corrida" base)"
    if ! git -C "$wt" checkout -q "$rama" 2>"$dir/$ts.checkout.err"; then
      soltar_git; enlazar_caches "$ruta" "$wt"
      echo "pa: no pude volver a la rama $rama en $wt: $(head -c 300 "$dir/$ts.checkout.err" | tr '\n' ' ')" >&2
      echo "pa: NO corro en el tree principal. Mirá la rama con: git -C '$ruta' worktree list" >&2
      rm -f "$dir/$ts.checkout.err"; rama=""; base=""
      return 87
    fi
    rm -f "$dir/$ts.checkout.err"
  else
    base="$(git -C "$ruta" rev-parse HEAD)"
    rama="pa/$slug/$ts"
    if ! git -C "$wt" checkout -qB "$rama" "$base" 2>/dev/null; then
      soltar_git; enlazar_caches "$ruta" "$wt"
      echo "pa: no pude sacar la rama $rama en $wt. NO corro en el tree principal." >&2
      rama=""; base=""
      return 87
    fi
  fi
  soltar_git
  enlazar_caches "$ruta" "$wt"
  compartir_memoria "$ruta" "$wt"
  ruta_trabajo="$wt"; usa_worktree=1
}

# El puesto que le toca a un --seguir: el de la corrida que retoma (su transcript vive bajo la
# carpeta de proyecto de ESE cwd, y `--resume` lo busca por cwd). Si esa corrida corrió en el tree
# principal, o su rama ya no existe (integrada o descartada), es el tree principal.
puesto_para_retomar() {   # $1 = ts de la corrida retomada, o "-"
  local c r
  [[ "$1" == "-" ]] && { printf aca; return; }
  c="$dir/$1.corrida"
  [[ -f "$c" ]] || { printf aca; return; }
  r="$(leer_campo "$c" rama)"
  [[ -n "$r" ]] || { printf aca; return; }
  if ! git -C "$ruta" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1; then
    echo "pa: la rama $r de la corrida $1 ya no existe (¿integrada o descartada?): la retomo en el tree principal." >&2
    printf aca; return
  fi
  puesto_de_corrida "$c"
}

# Los otros writers vivos del proyecto: "id<TAB>puesto<TAB>jefe<TAB>tarea".
otros_writers() {   # $1 = ts propio
  local r p
  for r in "$STATE/$slug.running" "$STATE/$slug"@*.running; do
    [[ -f "$r" ]] && vivo "$r" || continue
    [[ "$(leer_campo "$r" id)" == "$1" ]] && continue
    p="$(leer_campo "$r" puesto)"
    printf '%s\t%s\t%s\t%s\n' "$(leer_campo "$r" id)" "${p:-1}" "$(leer_campo "$r" jefe)" "$(leer_campo "$r" tarea)"
  done
}
# Al jefe, por stderr: con quién comparte el repo esta corrida. Si tocan lo mismo, choca al integrar.
avisar_paralelo() {   # $1 = ts propio, $2 = puesto propio
  local id p j t
  while IFS=$'\t' read -r id p j t; do
    [[ "$p" == aca ]] && p="tree principal" || p="puesto $p"
    echo "pa: corre en paralelo con $id ($p, jefe ${j:-?}): ${t:0:100}" >&2
  done < <(otros_writers "$1")
  return 0
}

# Qué corre en cada uno de esos puestos, una línea por puesto (para el 75 y la cola).
describir_puestos() {   # $@ = puestos
  local k r
  for k in "$@"; do
    r="$STATE/$slug$(suf_puesto "$k").running"
    if [[ -f "$r" ]]; then
      printf '    %s: id %s · jefe %s · %.80s\n' "$([[ "$k" == aca ]] && echo 'tree principal' || echo "puesto $k")" \
        "$(leer_campo "$r" id)" "$(leer_campo "$r" jefe)" "$(leer_campo "$r" tarea)"
    else
      printf '    %s: tomado (arrancando)\n' "$([[ "$k" == aca ]] && echo 'tree principal' || echo "puesto $k")"
    fi
  done
}

# --- tope global: lugares ---------------------------------------------------------------
# Cada worker vivo tiene tomado uno de los lugares globales: un flock sobre `lock/@tope@<k>` (fd 6)
# que su pa conserva hasta salir (el `@` no puede salir en un slug, así que no choca con los locks
# de los puestos). Es un flock y no una cuenta de `.running`: lo suelta el kernel cuando el pa
# muere, sea como sea, así que un HUÉRFANO (`.running` con el claude muerto) no ocupa lugar y no
# hay nada que limpiar. El claude NO hereda el fd (ver correr): un `cargo test` que lo sobreviva
# dejaría el lugar tomado para siempre.
# La decisión se toma bajo el candado `lock/@tope` (fd 5): ahí se sondean TODOS los lugares (los
# libres se sueltan enseguida, salvo el que se queda) y se cuenta. Sin candado, ese sondeo de un pa
# en cola le hacía ver el tope lleno a otro que llegaba justo. El candado queda TOMADO al volver 0
# (el que escribe prueba ahí mismo su puesto, y si no hay devuelve el lugar sin que nadie lo haya
# visto ocupado): hay que llamar a soltar_tope.
lugar=""    # el lugar global de esta corrida, o vacío
soltar_tope()  { exec 5>&-; }
soltar_lugar() { exec 6>&-; lugar=""; ram_soltar; }

# Claudes vivos cuyo pa ya no está (lo mataron con -9 y el claude siguió): no tienen lugar tomado,
# pero siguen ocupando RAM, así que cuentan. Sin forks -> REPLY.
workers_sueltos() {
  local f c p n=0
  for f in "$STATE"/*.running; do
    [[ -f "$f" ]] || continue
    campo_rapido "$f" pid; c="$REPLY"
    campo_rapido "$f" pa_pid; p="$REPLY"
    [[ "$c" =~ ^[0-9]+$ && "$p" =~ ^[0-9]+$ ]] || continue
    kill -0 "$p" 2>/dev/null && continue
    kill -0 "$c" 2>/dev/null && n=$(( n + 1 ))
  done
  REPLY="$n"
}

# --- admisión por RAM (2026-10-21) -------------------------------------------------------
# MemAvailable en MB -> REPLY (-1 si no se puede leer: sin dato no se frena a nadie).
mem_disponible_mb() {
  local k v _ f="${PA_MEMINFO:-/proc/meminfo}"
  REPLY=-1
  [[ -r "$f" ]] || return 0
  while read -r k v _; do
    if [[ "$k" == MemAvailable: ]]; then [[ "$v" =~ ^[0-9]+$ ]] && REPLY=$(( v / 1024 )); return 0; fi
  done <"$f"
  return 0
}
# Un worker recién admitido todavía no usó su RAM: MemAvailable no la refleja y una ráfaga de pa
# pasaría toda junta. Cada lugar tomado deja `lock/@ram/<pid del pa>` con la hora de admisión; se
# reserva el costo entero de los que tienen menos de RAM_RECIEN_MIN minutos y su pa sigue vivo. Los
# vencidos o de pa muertos se borran acá. Suma -> REPLY (MB).
ram_reservada_mb() {
  local f p t ahora n=0 vence=$(( RAM_RECIEN_MIN * 60 ))
  printf -v ahora '%(%s)T' -1
  for f in "$LOCKDIR"/@ram/*; do
    [[ -f "$f" ]] || continue
    p="${f##*/}"; t=""; read -r t <"$f" || true
    if [[ "$t" =~ ^[0-9]+$ ]] && (( ahora - t < vence )) && kill -0 "$p" 2>/dev/null; then
      n=$(( n + RAM_WORKER_MB ))
    else rm -f "$f"; fi
  done
  REPLY="$n"
}
ram_reservar() { mkdir -p "$LOCKDIR/@ram"; printf '%(%s)T' -1 >"$LOCKDIR/@ram/$$"; }
ram_soltar()   { rm -f "$LOCKDIR/@ram/$$"; }
# Deja ram_disp / ram_reservada / ram_hace_falta (MB) y, si no alcanza, ram_motivo. 0 = hay RAM para uno
# más. $1 = cuántos workers vivos hay: con 0 entra siempre (el piso es 1: sin él, un jefe con la RAM
# justa quedaría sin poder delegar nada).
ram_alcanza() {
  mem_disponible_mb; ram_disp="$REPLY"
  ram_reservada_mb;  ram_reservada="$REPLY"
  ram_hace_falta=$(( RAM_WORKER_MB + RAM_RESERVA_MB ))
  ram_motivo=""
  (( ${1:-0} == 0 || ram_disp < 0 )) && return 0
  (( ram_disp - ram_reservada >= ram_hace_falta )) && return 0
  ram_motivo="RAM: disponible $ram_disp MB, reservada $ram_reservada MB (workers recién admitidos), hacen falta $ram_hace_falta MB (costo $RAM_WORKER_MB + reserva $RAM_RESERVA_MB)"
  return 1
}
ram_disp=-1 ram_reservada=0 ram_hace_falta=0 ram_motivo="" motivo_tope=""

# 0 = tomó un lugar (fd 6) y deja el candado del tope tomado; 1 = tope lleno o sin RAM (nada tomado;
# `motivo_tope` dice cuál).
tomar_lugar() {
  local k f fd ocupados=0 mio="" max="$TOPE" vivos
  exec 5>"$LOCKDIR/@tope"
  flock -w 30 5 || { exec 5>&-; return 1; }
  # otro pa puede correr con un PA_TOPE más alto: sus lugares también cuentan
  for f in "$LOCKDIR"/@tope@*; do
    k="${f##*@}"
    [[ "$k" =~ ^[0-9]+$ ]] && (( k > max )) && max="$k"
  done
  for (( k = 1; k <= max; k++ )); do
    exec {fd}>"$LOCKDIR/@tope@$k"
    if flock -n "$fd"; then
      [[ -z "$mio" ]] && { exec 6>&"$fd"; mio="$k"; }
    else
      ocupados=$(( ocupados + 1 ))
    fi
    exec {fd}>&-
  done
  workers_sueltos
  vivos=$(( ocupados + REPLY ))
  if [[ -n "$mio" ]] && (( vivos < TOPE )); then
    if ram_alcanza "$vivos"; then lugar="$mio"; ram_reservar; return 0; fi
    motivo_tope="$ram_motivo"
  else
    motivo_tope="tope global: $TOPE workers vivos"
  fi
  ocupados_tope="$vivos"
  exec 6>&-
  soltar_tope
  return 1
}
ocupados_tope=0   # cuántos contó el último tomar_lugar que dio 1

# Los workers vivos de todos los proyectos, una línea por worker (para el 75 del tope).
describir_vivos() {
  local r p
  for r in "$STATE"/*.running; do
    [[ -f "$r" ]] && vivo "$r" || continue
    if [[ "$(leer_campo "$r" leer)" == 1 ]]; then p="lectura"
    else p="$(leer_campo "$r" puesto)"; [[ "$p" == aca ]] && p="tree principal" || p="puesto ${p:-1}"; fi
    printf '    %s (%s): id %s · jefe %s · %.80s\n' "$(leer_campo "$r" proyecto)" "$p" \
      "$(leer_campo "$r" id)" "$(leer_campo "$r" jefe)" "$(leer_campo "$r" tarea)"
  done
}
# En primer plano, con el tope lleno: lo mismo que con los puestos ocupados (75).
tope_lleno_75() {
  if [[ "$motivo_tope" == RAM:* ]]; then
    echo "pa: sin RAM para otro worker ($ocupados_tope vivos entre todos los proyectos): $motivo_tope." >&2
  else
    echo "pa: tope global: ya hay $ocupados_tope worker(s) vivos entre todos los proyectos y el tope es $TOPE (PA_TOPE):" >&2
  fi
  describir_vivos >&2
  echo "pa: esperá uno con: pa --esperar <proyecto> --id <id>   o lanzalo con --async (hace cola y arranca solo)." >&2
  exit 75
}
# El motivo de la cola (`$ts.cola`, lo lee --estado). Cambia de clase (tope / RAM / puestos) o, con la
# RAM, de números cada medio segundo: se reescribe sólo al cambiar de clase o cada 5 s, y atómico.
cola_clase="" cola_seg=0
escribir_cola() {   # $1 = motivo
  local clase="${1%%:*}"
  [[ "$clase" != "$cola_clase" ]] || (( SECONDS - cola_seg >= 5 )) || return 0
  printf '%s' "$1" >"$dir/$ts.cola.tmp" && mv -f "$dir/$ts.cola.tmp" "$dir/$ts.cola"
  cola_clase="$clase"; cola_seg="$SECONDS"
}
# Un --leer no toma puesto, pero sí lugar: en primer plano sale 75; con --async hace cola.
esperar_lugar() {
  while ! tomar_lugar; do
    [[ -n "${PA_ASYNC:-}" ]] || tope_lleno_75
    escribir_cola "$motivo_tope"
    sleep "0.$(( 5 + RANDOM % 5 ))"
  done
  soltar_tope
  rm -f "$dir/$ts.cola"
}

# Toma el flock de un puesto (fd 9) y deja `puesto`, `lock`, `run`, `hb` y `tengo_lock` listos.
# Corrida nueva: el primer puesto libre de 1..N. --seguir: el de su corrida. --aca / --sucio-mio:
# el tree principal (`@aca`: uno a la vez ahí, en paralelo con los worktrees). Proyecto sin git o
# sin commits: un solo puesto, el 1 (todo corre en el tree principal). En primer plano, sin puesto
# libre sale 75; con --async hace cola (reintenta cada ~1 s con jitter). `$ts.puesto` se escribe
# APENAS se toma el flock, antes de cualquier git: es la señal de "tomó puesto" para el padre de
# --async, `--estado` (EN COLA) y `--esperar --id`.
# Antes del puesto va el lugar global (tomar_lugar): con el tope lleno pasa lo mismo que sin
# puesto libre (75, o cola con --async), y sin puesto libre el lugar se devuelve en el acto.
tomar_puesto() {
  local pedido="" k cands=() motivo
  if ! git -C "$ruta" rev-parse -q --verify HEAD >/dev/null 2>&1; then pedido=1
  elif (( aca )); then pedido=aca
  elif [[ -n "$ts_retomada" ]]; then pedido="$(puesto_para_retomar "$ts_retomada")"
  fi
  if [[ -n "$pedido" ]]; then cands=("$pedido"); else for (( k = 1; k <= PUESTOS; k++ )); do cands+=("$k"); done; fi
  while true; do
    if tomar_lugar; then
      for k in "${cands[@]}"; do
        exec 9>"$(lock_de_puesto "$k")"
        if flock -n 9; then puesto="$k"; soltar_tope; break 2; fi
        exec 9>&-
      done
      soltar_lugar; soltar_tope
      if [[ -n "$pedido" ]]; then motivo="esperando $([[ "$pedido" == aca ]] && echo 'el tree principal' || echo "el puesto $pedido")"
      else motivo="los ${#cands[@]} puestos ocupados"; fi
    else
      [[ -n "${PA_ASYNC:-}" ]] || tope_lleno_75
      motivo="$motivo_tope"
    fi
    if [[ -z "${PA_ASYNC:-}" ]]; then
      if [[ "$pedido" == aca ]]; then
        echo "pa: ya hay un worker corriendo en el tree principal de '$slug' (--aca o sin worktree):" >&2
      elif [[ -n "$pedido" ]]; then
        echo "pa: ya hay un worker corriendo en el puesto $pedido de '$slug', que es donde vive la rama de la corrida $ts_retomada:" >&2
      else
        echo "pa: ya hay un worker corriendo en cada uno de los ${#cands[@]} puesto(s) de '$slug':" >&2
      fi
      describir_puestos "${cands[@]}" >&2
      echo "pa: esperá uno con: pa --esperar '$proyecto' --id <id>   o lanzalo con --async (hace cola y arranca solo)." >&2
      exit 75
    fi
    # el motivo puede cambiar mientras espera (tope lleno -> sin RAM -> puestos ocupados)
    escribir_cola "$motivo"
    sleep "0.$(( 5 + RANDOM % 5 ))"
  done
  printf '%s' "$puesto" >"$dir/$ts.puesto"
  rm -f "$dir/$ts.cola"
  lock="$(lock_de_puesto "$puesto")"
  run="$STATE/$slug$(suf_puesto "$puesto").running"
  hb="$STATE/$slug$(suf_puesto "$puesto").heartbeat"
  tengo_lock=1
  # El .running de un worker anterior de ESTE puesto que murió sin limpiar: tenemos su lock, así
  # que no hay nadie vivo ahí. Se limpia acá en vez de pedirle al dueño que borre a mano.
  [[ -f "$run" ]] && rm -f "$run" "$hb"
  return 0
}

# `<slug>.session` guarda el sid de la última corrida buena; `<slug>.session.ts` el ts de esa
# misma corrida, para que `--seguir` (sin --id) encuentre su `.corrida` y vuelva a su worktree.
guardar_sesion() {   # $1 = sid
  # Un --leer no toca el casillero: es del worker que escribe (`--seguir` sin --id lo retoma).
  if (( leer )); then return 0; fi
  printf '%s' "$1" >"$sfile"
  printf '%s' "$ts" >"$sfile.ts"
}

# Las corridas con rama propia que todavía tienen trabajo FUERA del tree principal. Una línea por
# rama (los --seguir llevan `origen=` y se saltean): "<ts>\t<rama>\t<N pendientes>\t<subject>".
# Una rama con 0 pendientes no es trabajo sin integrar, tenga o no commits propios: no sale.
ramas_sin_integrar() {   # $1 = dir de estado del proyecto ($dir)
  local c t r repo n
  shopt -s nullglob
  for c in "$1"/*.corrida; do
    [[ -n "$(leer_campo "$c" origen)" ]] && continue
    r="$(leer_campo "$c" rama)"; repo="$(leer_campo "$c" ruta_trabajo)"
    [[ -n "$r" && -d "$repo" ]] || continue
    git -C "$repo" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1 || continue
    n="$(commits_pendientes "$repo" "$r")"
    [[ "$n" =~ ^[0-9]+$ ]] && (( n > 0 )) || continue
    t="$(basename "${c%.corrida}")"
    printf '%s\t%s\t%s\t%s\n' "$t" "$r" "$n" "$(git -C "$repo" log -1 --format=%s "$r" 2>/dev/null)"
  done
}

# Las ramas que ya están enteras en el tree principal (tienen commits propios y 0 pendientes:
# alguien las mergeó a mano, o un --integrar no pudo borrarlas) se borran acá. Con `branch -d`,
# que se niega solo si algo no está mergeado, y nunca con -D. Con el candado de git (-n: si está
# ocupado no poda) y nunca una rama checkouteada en un puesto ocupado: la rama de un worker que
# está corriendo no se toca. Las "sin commits" NO se podan: su `.corrida` es lo que hace que un
# `--seguir --id` vuelva a su rama.
podar_integradas() {
  local c r b repo n wr
  tomar_git -n || return 0
  shopt -s nullglob
  for c in "$dir"/*.corrida; do
    [[ -n "$(leer_campo "$c" origen)" ]] && continue
    r="$(leer_campo "$c" rama)"; b="$(leer_campo "$c" base)"; repo="$(leer_campo "$c" ruta_trabajo)"
    [[ -n "$r" && -n "$b" && -d "$repo" ]] || continue
    git -C "$repo" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1 || continue
    n="$(git -C "$repo" rev-list --count "$b..$r" 2>/dev/null || echo 0)"
    (( n > 0 )) || continue
    [[ "$(commits_pendientes "$repo" "$r")" == 0 ]] || continue
    wr="$(wt_de_rama "$r")"
    if [[ -n "$wr" ]]; then
      # checkouteada fuera de los puestos de pa (el tree del dueño, un worktree ajeno): no se toca
      [[ "$(puesto_de_ruta "$wr")" == aca ]] && continue
      puesto_libre "$(puesto_de_ruta "$wr")" || continue
      git -C "$wr" checkout -q --detach 2>/dev/null
    fi
    if git -C "$ruta" branch -q -d "$r" >/dev/null 2>&1; then
      rm -f "$c"
      echo "pa: borré $r: ya estaba entera en el tree principal."
    else
      echo "pa: $r parece integrada pero \`git branch -d\` se negó a borrarla. No la fuerzo: mirala a mano." >&2
    fi
  done
  soltar_git
}

cmd_ramas() {
  local hubo=0 t r n subj
  podar_integradas
  while IFS=$'\t' read -r t r n subj; do
    hubo=1
    printf '%s  %s commit(s) sin integrar  %s  (integrar: pa %q --integrar %s)\n' "$t" "$n" "$subj" "$proyecto" "$t"
  done < <(ramas_sin_integrar "$dir")
  (( hubo )) || echo "pa: '$slug' no tiene ramas sin integrar."
  # Las "sin commits" ya no salen arriba ni se podan (su .corrida devuelve un --seguir al
  # worktree), así que sin esta línea se acumulan sin que nadie las vea.
  local c b repo vacias=""
  shopt -s nullglob
  for c in "$dir"/*.corrida; do
    [[ -n "$(leer_campo "$c" origen)" ]] && continue
    r="$(leer_campo "$c" rama)"; b="$(leer_campo "$c" base)"; repo="$(leer_campo "$c" ruta_trabajo)"
    [[ -n "$r" && -n "$b" && -d "$repo" ]] || continue
    git -C "$repo" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1 || continue
    [[ "$(git -C "$repo" rev-list --count "$b..$r" 2>/dev/null)" == 0 ]] && vacias+=" $(basename "${c%.corrida}")"
  done
  [[ -n "$vacias" ]] && echo "pa: además hay rama(s) sin commits (no cambiaron nada); se tiran con pa '$proyecto' --descartar <id>:$vacias"
  return 0
}

# Candado de --integrar: si la rama agrega o modifica un symlink trackeado cuyo destino es
# absoluto, sale del repo, o su path ya existe en el tree principal como directorio
# gitignoreado, aborta ANTES de tocar nada. Es la ruta exacta que rompió un proyecto Rust el 2026-09-17
# (f662d98/8581de0/2725726/2db70e1): un symlink de cache de pa (destino absoluto, al node_modules
# real del tree principal) se coló en un commit huérfano, y el ff-only lo puso donde vivía el
# directorio real — git pisa lo ignorado — dejando un symlink que termina apuntándose a sí mismo.
symlinks_peligrosos() {   # $1 = tree principal, $2 = commit base, $3 = rama
  local ruta="$1" b="$2" r="$3" meta p modo_new hash_new status destino abs
  while IFS=$'\t' read -r meta p; do
    [[ -n "$p" ]] || continue
    read -r _ modo_new _ hash_new status <<<"$meta"
    [[ "$modo_new" == "120000" ]] || continue
    [[ "$status" == A || "$status" == M ]] || continue
    destino="$(git -C "$ruta" cat-file -p "$hash_new" 2>/dev/null)"
    if [[ "$destino" == /* ]]; then
      printf '%s\tdestino absoluto (%s)\n' "$p" "$destino"; continue
    fi
    abs="$(realpath -m -- "$ruta/$(dirname -- "$p")/$destino" 2>/dev/null)"
    if [[ -z "$abs" || "$abs" != "$ruta"/* ]]; then
      printf '%s\tsale del repo (%s)\n' "$p" "$destino"; continue
    fi
    if [[ -d "$ruta/$p" ]] && git -C "$ruta" check-ignore -q -- "$p" 2>/dev/null; then
      printf '%s\tpisaría un directorio gitignoreado del tree principal\n' "$p"
    fi
  done < <(git -C "$ruta" diff --raw "$b" "$r" 2>/dev/null)
  return 0
}

# --- integradas.tsv: el registro de lo que entró a main (y de lo que se revirtió o tiró) ------
# Una fila por evento, nunca se reescribe: la última fila de un id manda. Es lo que deja revertir
# (`pa --revertir <id>`: necesita head_antes..head_despues), lo que le dice a un `--integrar` que
# alguien (la app) ya la integró, y la señal de `pa --bien-auto`. Se escribe ANTES del
# `git branch -d`: si pa muere ahí, la rama queda pero el registro no se pierde.
# `auto` = PA_AUTO (0 por default): lo pone en 1 quien integre solo (Fase C), no un humano.
INTEGRADAS="$STATE/integradas.tsv"
INTEGRADAS_HEADER=$'fecha\tid\tproyecto\trama\trama_ppal\thead_antes\thead_despues\tcommits\tauto\taccion'
# `eventos.jsonl`: una línea JSON por cosa que le pasa a una corrida (inicio, fin, integrar,
# revertir, descartar, archivar, parar), para que la app se entere sin sondear el disco. Append
# bajo flock (líneas enteras aunque escriban dos pa a la vez). Nunca rompe a pa.
EVENTOS="$STATE/eventos.jsonl"
evento() {   # tipo id proyecto [rc]
  {
    local l
    l="$(jq -cn --arg t "$1" --arg i "$2" --arg p "$3" --arg rc "${4:-}" \
      '{version: 1, ts: (now | floor), tipo: $t, id: $i, proyecto: $p}
       + (if $rc == "" then {} else {rc: ($rc | tonumber? // $rc)} end)')" \
      && ( flock 4; printf '%s\n' "$l" >&4 ) 4>>"$EVENTOS"
  } 2>/dev/null || true
}
anotar_integrada() {   # id proyecto rama rama_ppal head_antes head_despues commits accion
  case "$8" in
    integrada) evento integrar "$1" "$2" ;;
    revertida) evento revertir "$1" "$2" ;;
  esac
  local auto="${PA_AUTO:-0}"; [[ "$auto" == 1 ]] || auto=0
  mkdir -p "$STATE"
  (
    flock 6
    [[ -s "$INTEGRADAS" ]] || printf '%s\n' "$INTEGRADAS_HEADER" >>"$INTEGRADAS"
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date -Iseconds)" "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$auto" "$8" >>"$INTEGRADAS"
  ) 6>>"$INTEGRADAS" || echo "pa: OJO: no pude anotar $1 en $INTEGRADAS." >&2
  return 0
}
fila_integrada() {   # $1 = id -> su última fila de integradas.tsv, o nada
  [[ -f "$INTEGRADAS" ]] || return 0
  awk -F'\t' -v i="$1" 'NR > 1 && $2 == i {f = $0} END {if (f != "") print f}' "$INTEGRADAS"
}
# Un --integrar que no encuentra la corrida o la rama: ¿ya está en integradas.tsv? 0 = integrada
# (lo dice y no es error: la pudo integrar la app); 1 = no (si se revirtió o descartó, lo aclara).
ya_resuelta() {   # $1 = id
  local f acc
  f="$(fila_integrada "$1")"; [[ -n "$f" ]] || return 1
  acc="$(cut -f10 <<<"$f")"
  case "$acc" in
    integrada)  echo "pa: $1 ya integrada (¿desde la app?): $(cut -f4 <<<"$f") entró a $(cut -f5 <<<"$f") el $(cut -f1 <<<"$f")."; return 0 ;;
    revertida)  echo "pa: $1 se integró y después se revirtió (pa --revertir); no hay rama que integrar." >&2 ;;
    descartada) echo "pa: $1 se descartó; no hay rama que integrar." >&2 ;;
  esac
  return 1
}

# Integrar = rebase de la rama del worker sobre el HEAD del tree principal, adentro de un puesto
# (que es de pa), y ff-only en el tree principal. Nunca fuerza nada: si el tree principal tiene
# sin commitear un archivo que la rama toca, sale 79 y no toca nada; si el rebase choca, lo aborta
# y sale 80 (y propone `--actualizar`); si la rama trae un symlink peligroso, sale 83; si la
# corrida dejó trabajo sin commitear en su worktree, 86. El merge automático del jefe es a
# propósito el ÚNICO momento en que el trabajo del worker entra a main.
#
# Con puestos: candado de git (-w 60) + un puesto LIBRE donde rebasear. Si la rama está
# checkouteada en un puesto, es ése (ocupado = hay un --seguir/--actualizar corriendo sobre ella:
# 75). Si no, el de su corrida si está libre, o cualquier otro libre; ninguno libre, 75. Un --aca
# vivo también da 75: el ff-only reescribiría archivos debajo de un worker que edita el tree principal.
# La base es el merge-base con el HEAD, no el `base=` grabado: después de un --actualizar (rama
# rebaseada) el viejo contaría los commits de main como si fueran de la rama (79 y 83 falsos).
cmd_integrar() {   # $1 = ts de la corrida
  local t="$1" c="$dir/$1.corrida" r b wt wr p head_ppal rama_ppal n tocados sucios choque peligrosos prestado=0 k
  if [[ ! -f "$c" ]]; then
    ya_resuelta "$t" && return 0
    echo "pa: no hay corrida '$t' de '$slug' (falta $c)." >&2; return 1
  fi
  r="$(leer_campo "$c" rama)"
  [[ -n "$r" ]] || { echo "pa: la corrida '$t' corrió en el tree principal, no hay rama que integrar." >&2; return 1; }
  if ! git -C "$ruta" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1; then
    rm -f "$c"
    ya_resuelta "$t" && return 0
    echo "pa: la rama $r ya no existe (¿ya integrada o descartada?)." >&2; return 1
  fi
  # --tests (opt-in): sin el flag el campo ni se lee
  local cmd_tests=""
  if (( ${integrar_tests:-0} )); then
    cmd_tests="$(tests_registry "$slug")"
    [[ -n "$cmd_tests" ]] || { echo "pa: '$slug' no tiene \`tests\` en el registry: --integrar --tests no tiene qué correr. Agregalo, o integrá sin --tests." >&2; return 2; }
  fi
  tomar_git -w 60 || { echo "pa: el candado de git de '$slug' sigue ocupado después de 60s (otro --integrar/--descartar o un worker arrancando). Reintentá." >&2; return 75; }
  # El tree principal se toma (fd 7) mientras dure: ningún --aca arranca a mitad del ff-only.
  exec 7>"$(lock_de_puesto aca)"
  flock -n 7 || { exec 7>&-; soltar_git; echo "pa: hay un worker --aca corriendo en el tree principal de '$slug'; integrar le movería los archivos abajo. Esperalo y volvé a correr --integrar." >&2; return 75; }
  # --- el puesto donde rebasear
  wr="$(wt_de_rama "$r")"
  if [[ -n "$wr" ]]; then
    p="$(puesto_de_ruta "$wr")"
    if [[ "$p" == aca ]]; then
      exec 7>&-; soltar_git; echo "pa: la rama $r está checkouteada en $wr, fuera de los puestos de pa. No la toco: sacala de ahí (git -C '$wr' checkout --detach) y volvé a correr --integrar." >&2; return 1
    fi
    exec 9>"$(lock_de_puesto "$p")"
    flock -n 9 || { exec 9>&- 7>&-; soltar_git; echo "pa: la rama $r la está usando un worker en el puesto $p (¿un --seguir o --actualizar?). Esperalo y volvé a correr --integrar." >&2; return 75; }
  else
    p=""
    for k in $(puesto_de_corrida "$c") $(seq 1 "$PUESTOS"); do
      [[ "$k" == aca ]] && continue
      exec 9>"$(lock_de_puesto "$k")"
      flock -n 9 && { p="$k"; break; }
      exec 9>&-
    done
    [[ -n "$p" ]] || { exec 7>&-; soltar_git; echo "pa: los $PUESTOS puestos de '$slug' están ocupados y --integrar necesita uno libre para rebasear. Esperá uno y volvé a correr." >&2; return 75; }
    prestado=1
  fi
  wt="$(wt_de_puesto "$p")"
  if ! asegurar_worktree "$wt"; then exec 9>&- 7>&-; soltar_git; return 1; fi
  # suelta el puesto y el candado de git; deja los symlinks de cache puestos
  fin_integrar() { enlazar_caches "$ruta" "$wt"; exec 9>&- 7>&-; soltar_git; }

  head_ppal="$(git -C "$ruta" rev-parse HEAD)"
  rama_ppal="$(git -C "$ruta" rev-parse --abbrev-ref HEAD)"
  b="$(git -C "$ruta" merge-base "$head_ppal" "$r" 2>/dev/null)" \
    || { fin_integrar; echo "pa: la rama $r no comparte historia con $rama_ppal. No la integro." >&2; return 1; }
  n="$(git -C "$ruta" rev-list --count "$b..$r" 2>/dev/null || echo 0)"
  if (( n == 0 )); then
    local bc; bc="$(leer_campo "$c" base)"
    if [[ -n "$bc" && "$(git -C "$ruta" rev-list --count "$bc..$r" 2>/dev/null || echo 0)" != 0 ]]; then
      # tiene commits propios y están todos en main: alguien la integró a mano
      [[ -n "$wr" ]] && git -C "$wr" checkout -q --detach 2>/dev/null
      fin_integrar
      anotar_integrada "$t" "$slug" "$r" "$rama_ppal" "$head_ppal" "$head_ppal" 0 integrada
      sigue_al_tablero "$t" "$head_ppal"
      git -C "$ruta" branch -q -d "$r" >/dev/null 2>&1 && rm -f "$c"
      echo "pa: $r ya estaba entera en $rama_ppal de '$slug'; no había nada que integrar."
      empujar_main "$ruta"
      return 0
    fi
    fin_integrar
    echo "pa: la rama $r no tiene commits; no hay nada que integrar. Tirala con: pa '$proyecto' --descartar $t" >&2
    return 1
  fi
  # 0. lo que la corrida dejó sin commitear en su worktree (murió, o cortó sin commitear). Se mide
  # sin los symlinks de cache (sucios_de ya filtra los que apuntan fuera del worktree, sean de
  # la lista fija o enlazados a mano). Antes terminaba en un 80 engañoso ("conflictos") en el checkout.
  desenlazar_caches "$wt"
  local estado_wt; estado_wt="$(sucios_de "$wt")"
  if [[ -n "$wr" && -n "$estado_wt" ]]; then
    local sucio_wt; sucio_wt="$(printf '%s\n' "$estado_wt" | sed -n 1,5p | while IFS= read -r l; do ruta_porcelain "$l"; printf ' '; done)"
    fin_integrar
    echo "pa: NO integro: la corrida $t dejó trabajo SIN COMMITEAR en su worktree ($wt): $sucio_wt" >&2
    echo "    Cerrala con: pa '$proyecto' --seguir --id $t 'commiteá lo que hiciste y reportá'  (o tirala: --descartar $t)." >&2
    return 86
  fi
  # 1. lo sin commitear del tree principal no puede cruzarse con lo que trae la rama
  tocados="$(git -C "$ruta" diff --name-only "$b" "$r" 2>/dev/null)"
  sucios="$(sucios_de "$ruta" | while IFS= read -r l; do [[ -n "$l" ]] && { ruta_porcelain "$l"; echo; }; done)"
  choque="$(grep -xF -f <(printf '%s\n' "$tocados") <(printf '%s\n' "$sucios") 2>/dev/null || true)"
  if [[ -n "$choque" ]]; then
    fin_integrar
    echo "pa: NO integro: el tree principal de '$slug' tiene sin commitear archivos que la rama $r toca:" >&2
    printf '%s\n' "$choque" | sed 's/^/    /' >&2
    echo "    Commitealos, movelos o tiralos, y volvé a correr --integrar. No fuerzo nada." >&2
    return 79
  fi
  # 1b. la rama no puede traer un symlink peligroso (ver symlinks_peligrosos arriba)
  peligrosos="$(symlinks_peligrosos "$ruta" "$b" "$r")"
  if [[ -n "$peligrosos" ]]; then
    fin_integrar
    echo "pa: NO integro: la rama $r trae symlink(s) peligrosos:" >&2
    printf '%s\n' "$peligrosos" | sed 's/\t/: /; s/^/    /' >&2
    echo "    Suelen ser cache de pa (node_modules/.venv/.env): sacalos de la rama y volvé a correr --integrar. No toqué nada." >&2
    return 83
  fi
  # 2. rebase adentro del puesto (es de pa; el tree principal no se toca). Un puesto prestado
  # puede tener restos de otra corrida: se commitean como huérfano antes del checkout.
  if [[ "$head_ppal" != "$b" ]]; then
    (( prestado )) && commitear_huerfano "$wt"
    if ! git -C "$wt" checkout -q "$r" 2>/dev/null; then
      fin_integrar
      echo "pa: no pude entrar a $r en $wt." >&2; return 1
    fi
    if ! GIT_EDITOR=true git -C "$wt" rebase -q "$head_ppal" >/dev/null 2>&1; then
      git -C "$wt" rebase --abort >/dev/null 2>&1 || true
      # prestado: que la rama no quede checkouteada en un puesto que no es el suyo
      (( prestado )) && git -C "$wt" checkout -q --detach 2>/dev/null
      fin_integrar
      echo "pa: el rebase de $r sobre $rama_ppal ($(printf %.7s "$head_ppal")) tiene conflictos: otro cambio que ya entró toca lo mismo." >&2
      echo "    Que lo resuelva un worker que entienda los dos cambios: pa '$proyecto' --actualizar $t   (y después --integrar $t de nuevo)." >&2
      return 80
    fi
  fi
  # 2b. --tests: el `tests` del registry en el puesto, sobre la rama ya rebaseada. Mientras corren
  # se sueltan el candado de git y el del tree principal (pueden tardar minutos: con el de git
  # tomado, ningún pa de este proyecto podría arrancar); el puesto (fd 9) queda tomado. Rojo:
  # 93 y main sin tocar (la rama queda rebaseada, como después de un --actualizar).
  if [[ -n "$cmd_tests" ]]; then
    if [[ "$(git -C "$wt" rev-parse --abbrev-ref HEAD 2>/dev/null)" != "$r" ]]; then
      (( prestado )) && commitear_huerfano "$wt"
      git -C "$wt" checkout -q "$r" 2>/dev/null || { fin_integrar; echo "pa: no pude entrar a $r en $wt." >&2; return 1; }
    fi
    local log_t="$dir/$t.tests.log" rc_t=0
    enlazar_caches "$ruta" "$wt"
    exec 7>&-; soltar_git
    ( cd "$wt" && timeout "${PA_TESTS_MAX:-1800}" bash -c "$cmd_tests" ) </dev/null >"$log_t" 2>&1 || rc_t=$?
    tomar_git -w 60 || { exec 9>&-; echo "pa: los tests terminaron (rc $rc_t) pero el candado de git de '$slug' sigue ocupado después de 60s. No integré nada; reintentá." >&2; return 75; }
    if (( rc_t != 0 )); then
      (( prestado )) && git -C "$wt" checkout -q --detach 2>/dev/null
      fin_integrar
      echo "pa: NO integro: los tests de '$slug' dieron rojo (rc $rc_t$( (( rc_t == 124 )) && printf ', se pasaron de %ss' "${PA_TESTS_MAX:-1800}")) sobre $r. $rama_ppal no se tocó. Log: $log_t" >&2
      tail -n 15 "$log_t" 2>/dev/null | sed 's/^/    /' >&2 || true
      echo "    Que lo arregle el worker: pa '$proyecto' --seguir --id $t 'los tests dan rojo: <qué>' (y después --integrar $t --tests)." >&2
      return 93
    fi
    exec 7>"$(lock_de_puesto aca)"
    flock -n 7 || { (( prestado )) && git -C "$wt" checkout -q --detach 2>/dev/null; fin_integrar; echo "pa: tests verdes, pero mientras corrían arrancó un worker --aca en el tree principal de '$slug'. No integré; volvé a correr cuando termine." >&2; return 75; }
    echo "pa: tests verdes ($cmd_tests)."
  fi
  # 3. ff-only en el tree principal, y la rama se va
  if ! git -C "$ruta" merge -q --ff-only "$r" >/dev/null 2>&1; then
    (( prestado )) && git -C "$wt" checkout -q --detach 2>/dev/null
    fin_integrar
    echo "pa: el merge ff-only de $r en $rama_ppal falló (¿HEAD se movió mientras tanto?). Nada se tocó." >&2
    return 1
  fi
  git -C "$wt" checkout -q --detach 2>/dev/null || true
  [[ -n "$wr" && "$wr" != "$wt" ]] && git -C "$wr" checkout -q --detach 2>/dev/null
  limpiar_build "$wt" 2>/dev/null || true   # tenemos su puesto (fd 9)
  fin_integrar
  local head_nuevo; head_nuevo="$(git -C "$ruta" rev-parse HEAD)"
  anotar_integrada "$t" "$slug" "$r" "$rama_ppal" "$head_ppal" "$head_nuevo" "$n" integrada
  sigue_al_tablero "$t" "$head_nuevo"
  echo "pa: integrada $r en $rama_ppal de '$slug' ($n commit(s))."
  # -d y nunca -D: si se niega es que algo no quedó en el tree principal, y eso se avisa, no se
  # fuerza. Antes era `|| true` mudo, y la rama quedaba viva contando como "sin integrar".
  if git -C "$ruta" branch -q -d "$r" >/dev/null 2>&1; then
    rm -f "$c"
  else
    echo "pa: OJO: \`git branch -d $r\` se negó a borrarla (¿quedó algo sin mergear?). No la forcé: git -C '$ruta' log $rama_ppal..$r" >&2
  fi
  solapamiento "$t" "$(git -C "$ruta" diff --name-only "$b" "$head_ppal" 2>/dev/null; printf '%s\n' "$tocados")" "entró a main"
  # al final y sin candados tomados: si el remoto tarda, ningún otro pa de este proyecto espera
  empujar_main "$ruta"
  return 0
}

# Otras ramas sin integrar del mismo proyecto que tocan los mismos archivos. Con puestos es lo
# que avisa ANTES de que choque: "ojo: X también toca Y". No frena nada: decide la primera que se
# integra; la segunda rebasea sola si no hay choque real, y si lo hay, --actualizar.
solapamiento() {   # $1 = ts propio (se saltea), $2 = archivos (uno por línea), $3 = verbo ("toca", "entró a main")
  local propio="$1" mios="$2" verbo="${3:-toca}" t r n subj b suyos comun
  # ojo con `set -e` + pipefail: un grep sin match adentro de un $(...) mataba a pa DESPUÉS de integrar
  [[ -n "$mios" ]] || return 0
  while IFS=$'\t' read -r t r n subj; do
    [[ "$t" == "$propio" ]] && continue
    b="$(git -C "$ruta" merge-base HEAD "$r" 2>/dev/null)" || continue
    suyos="$(git -C "$ruta" diff --name-only "$b" "$r" 2>/dev/null)"
    comun="$( { grep -xF -f <(printf '%s\n' "$mios" | grep .) <(printf '%s\n' "$suyos") 2>/dev/null || true; } | sed -n 1,5p | paste -sd' ')"
    [[ -n "$comun" ]] || continue
    if [[ "$verbo" == "entró a main" ]]; then
      echo "— ojo: la corrida $t (sin integrar) toca lo mismo que acaba de entrar ($comun): al integrarla puede chocar; si da 80, pa '$proyecto' --actualizar $t."
    else
      echo "— ojo: la corrida $t (sin integrar) también toca $comun: la que se integre segunda puede chocar."
    fi
  done < <(ramas_sin_integrar "$dir")
  return 0
}

cmd_descartar() {   # $1 = ts
  local t="$1" c="$dir/$1.corrida" r wr p
  [[ -f "$c" ]] || { echo "pa: no hay corrida '$t' de '$slug'." >&2; return 1; }
  r="$(leer_campo "$c" rama)"
  [[ -n "$r" ]] || { echo "pa: la corrida '$t' no tiene rama." >&2; return 1; }
  tomar_git -w 60 || { echo "pa: el candado de git de '$slug' sigue ocupado después de 60s. Reintentá." >&2; return 75; }
  wr="$(wt_de_rama "$r")"
  if [[ -n "$wr" ]]; then
    p="$(puesto_de_ruta "$wr")"
    if [[ "$p" == aca ]]; then
      soltar_git; echo "pa: la rama $r está checkouteada en $wr, fuera de los puestos de pa. No la toco." >&2; return 1
    fi
    # el puesto se TOMA (no sólo se sondea) mientras se limpia su build
    exec 9>"$(lock_de_puesto "$p")"
    flock -n 9 || { exec 9>&-; soltar_git; echo "pa: la rama $r la está usando un worker en el puesto $p. Matalo o esperalo primero." >&2; return 75; }
    git -C "$wr" checkout -q --detach 2>/dev/null
    limpiar_build "$wr" 2>/dev/null || true
    exec 9>&-
  fi
  # la punta de la rama queda en integradas.tsv (head_despues): con eso se recupera si hizo falta
  local punta pend
  punta="$(git -C "$ruta" rev-parse -q --verify "refs/heads/$r" 2>/dev/null || true)"
  pend="$(commits_pendientes "$ruta" "$r")"
  git -C "$ruta" branch -q -D "$r" >/dev/null 2>&1 || true
  soltar_git
  rm -f "$c"
  [[ -n "$punta" ]] && anotar_integrada "$t" "$slug" "$r" "$(git -C "$ruta" rev-parse --abbrev-ref HEAD 2>/dev/null)" \
    "$(git -C "$ruta" rev-parse HEAD 2>/dev/null)" "$punta" "${pend:-0}" descartada
  evento descartar "$t" "$slug"
  echo "pa: descartada $r de '$slug'."
  return 0
}

# --- comandos por id (sin nombrar el proyecto) ---------------------------------------------
# El id (ts de la corrida) es único entre proyectos: la app y el jefe dicen `pa --revertir <id>`
# sin acordarse de qué proyecto era. El proyecto sale del directorio de estado donde está la
# corrida, o de integradas.tsv si ya no queda ningún archivo suyo.
proyecto_de_id() {   # $1 = id -> slug, o nada
  local f s=""
  [[ "$1" =~ ^[0-9A-Za-z._-]+$ ]] || return 0
  for f in "$STATE"/*/"$1".corrida "$STATE"/*/"$1".hilo "$STATE"/*/"$1".json "$STATE"/*/"$1".pid; do
    [[ -e "$f" ]] || continue
    s="$(basename -- "$(dirname -- "$f")")"; [[ "$s" == worktrees || "$s" == lock ]] && { s=""; continue; }
    break
  done
  [[ -n "$s" ]] || s="$(fila_integrada "$1" | cut -f3)"
  printf '%s' "$s"
}
# Las variables de un proyecto ya resuelto ($ruta): las mismas de `pa <proyecto> …`.
fijar_proyecto() {
  slug="$(slug_de "$ruta")"
  dir="$STATE/$slug"
  sfile="$STATE/$slug.session"
  run="$STATE/$slug.running"
  hb="$STATE/$slug.heartbeat"
  ult="$STATE/$slug.ultimo"
  lock="$LOCKDIR/$slug"
  mkdir -p "$dir"
}
usar_id() {   # $1 = id: deja proyecto/ruta/slug/dir/… como si hubieran dicho `pa <proyecto>`, o sale 1
  local s; s="$(proyecto_de_id "$1")"
  [[ -n "$s" ]] || { echo "pa: no encuentro la corrida '$1' en $STATE." >&2; exit 1; }
  proyecto="$(nombre_registry "$s")"
  ruta="$(proyecto-ruta "$proyecto" 2>/dev/null)" \
    || { echo "pa: la corrida '$1' es de '$s', y no encuentro ese proyecto en el registry." >&2; exit 1; }
  fijar_proyecto
}

# `pa --revertir <id>`: deshace una integración en el tree principal con `git revert` de
# head_antes..head_despues (commits nuevos arriba; nunca reescribe historia ni fuerza nada).
# Mismo candado que --integrar (git + el del tree principal). Se niega si lo sucio del tree
# principal se cruza con lo que hay que revertir (89), si el revert choca con algo que entró
# después (90: lo aborta y deja todo como estaba) o si la integración no trajo commits (91).
cmd_revertir() {
  local t="${1:-}" f r rama_ppal antes despues n acc tocados sucios choque cabeza err
  [[ -n "$t" ]] || { echo "uso: pa --revertir <id-de-corrida>" >&2; return 2; }
  usar_id "$t"
  f="$(fila_integrada "$t")"
  [[ -n "$f" ]] || { echo "pa: '$t' no está en $INTEGRADAS: nunca se integró (o fue antes de que existiera el registro)." >&2; return 1; }
  IFS=$'\t' read -r _ _ _ r rama_ppal antes despues n _ acc <<<"$f"
  case "$acc" in
    revertida)  echo "pa: $t ya se revirtió." >&2; return 1 ;;
    descartada) echo "pa: $t se descartó: nunca entró a main." >&2; return 1 ;;
  esac
  if [[ "$n" == 0 || "$antes" == "$despues" ]]; then
    echo "pa: la integración de $t no trajo commits ($r ya estaba entera en $rama_ppal: la mergeó alguien a mano). No hay rango que revertir; buscá esos commits con git log." >&2
    return 91
  fi
  tomar_git -w 60 || { echo "pa: el candado de git de '$slug' sigue ocupado después de 60s. Reintentá." >&2; return 75; }
  exec 7>"$(lock_de_puesto aca)"
  flock -n 7 || { exec 7>&-; soltar_git; echo "pa: hay un worker --aca corriendo en el tree principal de '$slug'; revertir le movería los archivos abajo. Esperalo." >&2; return 75; }
  if ! git -C "$ruta" merge-base --is-ancestor "$despues" HEAD 2>/dev/null; then
    exec 7>&-; soltar_git
    echo "pa: el HEAD del tree principal de '$slug' no contiene la integración de $t ($(printf %.7s "$despues")): ¿otra rama checkouteada? No toqué nada." >&2
    return 1
  fi
  tocados="$(git -C "$ruta" diff --name-only "$antes" "$despues" 2>/dev/null)"
  sucios="$(sucios_de "$ruta" | while IFS= read -r l; do [[ -n "$l" ]] && { ruta_porcelain "$l"; echo; }; done)"
  choque="$(grep -xF -f <(printf '%s\n' "$tocados") <(printf '%s\n' "$sucios") 2>/dev/null || true)"
  if [[ -n "$choque" ]]; then
    exec 7>&-; soltar_git
    echo "pa: NO revierto: el tree principal de '$slug' tiene sin commitear archivos que el revert de $t toca:" >&2
    printf '%s\n' "$choque" | sed 's/^/    /' >&2
    echo "    Commitealos, movelos o tiralos, y volvé a correr --revertir. No fuerzo nada." >&2
    return 89
  fi
  cabeza="$(git -C "$ruta" rev-parse HEAD)"
  if ! err="$(git -C "$ruta" revert --no-edit "$antes..$despues" 2>&1 >/dev/null)"; then
    local a_medias=0
    local gd; gd="$(git -C "$ruta" rev-parse --absolute-git-dir 2>/dev/null)"
    [[ -n "$gd" && ( -e "$gd/REVERT_HEAD" || -d "$gd/sequencer" ) ]] && a_medias=1
    (( a_medias )) && { git -C "$ruta" revert --abort >/dev/null 2>&1 || true; }
    exec 7>&-; soltar_git
    if (( a_medias )); then
      echo "pa: el revert de $t choca con algo que entró después a $rama_ppal (toca lo mismo). Lo aborté: $rama_ppal quedó como estaba." >&2
      echo "    Que lo deshaga un worker que entienda los dos cambios: pa '$proyecto' 'revertí a mano lo que metió $r'." >&2
      return 90
    fi
    echo "pa: git revert falló sin empezar (no toqué nada): $(printf '%.300s' "$err")" >&2
    return 1
  fi
  exec 7>&-; soltar_git
  local nuevo; nuevo="$(git -C "$ruta" rev-parse HEAD)"
  anotar_integrada "$t" "$slug" "$r" "$(git -C "$ruta" rev-parse --abbrev-ref HEAD)" "$cabeza" "$nuevo" \
    "$(git -C "$ruta" rev-list --count "$cabeza..$nuevo" 2>/dev/null || echo 0)" revertida
  echo "pa: revertida $t en $rama_ppal de '$slug' ($n commit(s) deshechos con revert; la historia queda)."
  return 0
}

# El `.running` vivo de una corrida (writer en cualquier puesto o --leer), o nada.
running_de_id() {   # $1 = id (usa $slug)
  local r
  for r in "$STATE/$slug.running" "$STATE/$slug"@*.running "$STATE/$slug.leer-$1.running"; do
    [[ -f "$r" && "$(leer_campo "$r" id)" == "$1" ]] && vivo "$r" && { printf '%s' "$r"; return 0; }
  done
  return 0
}
# Viva = corriendo (su .running) o en cola (el pid de `$ts.pid` vive).
corrida_id_viva() {   # $1 = id (usa $slug, $dir)
  [[ -n "$(running_de_id "$1")" ]] && return 0
  [[ -f "$dir/$1.pid" ]] && vive "$(cat "$dir/$1.pid" 2>/dev/null)"
}
negar_si_viva() {   # $1 = id, $2 = verbo
  corrida_id_viva "$1" || return 0
  echo "pa: la corrida $1 de '$slug' sigue viva (corriendo o en cola); no la $2 debajo de un worker. Paralo primero: pa --parar $1" >&2
  return 92
}

# `pa --parar <id>`: baja ESA corrida, esté corriendo (matar_run, 85 si queda algo vivo) o en
# cola (el pa hijo de --async que espera puesto). Es `--matar --id` sin nombrar el proyecto.
cmd_parar() {
  local t="${1:-}" r p quedan rc=0
  [[ -n "$t" ]] || { echo "uso: pa --parar <id-de-corrida>" >&2; return 2; }
  usar_id "$t"
  shopt -s nullglob
  r="$(running_de_id "$t")"
  if [[ -n "$r" ]]; then
    matar_run "$r" || rc=$?
    (( rc == 0 )) && evento parar "$t" "$slug"
    return "$rc"
  fi
  p="$(cat "$dir/$t.pid" 2>/dev/null || true)"
  if [[ -n "$p" ]] && vive "$p"; then
    if quedan="$(matar_arbol "" "" "$p")"; then
      anotar_fin "$dir" "$t"
      evento parar "$t" "$slug"
      echo "pa: corrida $t de '$slug' bajada (estaba en cola)."
      return 0
    fi
    echo "pa: NO pude bajar la corrida $t de '$slug': siguen vivos $(echo $quedan)." >&2
    return 85
  fi
  echo "pa: la corrida $t de '$slug' no está corriendo ni en cola." >&2
  return 1
}

# `pa --descartar <id>` (sin proyecto): el `--descartar` de siempre, pero se niega (92) con el
# worker vivo: tirarle la rama abajo a un worker que sigue commiteando no deja nada coherente.
cmd_descartar_id() {
  local t="${1:-}"
  [[ -n "$t" ]] || { echo "uso: pa --descartar <id-de-corrida>   (o pa <proyecto> --descartar <id>)" >&2; return 2; }
  usar_id "$t"
  negar_si_viva "$t" descarto || return $?
  cmd_descartar "$t"
}

# Un campo del `.hilo` de una corrida (registro durable: la `.corrida` se borra al integrar o
# descartar, el `.hilo` nunca). Mismo inodo bajo flock.
hilo_poner() {   # $1 = id, $2 = campo, $3 = valor (se aplana a una línea); usa $dir
  local h="$dir/$1.hilo" v="${3//$'\n'/ }" tmp
  tmp="$h.tmp.$$"
  (
    flock 5
    { grep -v "^$2=" "$h" 2>/dev/null || true; printf '%s=%s\n' "$2" "$v"; } >"$tmp" && cat "$tmp" >"$h"
    rm -f "$tmp"
  ) 5>>"$h" || true
}

# La hora en que pa VIO terminar una corrida (`fin=<epoch>` en su `.hilo`): la escribe su propio pa
# al salir (al_salir) y, si a ése lo bajaron sin dejarlo llegar a su trap, el `--parar`/`--matar` que
# lo bajó. No pisa una ya escrita. Es la hora de muerte EXACTA de `pa --hilos` (`murio_en`); sin
# ella (kill -9, oomd, corte de luz) la app recibe una estimada.
anotar_fin() {   # $1 = dir de estado del proyecto, $2 = id
  local dir="$1"
  [[ -n "$2" ]] && [[ -f "$dir/$2.hilo" || -f "$dir/$2.pid" ]] || return 0
  campo_rapido "$dir/$2.hilo" fin
  [[ -n "$REPLY" ]] && return 0
  hilo_poner "$2" fin "$(date +%s)"
}

# `pa --archivar <id>`: la saca de la vista de la app (`archivado=<fecha>` en el `.hilo`). No toca
# `.listo`/`.entregado`: el `--esperar-todos` del jefe la cobra igual.
cmd_archivar() {
  local t="${1:-}"
  [[ -n "$t" ]] || { echo "uso: pa --archivar <id-de-corrida>" >&2; return 2; }
  usar_id "$t"
  negar_si_viva "$t" archivo || return $?
  hilo_poner "$t" archivado "$(date -Iseconds)"
  evento archivar "$t" "$slug"
  echo "pa: corrida $t de '$slug' archivada."
}

# --- contrato JSON para la app (`pa --hilos`, `pa --hilo <id>`) ------------------------------
# Lectura pura: no toma locks ni toca nada (pasa con modelo local). `version` sube si cambia algo
# incompatible. Un "hilo" es una corrida: su `.hilo` (o, en corridas de antes del `.hilo`, lo que
# quede de `.corrida`/`.json`), más su estado de ahora.
#
# Rápido a propósito: hay miles de corridas en disco y cientos por semana. Bash junta los hechos
# que sólo él ve (vivo, en cola, integradas.tsv, commits, el final del transcript) sin forks por
# corrida, y UN jq lee todos los `.hilo`/`.corrida`/`.json` de una (input_filename) y arma la
# salida. Con un jq + un sed por campo y por corrida, la semana del dueño (~600) tardaba 2,5 min.
HILO_ID_RE='^[0-9]{8}-[0-9]{6}-[0-9]+$'

# Sin forks (REPLY): campo de un archivo clave=valor, o su primera línea.
campo_rapido() {   # $1 = archivo, $2 = campo
  REPLY=""
  [[ -f "$1" ]] || return 0
  local l
  while IFS= read -r l || [[ -n "$l" ]]; do
    [[ "$l" == "$2="* ]] && { REPLY="${l#"$2="}"; return 0; }
  done <"$1"
  return 0
}
linea_rapida() {   # $1 = archivo -> REPLY; 1 si no hay nada
  REPLY=""
  [[ -f "$1" ]] || return 1
  IFS= read -r REPLY <"$1" || [[ -n "$REPLY" ]]
}

# El tree principal de un proyecto (por slug, cacheado en ruta_de) y sus ramas pa/<slug>/* en
# refs_de: una sola llamada a git por proyecto. Usa los arrays de cmd_hilos.
ruta_ppal() {   # $1 = slug -> REPLY
  if [[ -z "${ruta_de[$1]+x}" ]]; then
    local r ref
    r="$(proyecto-ruta "$(nombre_registry "$1")" 2>/dev/null || true)"
    ruta_de[$1]="$r"
    if [[ -n "$r" ]]; then
      while IFS= read -r ref; do [[ -n "$ref" ]] && refs_de[$1/$ref]=1; done \
        < <(git -C "$r" for-each-ref --format='%(refname:short)' "refs/heads/pa/$1/" 2>/dev/null)
    fi
  fi
  REPLY="${ruta_de[$1]}"
}

# Viva en cola: el pid de `$ts.pid` vive pero no hay `.running` (kill -0 primero: `vive` es un ps).
pid_en_cola() {   # $1 = dir, $2 = id
  linea_rapida "$1/$2.pid" && [[ "$REPLY" =~ ^[0-9]+$ ]] && kill -0 "$REPLY" 2>/dev/null && vive "$REPLY"
}

# La ventana default: lo vivo, lo no cobrado (.listo), lo que tiene una rama viva sin integrar ni
# descartar ni archivar, y los últimos 7 días. Usa corte/run_de/acc_de de cmd_hilos.
en_ventana() {   # $1 = slug, $2 = dir, $3 = id
  local s="$1" d="$2" id="$3" rama
  # un .listo viejo no cuenta: --esperar sólo cobra los de menos de un día, ese ya no lo cobra nadie
  [[ ! "$id" < "$corte" || -n "${run_de[$id]:-}" ]] && return 0
  pid_en_cola "$d" "$id" && return 0
  [[ -f "$d/$id.corrida" && -z "${acc_de[$id]:-}" ]] || return 1
  campo_rapido "$d/$id.corrida" rama; rama="$REPLY"; [[ -n "$rama" ]] || return 1
  campo_rapido "$d/$id.hilo" archivado; [[ -z "$REPLY" ]] || return 1
  ruta_ppal "$s"
  [[ -n "${refs_de[$s/$rama]:-}" ]]
}

# La primera línea `"type":"user"` de las 30 primeras de un transcript (sin pipes: corta sola).
primer_usuario() {   # $1 = transcript
  local l n=0
  while (( n++ < 30 )) && IFS= read -r l; do
    [[ "$l" == *'"type":"user"'* ]] && { printf '%s\n' "$l"; return 0; }
  done <"$1"
  return 0
}

# Los hechos de una corrida que el jq no puede ver, en una línea separada por \x1f; y el final
# de su transcript (200 líneas, para la caché) a $4/cache detrás de una marca \x1e<id>.
hechos_de() {   # $1 = slug, $2 = dir, $3 = id, $4 = dir temporal
  local s="$1" d="$2" id="$3" r vivo_e="" en_cola=0 ini_run="" tarea_run="" commits="" rama ppal sid="" t x="" trans=""
  r="${run_de[$id]:-}"
  if [[ -n "$r" ]]; then
    vivo_e=trabajando
    campo_rapido "${r%.running}.heartbeat" epoch
    [[ "$REPLY" =~ ^[0-9]+$ ]] && (( now - REPLY > 600 )) && vivo_e=colgado
    campo_rapido "$r" inicio; ini_run="$REPLY"
    campo_rapido "$r" tarea; tarea_run="${REPLY//$'\x1f'/ }"
  elif pid_en_cola "$d" "$id"; then
    vivo_e=trabajando; en_cola=1
  fi
  campo_rapido "$d/$id.corrida" rama; rama="$REPLY"
  [[ -n "$rama" ]] || { campo_rapido "$d/$id.hilo" rama; rama="$REPLY"; }
  ruta_ppal "$s"; ppal="$REPLY"
  if [[ -n "$rama" && -n "$ppal" && -n "${refs_de[$s/$rama]:-}" ]]; then
    commits="$(git -C "$ppal" rev-list --count "HEAD..$rama" 2>/dev/null || true)"
  fi
  linea_rapida "$d/$id.sid" && sid="$REPLY"
  if [[ -z "$sid" && -s "$d/$id.json" ]]; then
    IFS= read -r -d '' x <"$d/$id.json" || true
    [[ "$x" =~ \"session_id\":\"([A-Za-z0-9._-]+)\" ]] && sid="${BASH_REMATCH[1]}"
  fi
  if [[ "$sid" =~ ^[A-Za-z0-9._-]+$ ]]; then
    for t in "$PROJ"/*/"$sid.jsonl"; do
      [[ -f "$t" ]] || continue
      # sólo los mensajes del asistente: los tool_result (archivos enteros) eran casi todo el
      # volumen y el jq se iba en parsearlos
      # más el primer mensaje del usuario (la tarea, para las corridas viejas sin `.hilo`)
      { printf '\x1e%s\n' "$id"; primer_usuario "$t"
        tail -n 200 "$t" 2>/dev/null | grep -F '"type":"assistant"' || true; } >>"$4/cache"
      trans="$t"
      break
    done
  fi
  # Para estimar cuándo murió una corrida que nadie vio morir: lo último que se movió de lo suyo.
  # Acá no se sabe todavía si es `murio` (lo decide el jq): van las rutas de todo lo que no está
  # vivo ni resuelto, y UN solo stat para todas (cmd_hilos).
  if [[ -z "$vivo_e" && -z "${acc_de[$id]:-}" ]]; then
    for t in "$d/$id.log" "$d/$id.json" "$d/$id.err" "$trans"; do
      [[ -n "$t" && -e "$t" ]] && printf '%s\n' "$t" >>"$4/rutas"
    done
  fi
  local listo=0 leer=0
  [[ -f "$d/$id.listo" ]] && listo=1
  [[ -f "$d/$id.leer" ]] && leer=1
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
    "$id" "$s" "$d" "$vivo_e" "$en_cola" "$ini_run" "$tarea_run" "${acc_de[$id]:-}" \
    "$listo" "$leer" "$commits" "$ppal" "$trans" "$sid"
}

# decision_de y decision_es_nada (awk/bash, más abajo) en jq, para las corridas sin `.hilo`.
JQ_DECISION='
def decision_de:
  split("\n") as $l
  | ([range(0; $l | length) | select($l[.] | test("^[*#> \t-]*DECISI(O|Ó)N[*]*:"))] | last) as $a
  | (if $a != null then
       ($l[$a] | sub("^[*#> \t-]*DECISI(O|Ó)N[*]*:[*]*"; "")) as $t
       | if ($t | test("^[ \t]*$")) then
           ($l[$a + 1:] | reduce .[] as $x ({t: "", fin: false};
              if .fin then .
              elif ($x | test("^[*#> \t-]*SIGUE[*]*:")) then .fin = true
              elif ($x | test("^[ \t]*$")) then (if .t != "" then .fin = true else . end)
              else .t = (if .t == "" then $x else .t + " " + $x end) end) | .t)
         else $t end
     else
       ([$l[] | select(test("DECISI(O|Ó)N[*]*:"))] | last) as $m
       | if $m == null then "" else ([$m | splits("DECISI(O|Ó)N[*]*:[*]*")] | last) end
     end)
  | sub("[*#> \t-]*SIGUE[*]*:.*$"; "") | sub("^[ \t]+"; "") | sub("[ \t]+$"; "") | .[0:400];
# `trim` es de jq 1.7.1; la 1.7 (la de Ubuntu/WSL) no lo trae y todo `--hilos` fallaba. Definirlo acá
# vale para las dos: en la 1.7.1+ pisa al builtin con lo mismo.
def trim: sub("^\\s+"; "") | sub("\\s+$"; "");
def decision_es_nada: gsub("[*]"; "") | trim | sub("[.]$"; "") | ascii_downcase == "nada";
'

cmd_hilos() {
  local json=0 todo=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --todo) todo=1 ;;
      *) echo "uso: pa --hilos [--json] [--todo]" >&2; return 2 ;;
    esac
  done
  shopt -s nullglob
  local now corte d s f id k tmpd x
  now="$(date +%s)"; corte="$(date -d '-7 days' +%Y%m%d-%H%M%S)"
  local -A run_de=() acc_de=() visto=() ruta_de=() refs_de=()
  # corridas corriendo: id -> .running ; acción de la última fila de integradas.tsv por id
  for f in "$STATE"/*.running; do
    k="$(leer_campo "$f" id)"; [[ -n "$k" ]] && vivo "$f" && run_de[$k]="$f"
  done
  if [[ -f "$INTEGRADAS" ]]; then
    while IFS=$'\t' read -r id a; do [[ -n "$id" ]] && acc_de[$id]="$a"; done \
      < <(awk -F'\t' 'NR > 1 {print $2 "\t" $10}' "$INTEGRADAS")
  fi
  tmpd="$(mktemp -d)"
  : >"$tmpd/hechos"; : >"$tmpd/cache"; : >"$tmpd/archivos"; : >"$tmpd/rutas"; : >"$tmpd/mtimes"
  for d in "$STATE"/*/; do
    d="${d%/}"; s="${d##*/}"
    [[ "$s" == worktrees || "$s" == lock || "$s" == jefe ]] && continue
    for f in "$d"/*.hilo "$d"/*.corrida "$d"/*.json "$d"/*.pid "$d"/*.cola; do
      id="${f##*/}"; id="${id%.*}"
      [[ "$id" =~ $HILO_ID_RE && -z "${visto[$s/$id]:-}" ]] || continue
      visto[$s/$id]=1
      (( todo )) || en_ventana "$s" "$d" "$id" || continue
      hechos_de "$s" "$d" "$id" "$tmpd" >>"$tmpd/hechos"
      # UN solo stream (marca \x1d + ruta, después el contenido): con varios archivos sueltos
      # `jq -R` los concatena y la última línea de uno sin salto final se pega a la del siguiente.
      for k in hilo corrida json; do
        [[ -s "$d/$id.$k" ]] || continue
        IFS= read -r -d '' x <"$d/$id.$k" || true
        printf '\x1d%s\n%s\n' "$d/$id.$k" "$x" >>"$tmpd/archivos"
      done
    done
  done
  # "<epoch> <ruta>" por línea; una ruta que se borró en el medio hace salir 1 a stat: no importa
  [[ -s "$tmpd/rutas" ]] && { xargs -d '\n' stat -c '%Y %n' <"$tmpd/rutas" >"$tmpd/mtimes" 2>/dev/null || true; }
  jq -R -n --arg hechos "$tmpd/hechos" --arg cache "$tmpd/cache" --arg mtimes "$tmpd/mtimes" --arg now "$now" --arg off "$(date +%z)" "$JQ_DECISION"'
    def campos: [.[] | select(test("^[a-z_]+=")) | capture("^(?<k>[a-z_]+)=(?<v>.*)$")] | map({(.k): .v}) | add // {};
    def nonempty: if . == null or . == "" then null else . end;
    def num: if . == null or . == "" then null else (tonumber? // null) end;
    ($off | capture("^(?<s>[+-])(?<h>[0-9]{2})(?<m>[0-9]{2})$")
     | ((.h | tonumber) * 3600 + (.m | tonumber) * 60) * (if .s == "-" then -1 else 1 end)) as $offs
    | ($now | tonumber) as $ahora
    | reduce inputs as $l ({h: [], c: {}, f: {}, m: {}, cur: null, fcur: null};
        input_filename as $fn
        | if $fn == $hechos then .h += [$l | split("\u001f")]
          elif $fn == $mtimes then ($l | capture("^(?<t>[0-9]+) (?<p>.*)$")) as $x | .m[$x.p] = ($x.t | tonumber)
          elif $fn == $cache then (if ($l | startswith("\u001e")) then .cur = $l[1:] else .c[.cur] += [$l] end)
          elif ($l | startswith("\u001d")) then .fcur = $l[1:]
          else .f[.fcur] += [$l] end)
    | . as $all
    # la última corrida de cada sesión: un --seguir escribe en el MISMO transcript que la que retoma
    | (reduce ($all.h[] | select(.[13] != "")) as $x ({}; if (.[$x[13]] // "") < $x[0] then .[$x[13]] = $x[0] else . end)) as $ult_sid
    | [$all.h[] | . as [$id, $slug, $dir, $vivo, $en_cola, $ini_run, $tarea_run, $acc, $listo, $leer, $commits, $ppal, $trans, $sid]
      | ($all.f[$dir + "/" + $id + ".hilo"] // [] | campos) as $h
      | ($all.f[$dir + "/" + $id + ".corrida"] // [] | campos) as $c
      | ($all.f[$dir + "/" + $id + ".json"] | if . == null then null else (join("\n") | try fromjson catch null) end
         | if type == "object" then . else null end) as $j
      | ($h.decision // (if $j == null then null else (($j.result // "") | tostring | decision_de) end)) as $dec
      | ($h.decision_nada // (if $h.decision == null and $dec != null then (if ($dec | decision_es_nada) then "1" else "0" end) else null end)) as $dnada
      | (($h.inicio | num) // ($ini_run | num) // (try ($id[0:15] | strptime("%Y%m%d-%H%M%S") | mktime - $offs) catch null)) as $ini
      | (($h.leer // $c.leer) == "1" or $leer == "1") as $esleer
      | (($h.modelo | nonempty) // ($j.modelUsage // {} | to_entries | max_by(.value.outputTokens // 0) | .key?)) as $modelo
      # caché: el último mensaje del asistente (no sidechain) que creó caché da el TTL y la hora
      | ($all.c[$id] // [] | map(try fromjson catch empty | select(type == "object" and .type == "assistant" and (.isSidechain != true)))) as $as
      | ($as | map(select((.message.usage.cache_creation.ephemeral_1h_input_tokens // 0) > 0
                          or (.message.usage.cache_creation.ephemeral_5m_input_tokens // 0) > 0)) | last) as $cc
      | (if $cc == null then null elif ($cc.message.usage.cache_creation.ephemeral_1h_input_tokens // 0) > 0 then 3600 else 300 end) as $ttl0
      | (if $ttl0 == null then null else (try ($cc.timestamp | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601 + $ttl0 | floor) catch null) end) as $vence
      | (if $vence == null then null else $ttl0 end) as $ttl
      | (($all.c[$id] // []) | map(try fromjson catch empty | select(type == "object" and .type == "user")) | first
         | if . == null then null else (.message.content
             | if type == "string" then . elif type == "array" then (map(select(.type? == "text") | .text) | join(" ")) else "" end
             | gsub("\\s+"; " ") | trim | .[0:500] | nonempty) end) as $tarea_t
      | (($as | last) // {}) as $u
      | (if $ttl == null then null else ($u.message.model | nonempty) end) as $cmod
      # un --seguir corre donde está su .corrida; sin ella (integrada/descartada), en el tree principal
      | (($c.ruta_trabajo | nonempty) // $ppal | rtrimstr("/")) as $esperado
      | (if $ttl == null then null
         elif $ahora >= $vence then "vencido"
         elif $modelo != null and $cmod != null and $cmod != $modelo then "modelo"
         elif ($u.cwd // "") != "" and $esperado != "" and (($u.cwd | rtrimstr("/")) != $esperado) then "otro_dir"
         else null end) as $frio
      | (if $vivo != "" then $vivo
         elif ($h.archivado | nonempty) != null then "archivado"
         elif $acc == "integrada" then "integrado"
         elif $acc == "revertida" then "revertido"
         elif $acc == "descartada" then "descartado"
         elif $j == null then "murio"
         # la DECISION de una corrida del jefe que él ya recibió (sin .listo) la resolvió él
         elif ($dec | nonempty) != null and $dnada != "1"
              # ...y un .listo de más de un día ya no lo cobra nadie (--esperar cobra < 1 día)
              and (($listo == "1" and $ini != null and $ahora - $ini < 86400)
                   or (($h.lanzo | nonempty) // "jefe") != "jefe") then "decision"
         elif $listo == "1" and $ini != null and $ahora - $ini < 86400 then "listo"
         else "entregado" end) as $estado
      # Cuándo murió: exacta si pa la vio terminar (`fin=` del .hilo: su propio pa al salir, o el
      # --parar/--matar que la bajó); si no (kill -9, oomd), estimada: lo último que se movió de lo
      # suyo (.log, .json, .err y su transcript, salvo que un --seguir posterior lo siguió
      # escribiendo), y sin nada de eso, el inicio.
      | ($h.fin | num) as $fin
      | (if $estado != "murio" then null
         elif $fin != null then $fin
         else ([$all.m[$dir + "/" + $id + ".log"], $all.m[$dir + "/" + $id + ".json"], $all.m[$dir + "/" + $id + ".err"],
                (if $trans != "" and $ult_sid[$sid] == $id then $all.m[$trans] else null end)]
               | map(select(. != null)) | max) // $ini end) as $murio_en
      | {id: $id, proyecto: $slug,
         tarea: (($h.tarea | nonempty) // ($tarea_run | nonempty) // $tarea_t),
         modelo: $modelo,
         effort: ($h.effort | nonempty),
         cuenta: ($h.cuenta | nonempty),
         origen: (($h.lanzo | nonempty) // "jefe"),
         sigue_de: (($h.origen | nonempty) // ($c.origen | nonempty)),
         jefe: (($h.jefe | nonempty) // ($c.jefe | nonempty)),
         jefe_id: (($h.jefe_id | nonempty) // ($c.jefe_id | nonempty)),
         estado: $estado, en_cola: ($en_cola == "1"),
         murio_en: $murio_en, murio_en_exacta: (if $estado == "murio" then $fin != null else null end),
         inicio: $ini,
         duracion_s: (if $vivo != "" and $ini != null then ($ahora - $ini | floor)
                      elif ($j.duration_ms | type) == "number" then ($j.duration_ms / 1000 | floor)
                      else null end),
         puesto: (if $esleer then null else (($h.puesto | nonempty) // ($c.puesto | nonempty)) end),
         rama: (($c.rama | nonempty) // ($h.rama | nonempty)),
         commits: ($commits | num),
         decision: ($dec | nonempty), decision_nada: (if $dnada == null then null else $dnada == "1" end),
         sigue: ($h.sigue | nonempty),
         resultado: (($j.result // "") | tostring | if test("RESULTADO:") then
                       (capture("RESULTADO:[*]*\\s*(?<r>[\\s\\S]*)").r | split("ARCHIVOS:")[0] | split("DECISI")[0]
                        | gsub("\\s+"; " ") | trim | .[0:200] | nonempty)
                     else null end),
         archivado: ($h.archivado | nonempty),
         leer: $esleer,
         cache_ttl_s: $ttl, cache_vence: $vence, cache_frio: $frio, cache_modelo: $cmod}]
    | {version: 1, hilos: (sort_by(.id) | reverse)}' "$tmpd/hechos" "$tmpd/cache" "$tmpd/mtimes" "$tmpd/archivos" \
    >"$tmpd/salida.j" \
    || { echo "pa: --hilos: no pude armar el JSON (jq falló, arriba el porqué)." >&2; printf '{"version":1,"hilos":[]}\n' >"$tmpd/salida.j"; }
  if (( json )); then
    cat "$tmpd/salida.j"
  else
    jq -r '.hilos[] | [.id, .estado, .proyecto, ((.tarea // .resultado // "") | .[0:70])] | @tsv' "$tmpd/salida.j"
  fi
  rm -f "$tmpd/hechos" "$tmpd/cache" "$tmpd/archivos" "$tmpd/rutas" "$tmpd/mtimes" "$tmpd/salida.j"; rmdir "$tmpd" 2>/dev/null || true
  return 0
}

# `pa --hilo <id> --json [-n N] [--antes N]`: los mensajes del transcript de una corrida (user y
# asistente, sin sidechain ni tool_result; los tool_use de un mismo mensaje van juntos), los N
# últimos (default 50) antes del índice --antes. `usage`/`modelo` = los del último mensaje del asistente.
cmd_hilo() {
  local id="${1:-}" n=50 antes="" s d sid t="" a
  [[ -n "$id" && "$id" != -* ]] || { echo "uso: pa --hilo <id> [--json] [-n N] [--antes N]" >&2; return 2; }
  shift
  while (( $# )); do
    case "$1" in
      --json) ;;
      -n) n="${2:-}"; shift ;;
      --antes) antes="${2:-}"; shift ;;
      *) echo "uso: pa --hilo <id> [--json] [-n N] [--antes N]" >&2; return 2 ;;
    esac
    shift
  done
  [[ "$n" =~ ^[0-9]+$ && ( -z "$antes" || "$antes" =~ ^[0-9]+$ ) ]] \
    || { echo "pa: --hilo: -n y --antes son números." >&2; return 2; }
  s="$(proyecto_de_id "$id")"
  [[ -n "$s" ]] || { echo "pa: no encuentro la corrida '$id' en $STATE." >&2; return 1; }
  d="$STATE/$s"
  sid="$(cat "$d/$id.sid" 2>/dev/null || true)"
  [[ -n "$sid" ]] || sid="$(jq -r '.session_id // empty' "$d/$id.json" 2>/dev/null || true)"
  if [[ -n "$sid" && "$sid" =~ ^[A-Za-z0-9._-]+$ ]]; then
    for a in "$PROJ"/*/"$sid.jsonl"; do [[ -f "$a" ]] && { t="$a"; break; }; done
  fi
  jq -R -s --arg id "$id" --arg slug "$s" --arg t "$t" --argjson n "$n" --arg antes "$antes" '
    (if $t == "" then [] else
      [split("\n")[] | select(length > 0) | (try fromjson catch empty)
       | select(type == "object" and (.isSidechain != true)
                and (.type == "user" or .type == "assistant" or (.type == "system" and .subtype == "compact_boundary")))
       | {meta: (.isMeta == true), resumen_compact: (.isCompactSummary == true), origen: (.origin.kind? // null),
          error_api: (.isApiErrorMessage == true), error: (.error // null)} as $marcas
       | if .type == "system" then
           {rol: "system", subtipo: .subtype, ts: .timestamp, modelo: null, mid: null, usage: null, herramientas: [],
            herramientas_det: [], imagenes: 0, texto: (.content // "" | if type == "string" then . else tostring end)}
         elif .type == "user" then
           {rol: "user", ts: .timestamp, modelo: null, mid: null, usage: null, herramientas: [], herramientas_det: [],
            imagenes: (.message.content | if type == "array" then [.[]? | select(.type == "image")] | length else 0 end),
            texto: (.message.content | if type == "string" then . else ([.[]? | select(.type == "text") | .text] | join("\n")) end)}
         else
           {rol: "assistant", ts: .timestamp, modelo: .message.model, mid: .message.id, usage: .message.usage, imagenes: 0,
            herramientas: [.message.content[]? | select(.type == "tool_use") | .name],
            herramientas_det: [.message.content[]? | select(.type == "tool_use")
                               | {nombre: .name, entrada: ((.input // {}) | if type == "object"
                                   then with_entries(.value |= (if type == "string" then .[0:2000] else . end)) else {} end)}],
            texto: ([.message.content[]? | select(.type == "text") | .text] | join("\n"))}
         end
       | . + $marcas
       | select(.rol != "user" or .texto != "" or .imagenes > 0)]
      | reduce .[] as $m ([];
          if $m.rol == "assistant" and length > 0 and .[-1].rol == "assistant" and $m.mid != null and .[-1].mid == $m.mid
          then .[-1] |= (.texto = ([.texto, $m.texto] | map(select(. != "")) | join("\n"))
                         | .herramientas += $m.herramientas | .herramientas_det += $m.herramientas_det
                         | .usage = ($m.usage // .usage) | .modelo = ($m.modelo // .modelo)
                         | .error_api = (.error_api or $m.error_api) | .error = ($m.error // .error))
          else . + [$m] end)
      | map(select(.rol != "assistant" or .texto != "" or (.herramientas | length) > 0))
    end) as $todos
    | ($todos | length) as $total
    | ([$total, (if $antes == "" then $total else ($antes | tonumber) end)] | min) as $hasta
    | ([0, $hasta - $n] | max) as $desde
    | ([$todos[] | select(.rol == "assistant")] | last) as $ult
    | {version: 1, id: $id, proyecto: $slug, transcript: (if $t == "" then null else $t end),
       total: $total, desde: $desde, hasta: $hasta,
       mensajes: [$todos | to_entries[] | select(.key >= $desde and .key < $hasta)
                  | {i: .key, rol: .value.rol, texto: .value.texto, herramientas: .value.herramientas,
                     ts: .value.ts, modelo: .value.modelo}
                    + (.value | {herramientas_det, imagenes, meta, resumen_compact, origen, error_api, error}
                       + (if .rol == "system" then {subtipo} else {} end))],
       usage: ($ult.usage // null), modelo: ($ult.modelo // null)}' "${t:-/dev/null}"
}

# `pa --limpiar [--si]`: el build viejo de los worktrees de TODOS los proyectos. Sólo puestos
# libres (se toma su flock, exclusivo y -n, mientras se borra: ningún worker arranca a la mitad) y
# sólo dirs de build (dirs_de_build) sin ningún archivo tocado en PA_LIMPIAR_DIAS días (default 7;
# el mtime del dir solo no dice nada). Dry-run por default.
cmd_limpiar() {
  local aplicar=0 dias="${PA_LIMPIAR_DIAS:-7}" wt rel d n total=0 hay=0
  [[ "${1:-}" == --si ]] && aplicar=1
  mkdir -p "$LOCKDIR"
  for wt in "$STATE"/worktrees/*; do
    [[ -d "$wt" && ! -L "$wt" ]] || continue
    exec 6>"$LOCKDIR/$(basename "$wt")"
    if ! flock -n 6; then exec 6>&-; echo "  $(basename "$wt"): puesto en uso, no lo toco"; continue; fi
    while IFS= read -r rel; do
      [[ -n "$rel" ]] || continue
      d="$wt/$rel"
      [[ -z "$(find "$d" -mtime "-$dias" -print -quit 2>/dev/null)" ]] || continue
      n="$(du -sb -- "$d" 2>/dev/null | cut -f1)"; n="${n:-0}"
      total=$(( total + n )); hay=1
      printf '  %s/%s  %s\n' "$(basename "$wt")" "$rel" "$(numfmt --to=iec "$n" 2>/dev/null || echo "$n")"
      (( aplicar )) && rm -rf -- "${d:?}"
    done < <(dirs_de_build "$wt" borrar)
    exec 6>&-
  done
  local gb; gb="$(awk -v b="$total" 'BEGIN{printf "%.2f", b/1073741824}')"
  if (( ! hay )); then echo "pa --limpiar: nada de build con más de $dias días en worktrees libres."
  elif (( aplicar )); then echo "pa --limpiar: liberados $gb GB."
  else echo "pa --limpiar: se liberarían $gb GB (dry-run; con --si se borra)."; fi
  return 0
}

pid_vivo() { local p; p="$(leer_campo "$1" pid)"; [[ -n "$p" ]] || p="$(leer_campo "$1" pa_pid)"; printf %s "$p"; }
vivo() { local pid; pid="$(pid_vivo "$1")"; [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; }

transcurrido() {
  local s=$(( $(date +%s) - ${1:-0} ))
  (( s < 60 )) && { printf '%ds' "$s"; return; }
  (( s < 3600 )) && { printf '%dm%02ds' $((s/60)) $((s%60)); return; }
  printf '%dh%02dm' $((s/3600)) $(( (s%3600)/60 ))
}

# Hora de reset del límite de sesión: "resets 7:10pm (America/Argentina/Buenos_Aires)".
# Si la hora parseada ya pasó, es de mañana. Se exporta para que lo prueben los tests.
epoch_reset() {   # $1 = texto del result
  local hhmm ep ahora
  hhmm="$(printf '%s' "$1" | grep -oE 'resets[[:space:]]+[0-9]{1,2}(:[0-9]{2})?[[:space:]]*[ap]m' \
          | sed -n '1s/^resets[[:space:]]*//p')"
  [[ -n "$hhmm" ]] || return 1
  ep="$(date -d "$hhmm" +%s 2>/dev/null)" || return 1
  ahora="$(date +%s)"
  (( ep < ahora )) && ep=$(( ep + 86400 ))
  printf '%s' "$ep"
}

# ========================================================================================
# subcomandos que no lanzan worker
# ========================================================================================

cmd_estado() {
  shopt -s nullglob
  local f slug hb hubo=0 dslug tsid pid pst
  for f in "$STATE"/*.running; do
    hubo=1; slug="$(leer_campo "$f" proyecto)"
    if vivo "$f"; then
      # El .heartbeat va al lado del .running: `<slug>.heartbeat` para el que escribe,
      # `<slug>.leer-<id>.heartbeat` para cada --leer (puede haber varios por proyecto).
      hb="${f%.running}.heartbeat"
      printf 'CORRIENDO  %-20s hace %s' "$slug" "$(transcurrido "$(leer_campo "$f" inicio)")"
      if [[ "$(leer_campo "$f" leer)" == 1 ]]; then printf '  · lectura (id: %s)' "$(leer_campo "$f" id)"
      else
        pst="$(leer_campo "$f" puesto)"
        [[ "$pst" == aca ]] && pst="tree principal" || pst="puesto ${pst:-1}"
        printf '  · %s (id: %s)' "$pst" "$(leer_campo "$f" id)"
      fi
      if [[ -f "$hb" ]]; then
        printf '  · %s %s hace %s' \
          "$([[ "$(leer_campo "$hb" envuelo)" == 1 ]] && echo 'en' || echo 'último')" \
          "$(leer_campo "$hb" tool)" "$(transcurrido "$(leer_campo "$hb" epoch)")"
      fi
      printf '\n'
    else
      printf 'HUÉRFANO   %-20s (el claude murió; se limpia solo en el próximo pa%s, o: rm %s)\n' \
        "$slug" "$([[ "$(leer_campo "$f" leer)" == 1 ]] && echo ' --leer')" "$f"
    fi
  done
  # Corridas --async ENCOLADAS: todavía no tienen `.running` (eso lo escribe recién quien toma
  # un puesto), pero desde que arrancan dejan su pid en `$ts.pid`. Sin `.puesto` (que se escribe
  # apenas toman el flock, antes de cualquier git; `.corrida` es de las de antes de los puestos)
  # siguen esperando; si el pid ya no vive y no dejaron `.listo`, es el cadáver en cola que
  # `--esperar --id` también detecta (rc 82).
  for f in "$STATE"/*/*.pid; do
    dslug="$(dirname "$f")"
    case "$dslug" in "$STATE/worktrees"|"$STATE/lock") continue ;; esac
    slug="$(basename "$dslug")"; tsid="$(basename "$f" .pid)"
    [[ -f "$dslug/$tsid.puesto" || -f "$dslug/$tsid.corrida" ]] && continue
    [[ -f "$dslug/$tsid.listo" || -f "$dslug/$tsid.entregado" ]] && continue
    pid="$(cat "$f" 2>/dev/null)"
    if [[ -f "$dslug/$tsid.leer" ]]; then
      # --leer no toma puesto: o espera lugar del tope global (`.cola`), o está arrancando (ya va
      # a salir como CORRIENDO), o murió antes de arrancar.
      if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
        compgen -G "$STATE/$slug.leer-$tsid.running" >/dev/null && continue
        [[ -f "$dslug/$tsid.cola" ]] || continue
        hubo=1
        printf 'EN COLA    %-20s (--leer id: %s, %s)\n' "$slug" "$tsid" "$(cat "$dslug/$tsid.cola" 2>/dev/null)"
        continue
      fi
      hubo=1
      printf 'MURIÓ      %-20s (--leer id: %s, murió antes de arrancar; mirá %s)\n' "$slug" "$tsid" "$dslug/$tsid.log"
      continue
    fi
    hubo=1
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      printf 'EN COLA    %-20s (id: %s, %s)\n' "$slug" "$tsid" "$(cat "$dslug/$tsid.cola" 2>/dev/null || echo 'esperando un puesto libre')"
    else
      printf 'MURIÓ EN COLA %-17s (id: %s, nunca tomó puesto; mirá %s)\n' "$slug" "$tsid" "$dslug/$tsid.log"
    fi
  done
  (( hubo )) || echo "no hay workers corriendo."

  # RAM: lo que decide si entra otro worker (ver ram_alcanza); sin lugares tomados entra siempre
  local vivos_e=0 lf fd_e
  exec 5>"$LOCKDIR/@tope"; flock -w 2 5 2>/dev/null || true   # como tomar_lugar: sondear sin que otro vea el lugar ocupado
  for lf in "$LOCKDIR"/@tope@*; do
    exec {fd_e}>"$lf"
    flock -n "$fd_e" || vivos_e=$(( vivos_e + 1 ))
    exec {fd_e}>&-
  done
  exec 5>&-
  workers_sueltos; vivos_e=$(( vivos_e + REPLY ))
  ram_alcanza "$vivos_e" || true
  printf '\nRAM        disponible %s MB · reservada %s MB (workers recién admitidos, %s min) · hacen falta %s MB (%s + %s) · %s vivos de %s (tope)\n' \
    "$([[ "$ram_disp" -ge 0 ]] && echo "$ram_disp" || echo '?')" "$ram_reservada" "$RAM_RECIEN_MIN" "$ram_hace_falta" "$RAM_WORKER_MB" "$RAM_RESERVA_MB" "$vivos_e" "$TOPE"
  if [[ -n "$ram_motivo" ]]; then echo "           un worker nuevo haría cola: ${ram_motivo#RAM: }"
  elif (( vivos_e >= TOPE )); then echo "           un worker nuevo haría cola: tope global ($TOPE vivos)"
  else echo "           un worker nuevo entra ahora."; fi

  echo
  local found=0
  for f in "$STATE"/*.session; do
    found=1; slug="$(basename "$f" .session)"
    printf 'sesión     %-20s %s  (guardada %s)\n' "$slug" "$(cat "$f")" \
      "$(date -d "@$(stat -c %Y "$f")" '+%Y-%m-%d %H:%M')"
  done
  (( found )) || echo "no hay sesiones guardadas."

  if [[ -f "$LIMITE" ]] && (( $(cat "$LIMITE") > $(date +%s) )); then
    printf '\nLÍMITE de sesión hasta las %s: los workers no van a arrancar hasta entonces.\n' \
      "$(date -d "@$(cat "$LIMITE")" '+%H:%M')"
  fi
  if [[ "$PLAN" == pro ]]; then
    printf '\nplan pro (modo ahorro): opus con effort medium por default, tope 100 turnos, sin subagentes, resultado por --esperar.\n'
  else
    printf '\nplan max.\n'
  fi
}

# `pa --esperar <proy>` — bloquea hasta que el worker termine y trae su resultado.
# Con puestos ya no se espera un lock (hay varios, y "algún lock libre" no dice nada de ESTA
# corrida): la señal de vida es el pid de la corrida (`$ts.pid`, lo deja `pa --async` antes de
# fork) o su `.running`, y el fin es su `.listo`. Nada de loops de `pgrep` (se encontraban a sí
# mismos y no salían nunca).
# --- estado del jefe: notas + traspaso automático (2026-10-02) ----------------------------
# Nació para el relevo (pasar la posta a una sesión nueva; quitado el 2026-10-07: el jefe se compacta
# solo). Queda para retomar a mano si la sesión se cae. Escribirlo al final costaba una lectura entera
# de la conversación del jefe; ahora son dos partes que ya están en disco cuando hace falta:
#   - lo que `pa` sabe (qué corre, qué terminó sin cobrar, qué se cobró, qué ramas faltan integrar):
#     `pa --traspaso` lo arma del estado, sin gastar un token;
#   - lo que sólo sabe el jefe (qué pidió el dueño, qué se decidió, qué sigue): `--nota "<texto>"`, una
#     línea con fecha en `$STATE/jefe/<jefe_id>.notas`. Va pegada a una llamada que el jefe ya hace
#     (`pa miapp --async --nota 'SIGUE: …' '<tarea>'`), así no le suma una vuelta de herramienta
#     (cada vuelta relee toda su conversación).
# Una sesión que hereda PA_JEFE_ID sigue escribiendo en el mismo archivo.
notas_de_jefe() { local i; i="$(jefe_id)"; i="${i//[^A-Za-z0-9._-]/-}"; printf '%s/jefe/%s.notas' "$STATE" "${i:-sin-jefe}"; }
anotar() {   # $1 = texto
  [[ -n "${1// }" ]] || return 0
  local f; f="$(notas_de_jefe)"; mkdir -p "$(dirname "$f")"
  printf '%s · %s\n' "$(date '+%Y-%m-%d %H:%M')" "$(tr '\n' ' ' <<<"$1" | sed 's/ *$//')" >>"$f"
}
nombre_registry() {   # slug -> nombre del registry (lo que entiende `pa <proy>`), o el slug
  local reg="${PROYECTOS_REGISTRY:-$HOME/.config/proyectos/registry.json}" n=""
  [[ -f "$reg" ]] && n="$(jq -r --arg s "$1" '[.projects[] | select((.path | sub("/+$"; "") | split("/") | last | ascii_downcase) == $s) | .name][0] // empty' "$reg" 2>/dev/null)"
  printf '%s' "${n:-$1}"
}
# El `tests` del registry (un comando: corre con `bash -c` en la raíz del worktree), o nada.
tests_registry() {   # slug
  local reg="${PROYECTOS_REGISTRY:-$HOME/.config/proyectos/registry.json}"
  [[ -f "$reg" ]] || return 0
  jq -r --arg s "$1" '[.projects[] | select((.path | sub("/+$"; "") | split("/") | last | ascii_downcase) == $s) | .tests // empty][0] // empty' "$reg" 2>/dev/null || true
}
cmd_traspaso() {
  shopt -s nullglob
  local yo nombre f d t slug j r p rc linea hubo
  yo="$(jefe_id)"; nombre="$(jefe_nombre)"
  es_mia_t() {   # $1 = dir de la corrida (con /), $2 = ts
    [[ -z "$yo" ]] && return 0
    j=""; [[ -f "$1$2.corrida" ]] && j="$(leer_campo "$1$2.corrida" jefe_id)"
    [[ -z "$j" && -f "$1$2.jefe" ]] && j="$(leer_campo "$1$2.jefe" jefe_id)"
    [[ -z "$j" || "$j" == "$yo" ]]
  }
  resultado_de() {   # $1 = .listo/.entregado -> "rc · primera línea de RESULTADO"
    local o; o="$(leer_campo "$1" salida)"; rc="$(leer_campo "$1" rc)"
    # sin `head`/`grep -m`: con pipefail, cortar el pipe da 141 (ver el test de SIGPIPE)
    linea="$(jq -r '.result // ""' "$o" 2>/dev/null | awk '/^RESULTADO:/ && !v {v = substr($0, 1, 220)} END {print v}')"
    [[ -n "$linea" ]] || linea="$(jq -r '.result // "(sin resultado)"' "$o" 2>/dev/null | awk 'NR == 1 {v = substr($0, 1, 220)} END {print v}')"
    printf 'rc=%s · %s' "${rc:-?}" "${linea:-(sin resultado)}"
  }
  echo "# Traspaso automático del jefe — $(date '+%Y-%m-%d %H:%M')"
  echo
  echo "Armado por \`pa --traspaso\` desde el estado en disco (no gastó tokens). Jefe: ${nombre:-?} (id ${yo:-?})."
  echo
  echo "## Notas del jefe (pedidos de $(nombre_dueno), decisiones, qué sigue)"
  f="$(notas_de_jefe)"
  if [[ -s "$f" ]]; then tail -n 40 "$f" | sed 's/^/- /'; else echo "(no dejó notas)"; fi
  echo
  echo "## Corriendo ahora"
  hubo=0
  for r in "$STATE"/*.running; do
    vivo "$r" || continue
    j="$(leer_campo "$r" jefe_id)"; [[ -z "$yo" || -z "$j" || "$j" == "$yo" ]] || continue
    slug="$(leer_campo "$r" proyecto)"; hubo=1
    printf -- '- %s · id %s · hace %s · %s\n' "$(nombre_registry "$slug")" "$(leer_campo "$r" id)" \
      "$(transcurrido "$(leer_campo "$r" inicio)")" "$(leer_campo "$r" tarea | cut -c1-160)"
  done
  for p in "$STATE"/*/*.pid; do
    d="$(dirname "$p")/"; t="$(basename "$p" .pid)"
    [[ -f "$d$t.corrida" || -f "$d$t.listo" || -f "$d$t.entregado" ]] && continue
    kill -0 "$(cat "$p" 2>/dev/null)" 2>/dev/null || continue
    es_mia_t "$d" "$t" || continue
    hubo=1; printf -- '- %s · id %s · EN COLA\n' "$(nombre_registry "$(basename "$d")")" "$t"
  done
  (( hubo )) || echo "(nada)"
  echo
  echo "## Terminadas sin cobrar — cobralas con \`pa --esperar <proyecto> --id <id>\`"
  hubo=0
  for f in "$STATE"/*/*.listo; do
    d="$(dirname "$f")/"; t="$(basename "$f" .listo)"
    [[ -n "$(find "$f" -maxdepth 0 -mmin +1440 2>/dev/null)" ]] && continue
    es_mia_t "$d" "$t" || continue
    hubo=1; printf -- '- %s · id %s · %s\n' "$(nombre_registry "$(basename "$d")")" "$t" "$(resultado_de "$f")"
  done
  (( hubo )) || echo "(nada)"
  echo
  echo "## Cobradas en las últimas 12 h"
  hubo=0
  for f in "$STATE"/*/*.entregado; do
    [[ -n "$(find "$f" -maxdepth 0 -mmin -720 2>/dev/null)" ]] || continue
    d="$(dirname "$f")/"; t="$(basename "$f" .entregado)"
    es_mia_t "$d" "$t" || continue
    hubo=1; printf -- '- %s · id %s · %s\n' "$(nombre_registry "$(basename "$d")")" "$t" "$(resultado_de "$f")"
  done
  (( hubo )) || echo "(nada)"
  echo
  echo "## Ramas sin integrar (todavía NO están en main)"
  hubo=0
  for f in "$STATE"/*/*.corrida; do
    d="$(dirname "$f")/"; t="$(basename "$f" .corrida)"
    r="$(leer_campo "$f" rama)"; [[ -n "$r" ]] || continue
    es_mia_t "$d" "$t" || continue
    p="$(commits_pendientes "$(leer_campo "$f" ruta_trabajo)" "$r" 2>/dev/null)"
    [[ "$p" =~ ^[0-9]+$ ]] && (( p > 0 )) || continue
    slug="$(nombre_registry "$(basename "$d")")"; hubo=1
    printf -- "- %s · id %s · %s commit(s) · \`pa '%s' --integrar %s\`\n" "$slug" "$t" "$p" "$slug" "$t"
  done
  (( hubo )) || echo "(nada)"
}

# `pa --bien <id> si|no|parcial`: el jefe anota si la corrida salió bien (columna `bien` de
# medicion.tsv). Sin esa columna no se puede saber si ahorrar (effort, autocompact) costó calidad:
# es lo que el dashboard del dueño cruza con los tokens. Mismo flock e inodo que `medir`.
cmd_bien() {
  local id="${1:-}" val="${2:-}"
  [[ -n "$id" && "$val" =~ ^(si|no|parcial)$ ]] || { echo "uso: pa --bien <id-de-corrida> si|no|parcial" >&2; exit 2; }
  local MEDICION="$STATE/medicion.tsv"
  [[ -f "$MEDICION" ]] || { echo "pa: no hay $MEDICION todavía." >&2; exit 1; }
  local rc=0
  (
    flock 7
    awk -F'\t' -v i="$id" '$2 == i {n++} END {exit n ? 0 : 1}' "$MEDICION" || exit 1
    local tmp="$MEDICION.tmp.$$"
    awk -F'\t' -v OFS='\t' -v i="$id" -v v="$val" 'NR > 1 && $2 == i {$13 = v} {print}' "$MEDICION" >"$tmp" \
      && cat "$tmp" >"$MEDICION"
    rm -f "$tmp"
  ) 7>>"$MEDICION" || rc=$?
  if (( rc )); then echo "pa: no hay ninguna corrida '$id' en $MEDICION." >&2; exit 1; fi
  echo "pa: corrida $id anotada como '$val'."
}

# `pa --bien-auto`: completa la columna `bien` que el jefe no anotó, con lo que dice integradas.tsv.
# Revertida o descartada -> no (al toque). Integrada hace más de PA_BIEN_DIAS (7) días -> si, o
# parcial si después de integrarla alguien la retomó (un .hilo con `origen=` ese id que arrancó
# después). Lo que no se integró ni se descartó queda vacío. Nunca pisa un `bien` ya anotado.
# Una corrida que arrancó DESPUÉS de la integración de su origen no la cubre esa fila.
#
# Y las dos columnas de `pa --rinde` (2026-10-10), con una ventana de PA_RETRABAJO_HORAS (48):
#   integrada  1 = su rama entró a main (integrada, aunque después se revirtiera) · 0 = se descartó,
#              o tiene rama y sigue sin integrar pasada la ventana · vacío = no se sabe todavía o no
#              aplica (--leer, corridas en el tree principal, filas sin .hilo).
#   retrabajo  1 = se revirtió, o alguien la retomó con --seguir después de integrarla y dentro de
#              la ventana, o OTRA corrida del mismo proyecto se integró dentro de la ventana y cambió
#              o borró líneas que ésta había escrito (reescribe_lineas) · 0 = pasó la ventana sin
#              nada de eso · vacío = antes, si no entró a main, o si ya no se puede mirar (el
#              proyecto no está en el registry, o esos commits ya no existen).
# Tampoco pisan lo ya anotado, salvo cuando integradas.tsv lo contradice: un 0 por "pasó la ventana"
# pasa a 1 si la rama se integró más tarde, y un retrabajo 0 pasa a 1 si se revirtió después.
cmd_bien_auto() {
  local MEDICION="$STATE/medicion.tsv" INTEG="$STATE/integradas.tsv"
  [[ -f "$MEDICION" ]] || { echo "pa: no hay $MEDICION todavía." >&2; return 1; }
  local dias="${PA_BIEN_DIAS:-7}"; [[ "$dias" =~ ^[0-9]+$ ]] || dias=7
  local ahora; ahora="$(date +%s)"
  local lim=$(( ahora - dias * 86400 ))
  local horas="${PA_RETRABAJO_HORAS:-48}"; [[ "$horas" =~ ^[0-9]+$ ]] || horas=48
  local ven=$(( horas * 3600 ))
  local hilos="$STATE/.bien-auto.hilos.$$" integ="$STATE/.bien-auto.integ.$$" retra="$STATE/.bien-auto.retra.$$" hs=() f
  for f in "$STATE"/*/*.hilo; do [[ -f "$f" ]] && hs+=( "$f" ); done
  # id \t origen \t inicio \t rama de cada .hilo
  : >"$hilos"
  (( ${#hs[@]} )) && awk '
    function sale() { if (f != "") print id "\t" o "\t" i "\t" r }
    FNR == 1 { sale(); f = FILENAME; id = f; sub(/.*\//, "", id); sub(/\.hilo$/, "", id); o = ""; i = ""; r = "" }
    /^origen=/ { o = substr($0, 8) }
    /^inicio=/ { i = substr($0, 8) }
    /^rama=/   { r = substr($0, 6) }
    END { sale() }' "${hs[@]}" >"$hilos"
  # id \t accion \t epoch \t proyecto \t head_antes \t head_despues, en orden (la última fila de cada id gana)
  : >"$integ"
  if [[ -f "$INTEG" ]]; then
    local fecha id_i proy antes despues acc resto ep
    while IFS=$'\t' read -r fecha id_i proy _ _ antes despues _ _ acc resto; do
      [[ "$fecha" == fecha || -z "$id_i" ]] && continue
      ep="$(date -d "$fecha" +%s 2>/dev/null)" || continue
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$id_i" "$acc" "$ep" "$proy" "$antes" "$despues"
    done <"$INTEG" >"$integ"
  fi
  # Retrabajo por líneas: sólo las integradas que todavía tienen una fila con `retrabajo` vacío, y
  # contra cada OTRA integración del mismo proyecto dentro de la ventana. `id \t 1` (la reescribieron)
  # o `id \t ?` (no se pudo mirar). Fuera del flock: son git diff/blame, y sólo leen.
  : >"$retra"
  local k pj a1 b1 a2 b2 r rc_r
  local -A ruta_de=() visto=()
  while IFS=$'\t' read -r k pj a1 b1 a2 b2; do
    [[ -n "$k" && "${visto[$k]:-}" != 1 ]] || continue
    [[ -n "${ruta_de[$pj]+x}" ]] || ruta_de[$pj]="$(proyecto-ruta "$(nombre_registry "$pj")" 2>/dev/null || true)"
    r="${ruta_de[$pj]}"; rc_r=2
    if [[ -n "$r" && -d "$r" ]]; then rc_r=0; reescribe_lineas "$r" "$a1" "$b1" "$a2" "$b2" || rc_r=$?; fi
    case "$rc_r" in
      0) visto[$k]=1 ;;
      1) : ;;
      *) [[ -n "${visto[$k]:-}" ]] || visto[$k]='?' ;;
    esac
  done < <(awk -F'\t' -v OFS='\t' -v H="$hilos" -v I="$integ" -v ven="$ven" '
    FILENAME == I { acc[$1] = $2
                    if ($2 == "integrada") { n++; jid[n] = $1; jep[n] = $3 + 0; jpr[n] = $4; ja[n] = $5; jb[n] = $6; ult[$1] = n }
                    next }
    FILENAME == H { org[$1] = $2; next }
    FNR == 1 { for (i = 1; i <= NF; i++) c[$i] = i; cr = c["retrabajo"]; next }
    NF >= 13 && $6 != 1 && (!cr || cr > NF || $cr == "") {
      k = (org[$2] != "") ? org[$2] : $2
      if (acc[k] == "integrada") falta[k] = 1
    }
    END {
      for (k in falta) {
        m = ult[k]; if (ja[m] == jb[m]) continue
        for (j = 1; j <= n; j++)
          if (jid[j] != k && jpr[j] == jpr[m] && jep[j] > jep[m] && jep[j] <= jep[m] + ven && ja[j] != jb[j])
            print k, jpr[m], ja[m], jb[m], ja[j], jb[j]
      }
    }' "$integ" "$hilos" "$MEDICION")
  for k in "${!visto[@]}"; do printf '%s\t%s\n' "$k" "${visto[$k]}"; done >"$retra"
  local rc=0 cuenta=""
  (
    flock 7
    medicion_header_al_dia
    tmp="$MEDICION.tmp.$$"
    awk -F'\t' -v OFS='\t' -v H="$hilos" -v I="$integ" -v R="$retra" -v lim="$lim" -v ahora="$ahora" -v ven="$ven" -v N="$tmp.n" '
      FILENAME == I { acc[$1] = $2; ep[$1] = $3; if ($2 == "integrada") epi[$1] = $3 + 0; next }
      FILENAME == H { org[$1] = $2; ini[$1] = $3; rama[$1] = $4
                      if ($2 != "") {
                        if ($3 + 0 > seg[$2] + 0) seg[$2] = $3
                        if (($2 in epi) && $3 + 0 > epi[$2] && $3 + 0 <= epi[$2] + ven) rs[$2] = 1
                      }
                      next }
      FILENAME == R { rt[$1] = $2; next }
      FNR == 1 { for (i = 1; i <= NF; i++) c[$i] = i; ci = c["integrada"]; cr = c["retrabajo"]; print; next }
      NF >= 13 {
        id = $2; k = (org[id] != "") ? org[id] : id; i0 = ini[id] + 0
        cub = ((k in acc) && i0 <= ep[k] + 0)
        if ($13 == "" && cub) {
          e = ep[k] + 0; v = ""
          if (acc[k] == "revertida" || acc[k] == "descartada") v = "no"
          else if (acc[k] == "integrada" && e <= lim) v = (seg[k] + 0 > e) ? "parcial" : "si"
          if (v != "") { $13 = v; n[v]++; t++ }
        }
        if (ci && cr && $6 != 1) {
          vi = (ci <= NF) ? $ci : ""; vr = (cr <= NF) ? $cr : ""; ni = vi; nr = vr
          if (cub) {
            if (acc[k] == "descartada") { if (vi == "") ni = "0" }
            else if (acc[k] == "revertida") { ni = "1"; nr = "1" }
            else if (acc[k] == "integrada") {
              ni = "1"
              if (vr == "") {
                if (rt[k] == "1" || (k in rs)) nr = "1"
                else if (rt[k] != "?" && ahora + 0 > epi[k] + ven) nr = "0"
              }
            }
          } else if (!(k in acc) && vi == "" && rama[id] != "" && i0 > 0 && ahora + 0 > i0 + ven) ni = "0"
          if (ni "" != vi "" || nr "" != vr "") { $ci = ni; $cr = nr; m++ }
        }
      }
      { print }
      END { printf "%d anotadas (si: %d, parcial: %d, no: %d); integrada/retrabajo: %d fila(s)\n", t, n["si"], n["parcial"], n["no"], m > N }
    ' "$integ" "$hilos" "$retra" "$MEDICION" >"$tmp" && cat "$tmp" >"$MEDICION"
    rm -f "$tmp"
  ) 7>>"$MEDICION" || rc=$?
  [[ -f "$MEDICION.tmp.$$.n" ]] && cuenta="$(cat "$MEDICION.tmp.$$.n")"
  rm -f "$hilos" "$integ" "$retra" "$MEDICION.tmp.$$.n"
  (( rc )) && { echo "pa: --bien-auto no pudo reescribir $MEDICION." >&2; return 1; }
  echo "pa: --bien-auto: ${cuenta:-0 anotadas}."
}

# ¿La integración $4..$5 cambió o borró alguna línea que escribieron los commits de $2..$3? (en el
# repo $1). 0 = sí, 1 = no, 2 = no se puede saber (falta algún commit). Es la regla de retrabajo:
# "tocan un archivo en común" solo marcaba casi todo en un repo con archivos calientes (bin/pa,
# tests/run.sh, CLAUDE.md: dos tareas ajenas agregan cosas al mismo archivo el mismo día). Acá se
# miran las líneas que el diff de la segunda saca de su preimagen (`@@ -inicio,cuenta`, sin
# contexto) y con `git blame` de quién eran: agregar al lado no cuenta, pisar lo ajeno sí.
reescribe_lineas() {   # repo a1 b1 a2 b2
  local r="$1" a1="$2" b1="$3" a2="$4" b2="$5" x mios comunes f rangos autores
  for x in "$a1" "$b1" "$a2" "$b2"; do
    git -C "$r" cat-file -e "$x^{commit}" 2>/dev/null || return 2
  done
  mios="$(git -C "$r" rev-list "$a1..$b1" 2>/dev/null)" || return 2
  [[ -n "$mios" ]] || return 1
  comunes="$(LC_ALL=C comm -12 \
    <(git -C "$r" -c core.quotePath=false diff --name-only "$a1" "$b1" 2>/dev/null | LC_ALL=C sort) \
    <(git -C "$r" -c core.quotePath=false diff --name-only "$a2" "$b2" 2>/dev/null | LC_ALL=C sort))"
  [[ -n "$comunes" ]] || return 1
  while IFS= read -r f; do
    [[ -n "$f" ]] || continue
    mapfile -t rangos < <(git --literal-pathspecs -C "$r" diff -U0 "$a2" "$b2" -- "$f" 2>/dev/null | awk '
      /^@@ / { split($2, p, ","); s = substr(p[1], 2) + 0; c = (p[2] == "") ? 1 : p[2] + 0
               if (c > 0) printf "-L%d,+%d\n", s, c }')
    (( ${#rangos[@]} )) || continue
    autores="$(git --literal-pathspecs -C "$r" blame --porcelain "${rangos[@]}" "$a2" -- "$f" 2>/dev/null \
      | sed -n 's/^\([0-9a-f]\{40\}\) [0-9].*/\1/p' | LC_ALL=C sort -u)" || autores=""
    [[ -n "$autores" ]] || continue
    [[ -n "$(grep -xF -f <(printf '%s\n' "$mios") <<<"$autores" || true)" ]] && return 0
  done <<<"$comunes"
  return 1
}

# `pa --rinde [--dias N] [--json]`: qué rinde cada modelo × effort en cada tipo de tarea, desde
# medicion.tsv. Una línea por celda (tipo × modelo × effort), ordenado por tipo; las corridas sin
# `--tipo` van en la fila `?`. `ok%` = integradas sin retrabajo sobre las que ya tienen dato
# (`dato`: integrada=0, o integrada=1 con retrabajo 0/1; lo llena `pa --bien-auto`), mediana de
# turnos, costo medio (US$ a precio de lista) y % de las corridas que compactaron. Lee por nombre
# de columna: las filas de antes de `tipo` son más cortas y caen en `?` sin dato. Una cuenta que no es
# la de siempre es una celda aparte (`modelo@cuenta`; en --json, el campo `cuenta`).
cmd_rinde() {
  local dias=30 json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dias) dias="${2:-}"; shift; [[ $# -gt 0 ]] && shift ;;
      --json) json=1; shift ;;
      *) echo "uso: pa --rinde [--dias N] [--json]" >&2; return 2 ;;
    esac
  done
  [[ "$dias" =~ ^[0-9]+$ ]] || { echo "uso: pa --rinde [--dias N] [--json]  (N = días, un número)" >&2; return 2; }
  local MEDICION="$STATE/medicion.tsv" desde celdas=""
  desde="$(date -d "-$dias days" -Iseconds)"
  # tipo \t modelo \t effort \t n \t dato \t ok \t ok% \t mediana de turnos \t costo medio \t % compactó
  # (`~` = sin tipo, para que ordene al final; se muestra `?`)
  [[ -f "$MEDICION" ]] && celdas="$(awk -F'\t' -v OFS='\t' -v desde="$desde" '
    function v(n) { return ((n in c) && c[n] <= NF) ? $c[n] : "" }
    function num(x) { return x ~ /^[0-9]+(\.[0-9]+)?([eE][-+]?[0-9]+)?$/ }
    FNR == 1 { for (i = 1; i <= NF; i++) c[$i] = i; next }
    NF < 5 || $1 !~ /^[0-9][0-9][0-9][0-9]-/ || $1 < desde { next }
    {
      t = v("tipo"); if (t == "") t = "~"
      e = v("effort"); if (e == "") e = "settings"
      cu = v("cuenta"); if (cu == "claude" || cu == "google" || cu == "chatgpt") cu = ""
      k = t OFS v("modelo") OFS e OFS cu
      n[k]++
      i = v("integrada") ""; r = v("retrabajo") ""
      if (i == "0" || (i == "1" && (r == "0" || r == "1"))) { dato[k]++; if (i == "1" && r == "0") ok[k]++ }
      x = v("num_turns");      if (num(x)) tur[k, ++nt[k]] = x + 0
      x = v("costo_usd");      if (num(x)) { usd[k] += x; nu[k]++ }
      x = v("compactaciones"); if (num(x)) { nc[k]++; if (x + 0 > 0) comp[k]++ }
    }
    END {
      for (k in n) {
        m = nt[k] + 0
        for (a = 1; a <= m; a++) for (b = a + 1; b <= m; b++)
          if (tur[k, b] < tur[k, a]) { s = tur[k, a]; tur[k, a] = tur[k, b]; tur[k, b] = s }
        med = (m == 0) ? "" : (m % 2 ? tur[k, (m + 1) / 2] : (tur[k, m / 2] + tur[k, m / 2 + 1]) / 2)
        print k, n[k], dato[k] + 0, ok[k] + 0, (dato[k] ? sprintf("%.0f", 100 * ok[k] / dato[k]) : ""), med, \
          (nu[k] ? sprintf("%.2f", usd[k] / nu[k]) : ""), (nc[k] ? sprintf("%.0f", 100 * comp[k] / nc[k]) : "")
      }
    }' "$MEDICION" | LC_ALL=C sort -t$'\t' -k1,1 -k2,2 -k3,3 -k4,4)"
  if (( json )); then
    jq -Rn --arg dias "$dias" --arg desde "$desde" '
      def n: if . == "" then null else tonumber end;
      {version: 1, dias: ($dias | tonumber), desde: $desde,
       celdas: [inputs | select(. != "") | split("\t")
                | {tipo: (if .[0] == "~" then "?" else .[0] end), modelo: .[1], effort: .[2],
                   cuenta: (if .[3] == "" then null else .[3] end),
                   n: (.[4] | n), con_dato: (.[5] | n), ok: (.[6] | n), pct_ok: (.[7] | n),
                   turnos_mediana: (.[8] | n), costo_medio_usd: (.[9] | n), pct_compacto: (.[10] | n)}]}' <<<"$celdas"
    return 0
  fi
  [[ -n "$celdas" ]] || { echo "pa: ninguna corrida en los últimos $dias días."; return 0; }
  echo "últimos $dias días · ok% = integrada sin retrabajo, sobre las que ya tienen dato (pa --bien-auto) · turnos = mediana · US\$ = costo medio · comp% = compactaron"
  printf '%-15s %-18s %-8s %4s %5s %5s %7s %8s %6s\n' tipo modelo effort n dato 'ok%' turnos 'US$' 'comp%'
  local t mo e cu n d o p tu us co
  while IFS='|' read -r t mo e cu n d o p tu us co; do
    [[ "$t" == "~" ]] && t="?"
    [[ -n "$cu" ]] && mo="$mo@$cu"   # una cuenta que no es la de siempre (docs/cuentas-varias-por-proveedor.md)
    printf '%-15s %-18s %-8s %4s %5s %5s %7s %8s %6s\n' "$t" "$mo" "$e" "$n" "$d" "${p:--}" "${tu:--}" "${us:--}" "${co:--}"
  done < <(tr '\t' '|' <<<"$celdas")
}

# Un campo del RESULTADO (stdin) en una línea: la ÚLTIMA línea que arranca con su encabezado
# (DECISION/DECISIÓN, SIGUE; con markdown adelante: `**`, `#`, `-`, `>`); si después de los dos
# puntos no hay nada, junta las líneas que siguen hasta la primera vacía o hasta otro encabezado.
# Sin ninguna anclada, lo que sigue a la última mención suelta (un RESULTADO de una sola línea).
# La DECISION se corta donde arranca el SIGUE (va después, a veces en la misma línea). Tope 400.
# Con $2 = todo: el campo entero, con sus saltos de línea, hasta el próximo encabezado (tope 2000).
campo_de() {   # $1 = regex del encabezado, $2 = "todo" (opcional)
  awk -v re="$1" -v todo="${2:-}" '
    BEGIN { anc = "^[*#> \t-]*" re "[*]*:"; otro = "^[*#> \t-]*(RESULTADO|ARCHIVOS|DECISI(O|Ó)N|SIGUE)[*]*:" }
    { l[NR] = $0 }
    END {
      a = 0; t = ""
      for (i = 1; i <= NR; i++) if (l[i] ~ anc) a = i
      if (a) {
        t = l[a]; sub(anc "[*]*", "", t)
        if (todo != "") {
          for (j = a + 1; j <= NR && l[j] !~ otro; j++) t = t "\n" l[j]
        } else if (t ~ /^[ \t]*$/) {
          t = ""
          for (j = a + 1; j <= NR && l[j] !~ otro; j++) {
            if (l[j] ~ /^[ \t]*$/) { if (t != "") break; continue }
            t = t (t == "" ? "" : " ") l[j]
          }
        }
      } else {
        for (i = NR; i >= 1 && t == ""; i--) {
          s = l[i]; hay = 0
          while (match(s, re "[*]*:[*]*")) { s = substr(s, RSTART + RLENGTH); hay = 1 }
          if (hay) t = s
        }
      }
      if (re != "SIGUE") sub(/[*#> \t-]*SIGUE[*]*:.*$/, "", t)
      gsub(/^[ \t\n]+|[ \t\n]+$/, "", t)
      print substr(t, 1, todo != "" ? 2000 : 400)
    }'
}
# El bloque opcional de preguntas y pruebas del worker (formato en el CONTRATO), tolerante a
# markdown (`**`, `-`, `>`, `#` adelante) y a mayúsculas. Sale una línea por dato, con la letra y
# un tab: P pregunta, C contexto, O opción (de la pregunta que sigue abierta), D número de la
# opción por defecto (vacío si no resolvió), T algo para probar. Las preguntas valen TODAS o
# ninguna: una sin texto, o con menos de 2 u 4+1 opciones, descarta el bloque de preguntas entero
# (anotar_tablero cae a la DECISION en prosa, como antes del bloque). Los T no dependen de eso.
bloque_de() {
  awk '
    function limpio(t) { gsub(/^[*_ \t]+|[*_ \t]+$/, "", t); return t }
    function valor(s) { sub(/^[^:]*:/, "", s); return limpio(s) }
    function cierra() { enctx = 0; entest = 0 }
    function defecto(v, q,   n, i, a) {
      v = tolower(limpio(v)); sub(/^opci(o|ó)n[ \t]+/, "", v); sub(/[.)]$/, "", v)
      if (v ~ /^[0-9]+$/) return (v + 0 >= 1 && v + 0 <= no[q]) ? v + 0 : ""
      if (v ~ /^[a-d]$/) { n = index("abcd", v); return (n <= no[q]) ? n : "" }
      for (i = 1; i <= no[q]; i++) { a = tolower(op[q, i]); sub(/[.]$/, "", a); if (a == v) return i }
      return ""
    }
    BEGIN { nq = 0; nt = 0; q = 0 }
    {
      s = $0; sub(/^[*#> \t-]+/, "", s); h = toupper(s)
      if (s ~ /^[ \t]*$/) { cierra(); next }
      if (h ~ /^(RESULTADO|ARCHIVOS|DECISI(O|Ó)N|SIGUE)[ \t*_]*:/) { q = 0; cierra(); next }
      if (h ~ /^PROBAR[ \t*_]*:/) {
        q = 0; cierra(); v = valor(s); entest = 1
        if (v != "") { t[++nt] = v; entest = 1 } else entest = 2
        next
      }
      if (entest && h !~ /^(PREGUNTA|CONTEXTO|OPCI(O|Ó)N|DEFECTO)[ \t*_]*:/) {
        v = limpio(s)
        if (entest == 2 || $0 ~ /^[ \t]*[-*•][ \t]/) t[++nt] = v
        next
      }
      if (h ~ /^PREGUNTA[ \t*_]*:/) { cierra(); q = ++nq; pr[q] = valor(s); cx[q] = ""; no[q] = 0; df[q] = ""; next }
      if (!q) next
      if (h ~ /^CONTEXTO[ \t*_]*:/)  { cierra(); cx[q] = valor(s); enctx = 1; next }
      if (h ~ /^OPCI(O|Ó)N[ \t*_]*:/) { cierra(); no[q]++; op[q, no[q]] = valor(s); next }
      if (h ~ /^(DEFECTO|POR DEFECTO|DEFAULT)[ \t*_]*:/) { cierra(); df[q] = valor(s); next }
      if (enctx && cx[q] != "") cx[q] = cx[q] " " limpio(s)
    }
    END {
      ok = (nq > 0)
      for (i = 1; i <= nq && ok; i++) if (pr[i] == "" || no[i] < 2 || no[i] > 4) ok = 0
      if (ok) for (i = 1; i <= nq; i++) {
        print "P\t" pr[i]; print "C\t" cx[i]
        for (j = 1; j <= no[i]; j++) print "O\t" op[i, j]
        print "D\t" (df[i] == "" ? "" : defecto(df[i], i))
      }
      for (i = 1; i <= nt; i++) print "T\t" t[i]
    }'
}
decision_de() { campo_de 'DECISI(O|Ó)N' "$@"; }
sigue_de()    { campo_de 'SIGUE' "$@"; }

# "nada" estricto: sin asteriscos ni espacios, a lo sumo un punto final. "nada. Supuestos: …" o
# "Ninguna" NO son nada (falla cerrado: la app la muestra como pendiente de leer).
decision_es_nada() {
  local d="${1//\*/}"
  d="${d#"${d%%[![:space:]]*}"}"; d="${d%"${d##*[![:space:]]}"}"; d="${d%.}"
  [[ "${d,,}" == nada ]]
}

# Al salir: DECISION, decision_nada y SIGUE en el `.hilo`. Nunca rompe a pa. Deja en
# tab_decision/tab_sigue lo que después va al tablero (anotar_tablero).
tab_decision=""; tab_sigue=""; tab_bloque=""
anotar_decision() {   # $1 = json de salida
  local d="" s="" res=""
  [[ -s "$1" ]] && { res="$(jq -r '.result // empty' "$1" 2>/dev/null)" || res=""; }
  tab_bloque="$(bloque_de <<<"$res" 2>/dev/null)" || tab_bloque=""
  d="$(decision_de <<<"$res")" || d=""
  s="$(sigue_de <<<"$res")" || s=""
  hilo_poner "$ts" decision "$d"
  if decision_es_nada "$d"; then
    hilo_poner "$ts" decision_nada 1
  else
    hilo_poner "$ts" decision_nada 0
    tab_decision="$(decision_de todo <<<"$res")" || tab_decision=""
  fi
  hilo_poner "$ts" sigue "$s"
  [[ -z "$s" ]] || decision_es_nada "$s" || tab_sigue="$s"
}

# Las preguntas del bloque (tab_bloque, ver bloque_de) entran cada una como un item `pregunta`
# con botones, clave `pa:<id>:<n>`, y el texto técnico de la DECISION en `detalle`. Devuelve 1 si no
# hay preguntas (sin bloque, bloque roto, o tablero que no contestó): entonces anotar_tablero
# anota la DECISION entera como siempre. Si al menos la primera entró, cierra el item de DECISION
# suelto `pa:<id>` de una pasada anterior de la misma corrida (ya lo reemplazan las preguntas).
tablero_preguntas() {
  local clave="pa:${origen:-$ts}" k n=0 ok=0 c t x
  local -a a=()
  [[ "$tab_bloque" == P$'\t'* ]] || return 1
  _agrega() {
    (( n )) || return 0
    tablero_mudo 5 agregar "${a[0]:0:90}" --columna espera-dueno --proyecto "$slug" --origen pa \
      --clave "$clave:$n" --tipo pregunta "--simple=${a[0]}" "${a[@]:1}" >/dev/null && ok=$(( ok + 1 ))
    a=()
  }
  while IFS=$'\t' read -r k t; do
    case "$k" in
      P) _agrega; n=$(( n + 1 )); a=( "$t" ); [[ -z "$tab_decision" ]] || a+=( "--detalle=$tab_decision" ) ;;
      C) [[ -z "$t" ]] || a+=( "--contexto=$t" ) ;;
      O) a+=( "--opcion=$t" ) ;;
      D) [[ -z "$t" ]] || a+=( "--defecto=$t" ) ;;
    esac
  done <<<"$tab_bloque"
  _agrega; unset -f _agrega
  (( ok )) || return 1
  tablero_mudo 5 cerrar --clave "$clave" >/dev/null || true
  return 0
}

# Lo que el worker dijo que el dueño tiene que probar (PROBAR:): un item `prueba` por corrida, clave
# `pa:<id>:p1`, con lo que hay que mirar en `prueba`. Dos filtros (2026-10-18, el dueño tenía +300
# pruebas pavas en espera-dueno): una PROBAR que es un comando que el worker podría correr él
# (primer token en `prueba_es_comando`) no entra, y de las que quedan entra a lo sumo la primera.
prueba_es_comando() {   # $1 = texto de la PROBAR
  local t="${1#"${1%%[![:space:]]*}"}" w
  t="${t#\$ }"; t="${t#\`}"; w="${t%%[[:space:]\`]*}"; w="${w,,}"
  case "$w" in
    cargo|rustc|npm|npx|pnpm|yarn|bun|deno|node|python|python3|pytest|uv|pip|bash|sh|zsh|make|just|go|git|\
    curl|wget|grep|rg|jq|sqlite3|psql|systemctl|journalctl|docker|podman|tests/*|./*|bin/*|scripts/*|~/*|/*) return 0 ;;
  esac
  return 1
}
tablero_pruebas() {
  local k t
  while IFS=$'\t' read -r k t; do
    [[ "$k" == T && -n "$t" ]] || continue
    prueba_es_comando "$t" && continue
    tablero_mudo 5 agregar "Probar: ${t:0:80}" --columna espera-dueno --proyecto "$slug" --origen pa \
      --clave "pa:${origen:-$ts}:p1" --tipo prueba "--prueba=$t" "--simple=Probar: ${t:0:80}" >/dev/null || true
    break
  done <<<"$tab_bloque"
  return 0
}

# Lo que la corrida dejó abierto entra solo al tablero (cero tokens, y no depende de que el jefe
# se acuerde). La DECISION: un item `espera-dueno` por corrida, clave `pa:<id>` (el id con el que
# se integra: un --seguir actualiza el mismo item). Sin texto de DECISION no hay qué anotar.
# El SIGUE vale cuando el trabajo está en el tree principal: acá sólo el de --aca y el de los
# proyectos sin git; el de un worktree lo anota --integrar, y el de un --leer no se anota.
anotar_tablero() {
  local titulo cabeza
  if tablero_preguntas; then :
  elif [[ -n "$tab_decision" ]]; then
    titulo="${tab_decision%%$'\n'*}"
    tablero_mudo 5 agregar "${titulo:0:90}" --columna espera-dueno --proyecto "$slug" \
      --detalle "$tab_decision" --origen pa --clave "pa:${origen:-$ts}" >/dev/null || true
  fi
  tablero_pruebas
  if [[ -n "$tab_sigue" ]] && (( ! leer && ! usa_worktree )); then
    cabeza="$(git -C "$ruta" rev-parse -q --verify HEAD 2>/dev/null)" || cabeza=""
    tablero_mudo 5 sigue "$slug" "$tab_sigue" ${cabeza:+--head "$cabeza"} >/dev/null || true
  fi
  return 0
}

# El SIGUE de una corrida que acaba de entrar al tree principal: el del último `.hilo` suyo que lo
# dijo (ella o sus --seguir, que llevan `origen=<id>`; el glob sale en orden cronológico). Una
# corrida vieja sin el campo, o con "nada", no anota.
sigue_al_tablero() {   # $1 = id, $2 = HEAD después de integrar
  local s
  s="$(awk -v id="$1" '
    function fin() { if (sg != "" && (f == id || o == id)) r = sg }
    FNR == 1 { fin(); f = FILENAME; sub(/.*\//, "", f); sub(/\.hilo$/, "", f); o = ""; sg = "" }
    /^origen=/ { o = substr($0, 8) }
    /^sigue=/ { sg = substr($0, 7) }
    END { fin(); print r }' "$dir"/*.hilo 2>/dev/null)" || s=""
  [[ -z "$s" ]] || decision_es_nada "$s" || tablero_mudo 5 sigue "$slug" "$s" --head "$2" >/dev/null || true
  return 0
}

# `pa --esperar-todos [--timeout N]`: cobra TODAS las corridas async del jefe (writers y --leer,
# de cualquier proyecto) en una sola llamada. En plan pro el worker no avisa por mensaje: sin esto
# el jefe encadenaba un `--esperar --id` por corrida a mano. Un turno del jefe para N resultados,
# en vez de N despertadas releyendo todo su contexto. Cada una se entrega con el mismo
# `--esperar --id` de siempre (mismo formato, mismo rc); sale con el primer rc distinto de 0.
# Dos esperas a la vez (2026-10-10: dos `--esperar-todos` de la misma sesión) arman la misma cola.
# La que pierde la carrera por un resultado no lo entrega de nuevo ni lo cuenta como fallo: el
# `--esperar --id` hijo sale OTRA_ESPERA y acá se saltea. Antes lo informaba como "murió corriendo
# sin dejar resultado" (82) aunque la corrida había terminado bien.
OTRA_ESPERA=94   # interno, entre `--esperar-todos` y su `--esperar --id`: nunca sale de pa
cmd_esperar_todos() {
  local timeout=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      *) echo "pa --esperar-todos: opción desconocida: $1" >&2; exit 2 ;;
    esac
  done
  local yo d p t j slug fin=0 rc=0 r n=0 resto sal otras=0
  yo="$(jefe_id)"
  (( timeout > 0 )) && fin=$(( $(date +%s) + timeout ))
  local -a cola=()
  for d in "$STATE"/*/; do
    slug="$(basename "$d")"; [[ "$slug" == lock || "$slug" == worktrees ]] && continue
    for p in "$d"*.pid; do
      [[ -f "$p" ]] || continue
      t="$(basename "$p" .pid)"
      [[ -f "$d$t.entregado" ]] && continue
      if [[ -f "$d$t.listo" ]]; then
        [[ -n "$(find "$d$t.listo" -maxdepth 0 -mmin +1440 2>/dev/null)" ]] && continue   # vencido
      else
        kill -0 "$(cat "$p" 2>/dev/null)" 2>/dev/null || continue   # ni resultado ni vivo
      fi
      if [[ -n "$yo" ]]; then
        j=""
        [[ -f "$d$t.corrida" ]] && j="$(leer_campo "$d$t.corrida" jefe_id)"
        [[ -z "$j" && -f "$d$t.jefe" ]] && j="$(leer_campo "$d$t.jefe" jefe_id)"
        [[ -z "$j" || "$j" == "$yo" ]] || continue
      fi
      cola+=( "$slug $t" )
    done
  done
  (( ${#cola[@]} )) || { echo "pa: nada pendiente tuyo (ninguna corrida async viva ni sin cobrar)." >&2; return 1; }
  echo "pa: esperando ${#cola[@]} corrida(s)…" >&2
  for r in "${cola[@]}"; do
    local -a extra=()
    if (( fin )); then
      resto=$(( fin - $(date +%s) )); (( resto < 1 )) && resto=1
      extra=( --timeout "$resto" )
    fi
    local rc1=0
    # El stdout del hijo se junta y sale con su encabezado: si el resultado ya lo entregó otra
    # espera, de esta corrida no sale nada por stdout (el aviso del hijo va por stderr).
    sal="$(PA_ESPERA_TODOS=1 "$_BIN/pa" --esperar "${r% *}" --id "${r#* }" "${extra[@]}")" || rc1=$?
    if (( rc1 == OTRA_ESPERA )); then otras=$(( otras + 1 )); continue; fi
    n=$(( n + 1 )); echo; echo "══ ${r% *} (corrida ${r#* }) ══"
    [[ -n "$sal" ]] && printf '%s\n' "$sal"
    (( rc == 0 && rc1 != 0 )) && rc=$rc1
  done
  echo; echo "— $n corrida(s) cobradas$( (( otras )) && echo " ($otras ya las había entregado otra espera)" ) · rc=$rc"
  return "$rc"
}

cmd_esperar() {
  local proy="${1:-}" timeout=0 id=""
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --timeout) timeout="$2"; shift 2 ;;
      --id)      id="$2"; shift 2 ;;
      *) echo "pa --esperar: opción desconocida: $1" >&2; exit 2 ;;
    esac
  done
  [[ -n "$proy" ]] || { echo "uso: pa --esperar <proyecto> [--timeout SEGUNDOS] [--id <id-de-corrida>]" >&2; exit 2; }

  local ruta slug
  # El slug es el basename de la ruta REAL y no siempre es un nombre del registry
  # ("Tab Reaper" vive en chrome-tab-reaper). Como `pa --async` imprime el slug, hay que
  # aceptarlo: si ya corrió algo con ese nombre, es ése, sin pasar por el registry.
  # Un proyecto que sólo tuvo corridas --leer nunca creó un lock (no lo toman): se lo reconoce
  # por sus marcas `<ts>.leer`.
  ya_corrio() { [[ -e "$LOCKDIR/$1" ]] || compgen -G "$LOCKDIR/$1@*" >/dev/null || compgen -G "$STATE/$1/*.leer" >/dev/null; }
  slug="${proy,,}"; slug="${slug//[^A-Za-z0-9._-]/-}"
  if ! ya_corrio "$slug"; then
    ruta="$(proyecto-ruta "$proy")" || exit 1
    slug="$(slug_de "$ruta")"
  fi
  ya_corrio "$slug" || { echo "pa: nunca corrió un worker en '$slug'." >&2; exit 1; }

  # Cada corrida deja su propio `<slug>/<ts>.listo` (lo escribe el trap de EXIT de pa) y
  # acá se entrega el más viejo que todavía no se entregó, renombrándolo a .entregado. Así
  # dos --esperar seguidos traen dos resultados distintos, en orden, y ninguno se pierde.
  # Un `.listo` que nadie cobró queda en disco para siempre, y sin --id `--esperar` entrega el
  # MÁS VIEJO: el 2026-09-12 había 15 sin cobrar, tres de hacía tres días. O sea que un
  # `--esperar` después de lanzar un worker devolvía un resultado de otra tarea de otro día con
  # rc 0, y el jefe lo leía como el de la corrida que acababa de lanzar. Vencen al día. No se
  # borran: `--esperar --id <corrida>` los trae igual, porque ahí lo estás pidiendo a propósito.
  # `--esperar <proy>` pelado entrega sólo lo del que ESCRIBE: los .listo de corridas --leer
  # (marca `<ts>.leer`) se saltean, y una consulta de lectura que terminó primero no se devuelve
  # como si fuera el resultado del worker que acabás de lanzar. Se cobran con `--id`.
  # Y sólo lo de SU jefe: con puestos dos sesiones de Claude pueden tener writers en el mismo
  # proyecto, y "el más viejo" podía ser el del otro. El dueño es `jefe_id=` de la `.corrida`
  # (o de `$ts.jefe`, que el padre de --async escribe antes del fork, para los que siguen en
  # cola). Si falta de algún lado (corridas viejas, un jefe sin sesión), no filtra.
  local d="$STATE/$slug" f vencidos=0 yo
  yo="$(jefe_id)"
  jefe_de() {   # $1 = ts -> jefe_id de esa corrida, o nada
    local j=""
    [[ -f "$d/$1.corrida" ]] && j="$(leer_campo "$d/$1.corrida" jefe_id)"
    [[ -z "$j" && -f "$d/$1.jefe" ]] && j="$(leer_campo "$d/$1.jefe" jefe_id)"
    printf '%s' "$j"
  }
  es_mia() { local j; [[ -z "$yo" ]] && return 0; j="$(jefe_de "$1")"; [[ -z "$j" || "$j" == "$yo" ]]; }
  pendiente() {
    if [[ -n "$id" ]]; then f="$d/$id.listo"; [[ -f "$f" ]]; return; fi
    local c t
    f=""; vencidos=0
    while read -r c; do
      [[ -n "$c" ]] || continue
      [[ -f "${c%.listo}.leer" ]] && continue
      t="$(basename "${c%.listo}")"
      es_mia "$t" || continue
      if [[ -n "$(find "$c" -maxdepth 0 -mmin +1440 2>/dev/null)" ]]; then
        vencidos=$(( vencidos + 1 )); continue
      fi
      f="$c"; break
    done < <(ls "$d"/*.listo 2>/dev/null | sort)
    [[ -n "$f" ]]
  }
  # El aviso va una sola vez, no en cada vuelta del loop.
  aviso_vencidos() {
    (( vencidos > 0 )) || return 0
    echo "pa: (salteé $vencidos resultado(s) de '$slug' de más de un día; están en $d, traelos con --esperar --id <corrida> si los querés)" >&2
    vencidos=0
  }
  # Ya la entregó otra espera (otro `--esperar`/`--esperar-todos` a la vez, o uno anterior). No es
  # una muerta ni un fallo de la corrida: no se entrega de nuevo. A mano sale 1, como siempre;
  # debajo de `--esperar-todos` sale OTRA_ESPERA para que la saltee sin contarla como fallo.
  ya_entregada() {   # $1 = ts
    echo "pa: la corrida $1 de '$slug' ya se entregó ($d/$1.entregado): la cobró otra espera, no la entrego de nuevo." >&2
    [[ -n "${PA_ESPERA_TODOS:-}" ]] && exit "$OTRA_ESPERA"
    exit 1
  }
  entregar() {
    # El mv es el que decide quién la entrega: con dos esperas sobre el mismo .listo, la que
    # pierde el rename no muestra nada. Por eso se lee DESPUÉS de moverlo, del .entregado.
    local rc e="${f%.listo}.entregado"
    while ! mv -f "$f" "$e" 2>/dev/null; do
      [[ -n "$id" ]] && ya_entregada "$id"
      # sin --id: el más viejo se lo llevó otra espera; va el que sigue, si hay
      pendiente || { echo "pa: nada pendiente en '$slug': el resultado que había se lo llevó otra espera." >&2; exit 1; }
      e="${f%.listo}.entregado"
    done
    rc="$(leer_campo "$e" rc)"; out="$(leer_campo "$e" salida)"
    [[ -f "$out" ]] && mostrar_resultado "$out"
    [[ "$rc" == 81 || "$rc" == 84 ]] && claude_falla "$rc" ""
    # el id va visible: si este resultado ya te había llegado por mensaje, acá se nota
    echo "— corrida $(basename "${f%.listo}") · rc=${rc:-0}"
    return "${rc:-0}"
  }
  pendiente || true; aviso_vencidos
  if [[ -n "$id" ]]; then
    [[ -f "$d/$id.entregado" ]] && ya_entregada "$id"
    [[ -f "$d/$id.log" || -f "$d/$id.corrida" || -f "$d/$id.puesto" ]] || { echo "pa: no existe la corrida $id de '$slug' (sin $d/$id.log)." >&2; exit 1; }
  fi
  # Las corridas --leer que el pelado no entrega: se avisan, con el comando para cobrarlas.
  nota_leer() {
    local c r ids=()
    for c in "$d"/*.listo; do [[ -f "$c" && -f "${c%.listo}.leer" ]] && ids+=("$(basename "${c%.listo}") (terminada)"); done
    for r in "$STATE/$slug".leer-*.running; do
      [[ -f "$r" ]] && vivo "$r" && ids+=("$(leer_campo "$r" id) (corriendo)")
    done
    (( ${#ids[@]} )) || return 0
    echo "pa: '$slug' tiene ${#ids[@]} corrida(s) --leer que \`--esperar\` sin --id no entrega (es del que escribe):" >&2
    for r in "${ids[@]}"; do echo "    pa --esperar '$proy' --id ${r%% *}   # ${r#* }" >&2; done
  }
  # Viva = su `$ts.pid` (async: en cola o corriendo) vive, o hay un `.running` vivo con ese id
  # (primer plano, o un pa de antes de los puestos).
  corrida_viva() {   # $1 = ts
    local p r
    if [[ -f "$d/$1.pid" ]]; then p="$(cat "$d/$1.pid" 2>/dev/null)"; [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null && return 0; fi
    for r in "$STATE/$slug.running" "$STATE/$slug"@*.running "$STATE/$slug".leer-*.running; do
      [[ -f "$r" && "$(leer_campo "$r" id)" == "$1" ]] && vivo "$r" && return 0
    done
    return 1
  }
  # Writers de MI jefe que siguen vivos (corriendo o en cola). Es lo que el pelado espera.
  hay_writers_mios() {
    local r t p
    for r in "$STATE/$slug.running" "$STATE/$slug"@*.running; do
      [[ -f "$r" ]] && vivo "$r" || continue
      t="$(leer_campo "$r" id)"
      if [[ -n "$yo" ]]; then
        local j; j="$(leer_campo "$r" jefe_id)"; [[ -z "$j" ]] && j="$(jefe_de "$t")"
        [[ -z "$j" || "$j" == "$yo" ]] || continue
      fi
      return 0
    done
    for p in "$d"/*.pid; do
      [[ -f "$p" ]] || continue
      t="$(basename "$p" .pid)"
      [[ -f "$d/$t.leer" || -f "$d/$t.listo" || -f "$d/$t.entregado" ]] && continue
      kill -0 "$(cat "$p" 2>/dev/null)" 2>/dev/null || continue
      es_mia "$t" || continue
      return 0
    done
    return 1
  }

  local fin=0
  (( timeout > 0 )) && fin=$(( $(date +%s) + timeout ))
  if [[ -n "$id" ]]; then
    while true; do
      pendiente && { entregar; return $?; }
      if ! corrida_viva "$id"; then
        sleep 0.2
        pendiente && { entregar; return $?; }   # alcanzó a terminar entre el chequeo y acá
        # Terminó y otra espera se llevó el .listo mientras ésta esperaba: sin esto caía en
        # "murió corriendo sin dejar resultado" (82) con la corrida terminada en rc 0.
        [[ -f "$d/$id.entregado" ]] && ya_entregada "$id"
        if [[ -f "$d/$id.pid" ]]; then
          if [[ -f "$d/$id.leer" ]]; then
            echo "pa: la corrida --leer $id de '$slug' murió sin dejar resultado (el proceso ya no vive). Mirá $d/$id.log." >&2
          elif [[ -f "$d/$id.puesto" || -f "$d/$id.corrida" ]]; then
            echo "pa: la corrida $id de '$slug' murió corriendo (ya había tomado puesto) sin dejar resultado. Mirá $d/$id.log." >&2
          else
            echo "pa: la corrida $id de '$slug' murió en cola (el proceso ya no vive) sin dejar resultado. Mirá $d/$id.log." >&2
          fi
          exit 82
        fi
        # sin .pid: corrió en primer plano (su resultado salió por stdout, no deja .listo)
        echo "pa: la corrida $id de '$slug' no dejó resultado para entregar (¿corrió en primer plano? mirá $d/$id.json)." >&2
        exit 1
      fi
      (( fin > 0 && $(date +%s) >= fin )) && { echo "pa: la corrida $id de '$slug' sigue trabajando después de ${timeout}s." >&2; exit 75; }
      sleep 0.5
    done
  fi
  while true; do
    pendiente && { entregar; return $?; }
    if ! hay_writers_mios; then
      sleep 0.5; pendiente && { entregar; return $?; }
      echo "pa: nada pendiente en '$slug': ni worker tuyo corriendo ni resultado tuyo sin entregar." >&2
      aviso_vencidos
      nota_leer
      exit 1
    fi
    (( fin > 0 && $(date +%s) >= fin )) && { echo "pa: '$slug' sigue trabajando después de ${timeout}s." >&2; exit 75; }
    sleep 0.5
  done
}

# El pid del .running es el del proceso que lanzó pa, y desde el 2026-09-23 ese NO es el claude
# que labura: `~/.local/bin/claude` pasó a ser un launcher bash que corre `claude.exe` como HIJO
# (sin exec). Un TERM al launcher lo baja a él y el claude.exe queda huérfano, colgado de init,
# trabajando: `pa miapp --matar` dijo "matado (claude 3903527)" y el 3903529 siguió 5 minutos
# en paralelo con el worker siguiente, sobre el mismo tree. El process group no alcanza: claude
# corre cada comando de Bash en su propia sesión (setsid), así que el `cargo test` de un worker
# no está en el grupo de nadie. Por eso: árbol (pgrep -P) ANTES de mandar ninguna señal, y
# después se busca por el sid, que agarra también al que ya había quedado huérfano.
arbol() {   # los pids dados y todos sus descendientes, los padres primero
  local cola=("$@") p h
  while (( ${#cola[@]} )); do
    p="${cola[0]}"; cola=("${cola[@]:1}")
    [[ -n "$p" ]] || continue
    echo "$p"
    for h in $(pgrep -P "$p" 2>/dev/null); do cola+=("$h"); done
  done
}
# Los procesos de claude de UNA conversación, estén colgados de quien estén. Por flag y no por
# el sid pelado: un `tail -f` del transcript (`workers ver`) lleva el sid en la ruta. Y sólo
# los que corren con -p/--print: un `claude --resume <sid>` INTERACTIVO que el dueño abrió sobre
# la misma conversación no es el worker y no se toca (decisión del dueño, 2026-09-23). Se mira
# argumento por argumento en /proc/<pid>/cmdline, no con regex sobre la línea entera: la tarea
# viaja en el argv y puede contener " -p ".
pids_del_sid() {
  [[ -n "${1:-}" ]] || return 0
  local p a
  for p in $(pgrep -f -- "(--session-id|--resume) $1( |\$)" 2>/dev/null); do
    while IFS= read -r -d '' a; do
      [[ "$a" == -p || "$a" == --print ]] && { echo "$p"; break; }
    done <"/proc/$p/cmdline" 2>/dev/null || true
  done
  return 0
}
# Un zombie contesta `kill -0`: el launcher muerto que su padre todavía no recogió no es un vivo.
vive() { local s; s="$(ps -o stat= -p "$1" 2>/dev/null)"; [[ -n "$s" && "$s" != Z* ]]; }
vivos_de() { local p; for p in "$@"; do vive "$p" && echo "$p"; done; return 0; }

# matar_arbol <sid> <paciente> <pid>...  TERM a todo el árbol de los pids (más lo que lleve el
# sid), KILL a los 5 s. <paciente> (puede ir vacío) es el `pa`: tiene 3 s más antes del KILL
# porque su trap de EXIT es el que deja el .ultimo, y sin él `pa --esperar` devuelve el
# resultado de la corrida anterior. Sale 0 sólo si no quedó NADIE; los que quedan, a stdout.
matar_arbol() {
  local sid="$1" paciente="$2"; shift 2
  local pids=() p i
  mapfile -t pids < <(arbol "$@"; pids_del_sid "$sid")
  (( ${#pids[@]} )) || return 0
  kill -TERM "${pids[@]}" 2>/dev/null || true
  kill -CONT "${pids[@]}" 2>/dev/null || true   # uno parado (T) no atiende el TERM
  # Lo que alcanzó a nacer entre el pgrep y el TERM. Sólo a los NUEVOS: un segundo TERM al pa
  # lo mataba sin su trap de EXIT (sin .ultimo, justo el agujero que el trap existe para tapar).
  local nuevos=() ya=" ${pids[*]} "
  for p in $(arbol $(vivos_de "${pids[@]}"); pids_del_sid "$sid"); do
    [[ "$ya" == *" $p "* ]] || { nuevos+=("$p"); ya+="$p "; }
  done
  if (( ${#nuevos[@]} )); then
    kill -TERM "${nuevos[@]}" 2>/dev/null || true
    pids+=("${nuevos[@]}")
  fi
  local otros=()
  for p in "${pids[@]}"; do [[ "$p" == "$paciente" ]] || otros+=("$p"); done
  for (( i = 0; i < 50; i++ )); do
    [[ -z "$(vivos_de "${otros[@]}")" ]] && break
    sleep 0.1
  done
  for p in $(vivos_de "${otros[@]}"); do kill -KILL "$p" 2>/dev/null || true; done
  if [[ -n "$paciente" ]]; then
    for (( i = 0; i < 30; i++ )); do vive "$paciente" || break; sleep 0.1; done
    vive "$paciente" && kill -KILL "$paciente" 2>/dev/null || true
  fi
  # verificación: por pid y por sid, que es lo que el caso del 2026-09-23 no miraba
  for (( i = 0; i < 10; i++ )); do
    [[ -z "$(vivos_de "${pids[@]}" $(pids_del_sid "$sid"))" ]] && return 0
    sleep 0.1
  done
  vivos_de $(printf '%s\n' "${pids[@]}" $(pids_del_sid "$sid") | sort -un)
  return 1
}

# Baja UNA corrida: la que describe ese `.running`. Sale 0 si no quedó nadie, 85 si sí.
matar_run() {   # $1 = ruta del .running
  local run="$1" slug pid pa_pid sid quedan
  slug="$(leer_campo "$run" proyecto)"
  pid="$(leer_campo "$run" pid)"; pa_pid="$(leer_campo "$run" pa_pid)"; sid="$(leer_campo "$run" sid)"
  local que="worker"; [[ "$(leer_campo "$run" leer)" == 1 ]] && que="worker --leer $(leer_campo "$run" id)"
  # El pa va primero en la lista (padres primero): si matás sólo al claude, el wrapper viejo
  # interpretaba la muerte como "no pude retomar la sesión" y relanzaba uno nuevo solo. Este pa
  # ya no relanza (el trap sale con 130), pero matar al padre primero igual evita la carrera.
  if quedan="$(matar_arbol "$sid" "$pa_pid" "$pa_pid" "$pid")"; then
    anotar_fin "$STATE/$slug" "$(leer_campo "$run" id)"
    rm -f "$run" "${run%.running}.heartbeat" "${run%.running}.heartbeat.turnos"
    echo "pa: $que de '$slug' matado (claude $pid y su árbol)."
    return 0
  fi
  # El .running se queda: el worker sigue ahí, y `workers` tiene que poder mostrarlo.
  echo "pa: NO pude bajar el $que de '$slug': siguen vivos $(echo $quedan) — mirá con: ps -o pid,stat,args -p $(echo $quedan | tr ' ' ,)" >&2
  return 85
}

# `--matar` a secas baja al worker que ESCRIBE y no toca a los --leer: hay varios por proyecto,
# no son "el" worker, y matar una consulta de lectura por accidente al querer parar un refactor
# sería un susto. Con puestos puede haber varios que escriben: si hay uno solo vivo, es ése; si
# hay varios, el único de TU jefe (jefe_id); si no se puede decidir, sale 2 con los ids.
# `--matar --leer` baja todos los --leer vivos del proyecto; `--matar --id <corrida>` baja esa
# (sea --leer o la que escribe).
cmd_matar() {
  local slug="$1" f rc=0 r vivos_leer=() writers=() writers_vivos=() mios=() yo
  shopt -s nullglob
  local todos_leer=("$STATE/$slug".leer-*.running)
  for f in "${todos_leer[@]}"; do vivo "$f" && vivos_leer+=("$f"); done
  for f in "$STATE/$slug.running" "$STATE/$slug"@*.running; do
    [[ -f "$f" ]] || continue
    writers+=("$f"); vivo "$f" && writers_vivos+=("$f")
  done
  local objetivos=()
  if [[ -n "$run_id" ]]; then
    [[ -f "$STATE/$slug.leer-$run_id.running" ]] && objetivos+=("$STATE/$slug.leer-$run_id.running")
    for f in "${writers[@]}"; do [[ "$(leer_campo "$f" id)" == "$run_id" ]] && objetivos+=("$f"); done
    (( ${#objetivos[@]} )) || { echo "pa: no hay ninguna corrida viva '$run_id' en '$slug'." >&2; exit 1; }
  elif (( leer )); then
    objetivos=("${todos_leer[@]}")
    (( ${#objetivos[@]} )) || { echo "pa: no hay --leer corriendo en '$slug'." >&2; exit 1; }
  else
    if (( ${#writers[@]} == 0 )); then
      if (( ${#vivos_leer[@]} )); then
        echo "pa: no hay worker que escriba corriendo en '$slug', pero hay ${#vivos_leer[@]} --leer vivo(s):" >&2
        for f in "${vivos_leer[@]}"; do echo "    id $(leer_campo "$f" id)" >&2; done
        echo "pa: \`--matar\` a secas no las toca. Bajalas con: pa '$slug' --matar --leer  (todas)  o  pa '$slug' --matar --id <id>." >&2
      else
        echo "pa: no hay worker corriendo en '$slug'." >&2
      fi
      exit 1
    fi
    if (( ${#writers_vivos[@]} <= 1 )); then
      # uno vivo (o ninguno: .running colgados de un pa matado con -9, que matar_run limpia)
      if (( ${#writers_vivos[@]} == 1 )); then objetivos=("${writers_vivos[@]}"); else objetivos=("${writers[@]}"); fi
    else
      yo="$(jefe_id)"
      if [[ -n "$yo" ]]; then
        for f in "${writers_vivos[@]}"; do [[ "$(leer_campo "$f" jefe_id)" == "$yo" ]] && mios+=("$f"); done
      fi
      if (( ${#mios[@]} == 1 )); then
        objetivos=("${mios[@]}")
      else
        echo "pa: hay ${#writers_vivos[@]} workers escribiendo en '$slug'$( (( ${#mios[@]} )) && echo " (${#mios[@]} tuyos)"); decime cuál con --id:" >&2
        for f in "${writers_vivos[@]}"; do
          printf '    pa %q --matar --id %s   # puesto %s · jefe %s · %.70s\n' "$slug" "$(leer_campo "$f" id)" \
            "$(leer_campo "$f" puesto)" "$(leer_campo "$f" jefe)" "$(leer_campo "$f" tarea)" >&2
        done
        exit 2
      fi
    fi
  fi
  for r in "${objetivos[@]}"; do
    matar_run "$r" || rc=$?
  done
  return "$rc"
}

# Cuántas veces compactó el worker. Es la señal de "la tarea no entraba en una corrida", y es
# mejor que los turnos: `pa` lanza con --autocompact 180000 (para no pagar el long-context
# premium), así que una compactación significa que el worker quemó 180k de contexto. La corrida
# de widgets-reactivos del 2026-09-13 compactó DOS veces en 61 turnos, y después de compactar
# perdió el rastro de qué archivos sucios eran suyos. El dato estaba en el transcript y nadie
# lo miraba.
contar_compactaciones() {   # $1 = jsonl del worker
  [[ -n "${1:-}" && -f "$1" ]] || return 0
  grep -c '"subtype":"compact_boundary"' "$1" 2>/dev/null || true
}

# El transcript del jsonl a partir del session_id del run. `cmd_esperar` entrega resultados de
# corridas que no lanzó él y no tiene la variable $transcript a mano, así que se resuelve sola.
transcript_de() {   # $1 = json de salida
  local sid f
  sid="$(jq -r '.session_id // empty' "$1" 2>/dev/null)" || return 0
  [[ -n "$sid" ]] || return 0
  for f in "$PROJ"/*/"$sid.jsonl"; do [[ -f "$f" ]] && { printf '%s' "$f"; return; }; done
}

# --seguir sobre una sesión que ya compactó. Retomar arranca con el contexto casi lleno: el
# 2026-09-14 un `--seguir --id` para borrar UNA sección de un .md volvió con 7 turnos, US$0,74 y
# 5 compactaciones (la corrida original había durado 31 min y ya había compactado). Imprime
# "<compactaciones> <terminada 0|1>" si la sesión a retomar compactó; nada si no.
# "terminada" = la última corrida de esa conversación salió bien con su RESULTADO. Si no (78, sin
# turnos, murió), el --seguir es un CIERRE, y ahí retomar es justo lo barato: no se frena.
seguir_compactada() {
  local sid="" f comp=0 ultima="" terminada=0
  if [[ -n "$run_id" ]]; then sid="$(cat "$dir/$run_id.sid" 2>/dev/null || true)"
  else sid="$(cat "$sfile" 2>/dev/null || true)"; fi
  [[ -n "$sid" ]] || return 0
  for f in "$PROJ"/*/"$sid.jsonl"; do [[ -f "$f" ]] && { comp="$(contar_compactaciones "$f")"; break; }; done
  [[ "$comp" =~ ^[0-9]+$ ]] && (( comp > 0 )) || return 0
  # `--resume` conserva el session_id (medido: 46 de 46), así que todas las corridas de la
  # conversación tienen el mismo <ts>.sid; la última por ts es la que dice cómo quedó.
  for f in "$dir"/*.sid; do [[ -f "$f" && "$(cat "$f")" == "$sid" ]] && ultima="${f%.sid}"; done
  if [[ -n "$ultima" && -f "$ultima.json" ]] \
     && [[ "$(jq -r '"\(.subtype // "")|\(.is_error // false)"' "$ultima.json" 2>/dev/null)" == "success|false" ]] \
     && jq -r '.result // ""' "$ultima.json" 2>/dev/null | grep 'RESULTADO:' >/dev/null; then
    terminada=1
  fi
  printf '%s %s\n' "$comp" "$terminada"
}

# Minutos desde el último uso de una sesión guardada: el mtime de su transcript (se escribe en cada
# turno; vive bajo la carpeta de proyecto del worktree donde corrió, de ahí el glob) y, sin transcript,
# el del archivo que guarda su id ($2: `<slug>.session` o `<ts>.sid`, se toca al terminar la corrida).
# Vacío si no hay ninguno de los dos.
sesion_edad_min() {
  local sid="$1" f m mejor=""
  for f in "$PROJ"/*/"$sid.jsonl"; do
    [[ -f "$f" ]] || continue
    m="$(stat -L -c %Y "$f" 2>/dev/null)" || continue
    [[ -z "$mejor" || "$m" -gt "$mejor" ]] && mejor="$m"
  done
  [[ -n "$mejor" ]] || mejor="$(stat -c %Y "$2" 2>/dev/null)" || return 0
  echo $(( ( $(date +%s) - mejor ) / 60 ))
}

# Un auto-update dejó `@anthropic-ai/claude-code` sin el binario nativo (2026-09-14, 00:33) y
# todo `pa` salía 1, "el worker falló", con un mensaje de npm que se leía como un problema del
# proyecto. Código propio (81) y el arreglo escrito.
CLAUDE_ARREGLO='node ~/.local/lib/node_modules/@anthropic-ai/claude-code/install.cjs'
claude_err=""
# 2026-09-23: shark.service (systemd user, PATH sin ~/.local/bin) llamó a pa, `claude` no
# resolvía, y el mensaje de "instalación ROTA" llevó al asistente a ofrecerle al dueño reinstalar
# algo que estaba sano. Si `claude` no resuelve pero el binario conocido existe, no está roto:
# falta en el PATH de quien nos llamó. Código propio (84), porque el arreglo es otro.
CLAUDE_CONOCIDO="${CLAUDE_CONOCIDO:-$HOME/.local/bin/claude}"
claude_fuera_de_path() { ! command -v claude >/dev/null 2>&1 && [[ -x "$CLAUDE_CONOCIDO" ]]; }
claude_rc() { if claude_fuera_de_path; then echo 84; else echo 81; fi; }
claude_sano() { claude_err="$(timeout 30 claude --version 2>&1 </dev/null)"; }
es_claude_roto() {   # $1 = texto de error
  [[ "$1" == *"native binary not installed"* || "$1" == *"claude: not found"* || "$1" == *"claude: No such file"* \
     || "$1" == *"failed to run command 'claude'"* ]]
}
claude_falla() {   # $1 = rc (81 | 84), $2 = el error que dio claude (puede ir vacío)
  if [[ "$1" == 84 ]]; then claude_fuera_del_path; else claude_roto "${2:-}"; fi
}
claude_fuera_del_path() {
  echo "pa: claude no está en el PATH de este proceso (PATH=$PATH). No está roto: existe en $CLAUDE_CONOCIDO." >&2
  echo "pa: agregá $(dirname "$CLAUDE_CONOCIDO") al PATH del servicio/timer/cron que llama a pa. NO hace falta reinstalar claude." >&2
}
claude_roto() {   # $1 = el error que dio claude (puede ir vacío)
  echo "pa: la instalación de claude está ROTA. No es un fallo del worker ni del proyecto." >&2
  [[ -n "${1:-}" ]] && printf '%s\n' "$1" | grep . | sed -n '1,6s/^/    /p' >&2
  echo "pa: si fue un auto-update (\"native binary not installed\"), se arregla con:" >&2
  echo "    $CLAUDE_ARREGLO" >&2
  echo "pa: no relances workers hasta que \`claude --version\` ande." >&2
}

# --- medición: una línea TSV por corrida en $STATE/medicion.tsv ------------------------------
# Para calibrar la política de modelos (2026-09-30) con datos y no con impresiones: qué modelo y
# effort, cuánto costó, y una columna `bien` vacía que completa el jefe a mano. La escribe el trap
# de EXIT (cualquier camino de salida después de lanzar), y NUNCA puede romper a pa: un JSON que
# falta o no parsea deja los números vacíos, y cualquier error de acá se traga.
MEDICION="$STATE/medicion.tsv"
MEDICION_HEADER_VIEJO=$'fecha\tid\tproyecto\tmodelo\teffort\tleer\tseguir\tis_error\tnum_turns\tduration_s\ttokens\tcosto_usd\tbien'
# plan, compactaciones y autocompact (2026-10-02): para cruzar en el dashboard del dueño si
# compactar antes ahorra. Van AL FINAL: las columnas viejas no se movieron, y un archivo con el
# header viejo se actualiza solo (las filas viejas quedan con esas tres vacías).
# origen (quién lanzó: jefe, app…; PA_ORIGEN) y la caché (2026-10-03): cache_read y cache_creation
# de .modelUsage, y cuánto de lo creado fue con TTL de 1h o de 5m (.usage.cache_creation). Al final,
# por lo mismo; cualquier header que sea un prefijo de éste se actualiza solo.
# tipo, integrada y retrabajo (2026-10-10): rendimiento por tipo de tarea (`pa --rinde`). `tipo` lo
# pone `--tipo`/PA_TIPO al lanzar; `integrada` y `retrabajo` nacen vacías y las llena `--bien-auto`.
# Al final, por lo mismo. Quien lee este archivo va por NOMBRE de columna (o usa sólo las 13 viejas)
# y tolera filas más cortas que el header: las de antes no se reescriben.
MEDICION_HEADER="$MEDICION_HEADER_VIEJO"$'\tplan\tcompactaciones\tautocompact\torigen\tcache_read\tcache_creation\tephemeral_1h\tephemeral_5m\ttipo\tintegrada\tretrabajo\tcuenta'
TIPOS_VALIDOS="mecanico|lectura|codigo-acotado|codigo-multi|frontend|diseno|debug|final"
# Un header que es un prefijo del de hoy se actualiza solo. Se llama CON el flock 7 tomado, y
# reescribe sobre el MISMO inodo (cat >, no sed -i ni mv): el fd 7 del flock apunta a este archivo,
# y con un archivo nuevo la fila que sigue se escribía en el viejo, ya borrado.
# --- workers por agy (Antigravity CLI: Gemini y Claude/GPT de Google AI Pro) ------------------
# `pa <proy> -m gemini-…` o `-m agy:…` lanza `agy -p` en vez de claude (con --model sin el prefijo
# `agy:`). El effort va en el nombre. Sin `-m`, `reparto` elige según calidad y cupo de cada grupo.
REPARTO="${PA_REPARTO:-$_BIN/reparto}"
[[ "$REPARTO" == 0 ]] && REPARTO="$_BIN/reparto"   # PA_REPARTO=0 apaga la elección automática, no el comando
GEMINI_MODELOS='gemini-4-argon-(low|medium|high)|gemini-3\.8-flash-(low|medium|high)|agy:(claude-(opus|sonnet)-5-5-(low|medium|high)|gpt-oss-120b-medium)'
GEMINI_CUPO_MAX="${PA_GEMINI_CUPO_MAX:-70}"
es_gemini() { [[ "${1,,}" == gemini* || "${1,,}" == agy:* ]]; }
gemini_equivalente() {   # $1 = modelo de agy -> "modelo effort" del Claude oficial
  case "$1" in
    gemini-4-argon-high)     echo "claude-opus-5-5 medium" ;;
    gemini-4-argon-medium)   echo "claude-sonnet-5-5 high" ;;
    gemini-4-argon-low)      echo "claude-sonnet-5-5 medium" ;;
    gemini-3.8-flash-high)   echo "claude-haiku-5-5 xhigh" ;;
    gemini-3.8-flash-medium) echo "claude-haiku-5-5 high" ;;
    gemini-3.8-flash-low)    echo "claude-haiku-5-5 medium" ;;
    agy:claude-opus-5-5-*)   echo "claude-opus-5-5 ${1##*-}" ;;
    agy:claude-sonnet-5-5-*) echo "claude-sonnet-5-5 ${1##*-}" ;;
    agy:gpt-oss-120b-*)      echo "claude-sonnet-5-5 medium" ;;
  esac
}
agy_cupo_json() { timeout "${PA_AGY_CHEQUEO_S:-40}" "${cuenta_env[@]}" agy -p /quota --output-format json </dev/null 2>/dev/null; }
agy_hooks_json() { timeout "${PA_AGY_CHEQUEO_S:-40}" "${cuenta_env[@]}" agy -p /hooks --output-format json </dev/null 2>/dev/null; }
# --- varias cuentas por proveedor (docs/cuentas-varias-por-proveedor.md) -------------------------
# Cada cuenta (bin/cuentas, ~/.config/trama/cuentas.json) tiene su carpeta de credenciales. El worker
# corre con el entorno de SU cuenta sólo en su proceso (`env -u … CLAUDE_CONFIG_DIR=…`, o HOME para agy)
# y nunca con ANTHROPIC_API_KEY: el entorno lo arma `cuentas env`. La cuenta de siempre tiene el id del
# proveedor (claude, google) y no toca el entorno: sin cuentas.json todo es como antes.
CUENTAS="${PA_CUENTAS_BIN:-$_BIN/cuentas}"
CUENTAS_JSON="${TRAMA_CUENTAS:-${TRAMA_CUENTAS_HOME:-$HOME}/.config/trama/cuentas.json}"
cuenta="" cuenta_flag="" cuenta_seguir="" cuenta_env=()
proveedor_de_modelo() { if es_local "$1" || es_codex "$1"; then echo ""; elif es_gemini "$1"; then echo google; else echo claude; fi; }
cuenta_proveedor() {   # $1 = id de cuenta -> su proveedor (nada si no existe)
  case "$1" in claude|google|chatgpt) echo "$1"; return ;; esac
  [[ -f "$CUENTAS_JSON" ]] && jq -r --arg i "$1" 'first(.cuentas[]? | select(.id == $i) | .proveedor) // empty' "$CUENTAS_JSON" 2>/dev/null
}
cuenta_preparar() {   # $1 = id, $2 = proveedor del modelo -> cuenta y cuenta_env; 1 (con aviso) si no va
  local id="$1" prov="$2" j p
  cuenta_env=()
  case "$id" in
    claude|google|chatgpt)
      [[ "$id" == "$prov" ]] || { echo "pa: la cuenta '$id' es de $id y el modelo '$modelo' es de $prov." >&2; return 1; }
      cuenta="$id"; return 0 ;;
  esac
  j="$("$CUENTAS" env "$id" --json 2>&1 </dev/null)" || { echo "pa: ${j:-no pude leer la cuenta $id}" >&2; return 1; }
  p="$(jq -r '.proveedor // ""' <<<"$j" 2>/dev/null)"
  [[ "$p" == "$prov" ]] || { echo "pa: la cuenta '$id' es de ${p:-?} y el modelo '$modelo' es de $prov." >&2; return 1; }
  cuenta="$id"
  mapfile -t cuenta_env < <(jq -r '(.sacar // [] | map("-u", .)) + (.poner // {} | to_entries | map("\(.key)=\(.value)"))
    | if length > 0 then ["env"] + . else . end | .[]' <<<"$j" 2>/dev/null)
  return 0
}
cuenta_elegir() {   # $1 = proveedor -> la cuenta con más cupo libre (la de siempre si es la única)
  local prov="$1" c=""
  [[ -f "$CUENTAS_JSON" ]] && jq -e --arg p "$prov" 'any(.cuentas[]?; .proveedor == $p and .id != $p)' "$CUENTAS_JSON" >/dev/null 2>&1 \
    || { echo "$prov"; return 0; }
  # La que eligió reparto junto con el modelo (si sigue siendo de este proveedor: agy pudo caer a Claude).
  (( vino_de_reparto )) && c="$(jq -r '.cuenta // ""' <<<"${rep_json:-}" 2>/dev/null || true)"
  [[ -n "$c" && "$(cuenta_proveedor "$c")" == "$prov" ]] || c=""
  if [[ -z "$c" && -x "$REPARTO" ]]; then
    c="$(REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" \
      timeout "${PA_REPARTO_TIMEOUT_S:-15}" "$REPARTO" --cuenta-para "$modelo" 2>/dev/null </dev/null)" || c=""
  fi
  echo "${c:-$prov}"
}
cuenta_resolver() {   # $1 = proveedor del modelo. --cuenta que no va: sale 2
  local prov="$1" c="$cuenta_flag"
  if [[ -z "$prov" ]]; then
    [[ -n "$c" ]] && { echo "pa: --cuenta no va con '$modelo': un modelo local no usa ninguna suscripción." >&2; exit 2; }
    cuenta=""; cuenta_env=(); return 0
  fi
  if [[ -n "$c" ]]; then cuenta_preparar "$c" "$prov" || exit 2; return 0; fi
  # --seguir: la misma cuenta que la retomada, si es del mismo proveedor y sigue existiendo.
  if [[ -n "$cuenta_seguir" && "$(cuenta_proveedor "$cuenta_seguir")" == "$prov" ]] && cuenta_preparar "$cuenta_seguir" "$prov" 2>/dev/null; then
    return 0
  fi
  c="$(cuenta_elegir "$prov")"
  cuenta_preparar "$c" "$prov" || cuenta_preparar "$prov" "$prov"
}
# Los grupos de /quota: "Gemini Models" (Flash: 5 h y semanal), "Claude and GPT models" (5 h y semanal)
# y "Gemini 4 Argon" (semanal).
cupo_grupo() {   # $1 = json de /quota, $2 = modelo -> el grupo de ese modelo (una línea de json), o nada
  jq -c --arg m "$2" '.command.data.groups[]? |
    if ($m | startswith("gemini-4-argon")) then select(.name | test("argon"; "i"))
    elif ($m | startswith("agy:")) then select(.name | test("claude|gpt"; "i"))
    else select((.name | test("argon|claude|gpt"; "i") | not) and ((.description // "") | test("flash"; "i"))) end' <<<"$1" 2>/dev/null
}
cupo_usado() {   # $1 = json de /quota, $2 = modelo -> % usado (entero), o nada si no se sabe
  cupo_grupo "$1" "$2" | jq -rs '[.[].buckets[]? | .remaining_fraction | numbers] |
    if length == 0 then empty else ((1 - min) * 100 | floor) end' 2>/dev/null
}
plugin_cargado() {   # $1 = json de /hooks -> 0 si el hook pa-worker está cargado y habilitado
  jq -e '[.command.data.hooks[]? | select(.name == "pa-worker" and .enabled != false)
          | .actions[]? | select(.event == "PreToolUse")] | length > 0' <<<"$1" >/dev/null 2>&1
}
cmd_cupo_gemini() {
  [[ -x "$REPARTO" ]] || { echo "pa: no encuentro $REPARTO." >&2; return 1; }
  REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" "$REPARTO" --cupos "$@"
}

# --- privacidad de los workers Gemini (docs/gemini-workers-agy.md) ----------------
# Gemini (y cualquier modelo por agy) corre en CUALQUIER proyecto (el dueño, 2026-10-23: tiene apagado en
# agy compartir datos para mejorar el producto): no hay lista de proyectos prohibidos ni excluidos.
# Quedan dos candados ANTES de lanzar agy, por contenido y no por proyecto; si alguno salta, pa cae al
# equivalente Claude con una línea (el mismo camino que el cupo): un pedido con pinta de secreto y un
# repo que trackea archivos de secretos. Un tercero vive en hooks/agy-pa.sh (lectura fuera del
# worktree y red).
# El pedido con pinta de secreto -> qué encontró (vacío si nada). Conservador: un falso positivo
# sólo manda la corrida a Claude.
gemini_secreto_en() {   # $1 = texto
  local t="$1" tok
  grep -qE '(^|[^A-Za-z0-9])sk-[A-Za-z0-9_-]{4,}|gh[pousr]_[A-Za-z0-9]{6,}|github_pat_[A-Za-z0-9_]{6,}|AIza[0-9A-Za-z_-]{8,}|xox[abprs]-[A-Za-z0-9-]{4,}|AKIA[0-9A-Z]{12,}' <<<"$t" && { echo "una clave de API"; return; }
  grep -qE -- '-----BEGIN' <<<"$t" && { echo "una clave privada (-----BEGIN)"; return; }
  grep -qE '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}' <<<"$t" && { echo "un mail"; return; }
  grep -qE '(^|[^0-9])(\+[0-9]{1,3}[ -]?[0-9]{2,4}[ -]?[0-9]{3,4}[ -]?[0-9]{3,4}|\(?0?[0-9]{2,4}\)?[ -][0-9]{3,4}[ -][0-9]{4})([^0-9]|$)' <<<"$t" && { echo "un teléfono"; return; }
  while IFS= read -r tok; do
    [[ "$tok" =~ [0-9] && "$tok" =~ [A-Za-z] ]] && { echo "un token largo"; return; }
  done < <(grep -oE '[A-Za-z0-9_+=]{32,}' <<<"$t")
  return 0
}
# Archivos de secretos trackeados (HEAD del tree: de ahí sale el worktree) -> el primero, o nada.
gemini_secreto_trackeado() {   # $1 = ruta del repo
  local f b
  while IFS= read -r f; do
    b="${f##*/}"
    case "$b" in
      *.example|*.sample|*.template|*.dist|*.pub) continue ;;
      .env|.env.*|*.pem|*.key|*.p12|*.pfx|*.kdbx|*.keystore|.netrc|id_rsa*|id_dsa*|id_ecdsa*|id_ed25519*|credentials*|secrets*) echo "$f"; return ;;
      id_*) [[ "$b" != *.* ]] && { echo "$f"; return; } ;;
    esac
  done < <(git -C "$1" ls-tree -r --name-only HEAD 2>/dev/null)
  return 0
}
# Los candados de contenido juntos -> motivo de la caída a Claude (vacío = Gemini puede ir).
gemini_privacidad() {   # $1 = ruta real, $2 = tarea
  local m
  m="$(gemini_secreto_en "$2")"
  [[ -n "$m" ]] && { echo "el pedido parece traer $m (no se manda a Google)"; return; }
  m="$(gemini_secreto_trackeado "$1")"
  [[ -n "$m" ]] && { echo "el repo trackea un archivo de secretos ($m)"; return; }
  return 0
}
# Ya no hay lista de proyectos para Gemini: --marcar/--desmarcar quedan de alias que avisa y sale 0.
cmd_gemini_proyectos() {   # [--marcar X | --desmarcar X]
  case "${1:-}" in
    "") echo "Gemini: habilitado en todos los proyectos." ;;
    --marcar|--desmarcar) echo "pa: $1 ya no hace nada: Gemini corre en todos los proyectos (sin lista de prohibidos ni excluidos)." ;;
    *) echo "uso: pa --gemini-proyectos" >&2; return 2 ;;
  esac
}
# Los candados de contenido y el cupo de un Gemini antes de lanzar -> motivo_cae (vacío = va) y clase_cae: `cupo`
# (se arregla esperando: cupo alto o ilegible) o `fijo` (privacidad, agy o el plugin: esperar no sirve).
# Usa proyecto y tarea.
gemini_chequear() {   # $1 = modelo de agy (gemini-* o agy:*)
  local ruta_g
  motivo_cae=""; clase_cae=fijo
  # Privacidad primero (secretos en el pedido o en el repo): no gasta ni los 6 s del chequeo.
  ruta_g="$(proyecto-ruta "$proyecto" 2>/dev/null || true)"
  [[ -n "$ruta_g" ]] && motivo_cae="$(gemini_privacidad "$(realpath -m "$ruta_g")" "$tarea")"
  [[ -n "$motivo_cae" ]] && return 0
  if ! command -v agy >/dev/null 2>&1; then motivo_cae="agy no está en el PATH"; return 0; fi
  if ! plugin_cargado "$(agy_hooks_json)"; then
    motivo_cae="el plugin pa-worker de agy no está cargado (sin él no hay guardias: correr scripts/instalar.sh del orquestador)"
  fi
  return 0
}
gemini_esperar=0

# --- workers por codex (Codex CLI: ChatGPT) — docs/codex-workers.md --------------------------
# `pa <proy> -m codex:<modelo>-<effort>` lanza `codex exec --json` en vez de claude. El effort va en el
# nombre (model_reasoning_effort). Mismos candados de privacidad que agy (gemini_privacidad); codex no
# tiene hooks: las guardias de git y cargo son los shims de codex/bin, primeros en el PATH, y el
# sandbox de codex (workspace-write: escribe sólo en el worktree y el .git común, sin red).
CODEX_MODELOS='codex:(gpt-6\.1-sol|gpt-6-sol|gpt-6-luna|gpt-6-astra)-(low|medium|high)'
CODEX_SHIMS="${PA_CODEX_SHIMS:-$(dirname "$_BIN")/codex/bin}"
es_codex() { [[ "${1,,}" == codex:* ]]; }
codex_equivalente() {   # $1 = modelo de codex -> "modelo effort" del Claude oficial
  local e="${1##*-}"
  case "$1" in
    codex:gpt-6-astra-*) echo "claude-opus-5-5 $e" ;;
    codex:gpt-6-luna-*)  case "$e" in low) echo "claude-haiku-5-5 medium" ;; medium) echo "claude-haiku-5-5 high" ;; *) echo "claude-haiku-5-5 xhigh" ;; esac ;;
    codex:*)             echo "claude-sonnet-5-5 $e" ;;
  esac
}
# Privacidad, codex en el PATH y sesión iniciada -> motivo_cae (vacío = va) y clase_cae (siempre fijo:
# el cupo lo mira reparto, esperar no arregla nada de esto).
codex_chequear() {   # $1 = modelo de codex
  local ruta_c
  motivo_cae=""; clase_cae=fijo
  ruta_c="$(proyecto-ruta "$proyecto" 2>/dev/null || true)"
  [[ -n "$ruta_c" ]] && motivo_cae="$(gemini_privacidad "$(realpath -m "$ruta_c")" "$tarea")"
  [[ -n "$motivo_cae" ]] && { motivo_cae="${motivo_cae/no se manda a Google/no se manda a OpenAI}"; return 0; }
  if ! command -v codex >/dev/null 2>&1; then motivo_cae="codex no está en el PATH (npm install -g @openai/codex)"; return 0; fi
  if ! timeout "${PA_CODEX_CHEQUEO_S:-20}" codex login status </dev/null >/dev/null 2>&1; then
    motivo_cae="codex no tiene sesión iniciada (codex login)"
  fi
  return 0
}
# El latido de un worker de codex (no tiene hooks): lo escribe pa cada PA_CODEX_LATIDO_S mientras vive,
# con el último comando o mensaje del stream.
codex_latido() {
  local d
  d="$(tail -n 5 "$transcript" 2>/dev/null | jq -rs '[.[] | objects | .item? | objects | (.command // .text // .type // empty) | tostring] | last // ""' 2>/dev/null)"
  {
    printf 'epoch=%s\n' "$(date +%s)"
    printf 'tool=%s\n' codex
    printf 'envuelo=1\n'
    printf 'desc=%s\n' "$(printf '%s' "$d" | tr '\n\r\t' '   ' | cut -c1-160)"
  } >"$hb.tmp" 2>/dev/null && mv -f "$hb.tmp" "$hb" 2>/dev/null
}
# El JSON de estado de una corrida de codex, con la forma del de `claude -p` (como agy_a_json): result (el
# último mensaje: el archivo de --output-last-message o el último agent_message), is_error (rc, turn.failed
# o error), num_turns (mensajes del modelo), modelUsage con los tokens de turn.completed (input_tokens de
# codex incluye lo cacheado) y total_cost_usd 0 (se paga con la suscripción de ChatGPT). Sin session_id.
codex_a_json() {   # $1 = jsonl de codex, $2 = stderr, $3 = modelo de pa, $4 = rc, $5 = último mensaje, $6 = segundos
  jq -Rs --arg m "$3" --arg err "$(tail -c 2000 "$2" 2>/dev/null)" --arg ult "$(cat "$5" 2>/dev/null)" \
         --argjson rc "${4:-0}" --argjson seg "${6:-0}" '
    [split("\n")[] | fromjson? | objects] as $ev
    | [$ev[] | select(.type == "item.completed") | .item | objects | select(.type == "agent_message") | .text // empty] as $msgs
    | [$ev[] | select(.type == "turn.completed") | .usage | objects] as $u
    | ([$ev[] | select(.type == "turn.failed") | .error.message? // empty] + [$ev[] | select(.type == "error") | .message? // empty] | last) as $fallo
    | (if $ult != "" then $ult else ($msgs | last // "") end) as $r
    | { type: "result", motor: "codex",
        subtype: (if $fallo == null and $rc == 0 then "success" else "error" end),
        is_error: ($fallo != null or $rc != 0),
        result: (if $fallo != null then ([$r, $fallo] | map(select(. != "")) | join("\n"))
                 elif $r != "" then $r else $err end),
        num_turns: ($msgs | length),
        duration_ms: ($seg * 1000),
        total_cost_usd: 0,
        codex_thread_id: ([$ev[] | select(.type == "thread.started") | .thread_id // empty] | first),
        modelUsage: (if ($u | length) == 0 then {} else
          {($m): { inputTokens: ([$u[] | ((.input_tokens // 0) - (.cached_input_tokens // 0))] | add),
                   cacheReadInputTokens: ([$u[] | .cached_input_tokens // 0] | add),
                   cacheCreationInputTokens: 0,
                   outputTokens: ([$u[] | .output_tokens // 0] | add) }} end) }' "$1"
}

# --- modelos.json: el contrato compartido con Trama (docs/modelos-json-tipo-a-modelo-y-locales-ollama.md) ---
# `~/.config/trama/modelos.json` (TRAMA_MODELOS lo redirige: los tests) dice qué modelo usa cada
# `--tipo` cuando no hay `-m`, qué locales (Ollama) existen y qué hace pa cuando un Gemini caería a
# Claude. Sin el archivo todo es como antes, byte por byte. Un archivo roto avisa en UNA línea por
# stderr y se ignora entero (defaults de pa). `-m` siempre le gana al archivo.
MODELOS_JSON="${TRAMA_MODELOS:-${XDG_CONFIG_HOME:-$HOME/.config}/trama/modelos.json}"
MODELOS_TXT="" MODELOS_ERR="" modelos_leido=0
modelos_cargar() {   # 0 si hay un modelos.json válido (lo deja en MODELOS_TXT); lee y avisa una sola vez
  if (( ! modelos_leido )); then
    modelos_leido=1
    if [[ -f "$MODELOS_JSON" ]]; then
      local txt err
      txt="$(cat "$MODELOS_JSON" 2>/dev/null)"
      err="$(jq -r --arg tipos "default|$TIPOS_VALIDOS" --arg gem "$GEMINI_MODELOS" --arg cod "$CODEX_MODELOS" '
        def efok: . == null or (type == "string" and test("^(low|medium|high|xhigh|max)$"));
        . as $c |
        (if ($c | type) == "object" and ($c.locales | type) == "array" then $c.locales else [] end) as $L |
        [$L[] | objects | .id | strings] as $ids |
        def modok: type == "string" and (test("^claude-[a-z0-9][a-z0-9.-]*$") or test("^(\($gem))$") or test("^(\($cod))$")
                   or (startswith("ollama:") and (. as $m | $ids | index([$m]) != null)));
        [ (if ($c | type) != "object" then "no es un objeto JSON" else empty end),
          (if ($c | type) == "object" then (
            (if $c.version != 1 then "version \($c.version | tojson) (pa entiende 1)" else empty end),
            (if $c.locales != null and ($c.locales | type) != "array" then "locales no es una lista" else empty end),
            ($L[] | select((type != "object") or (.id | type) != "string" or (.id | startswith("ollama:") | not)
                    or (.url | type) != "string" or (.url | test("^https?://[^ ]+$") | not)
                    or (.modelo | type) != "string" or (.modelo == ""))
              | "local mal armado: \(.id? // . | tojson) (hace falta id ollama:…, url http://… y modelo)"),
            (if $c.workers != null and ($c.workers | type) != "object" then "workers no es un objeto" else empty end),
            (if ($c.workers | type) == "object" then ($c.workers | to_entries[] |
                (if (.key | test("^(\($tipos))$") | not) then "tipo de worker desconocido: \(.key)" else empty end),
                (if (.value | type) != "object" or (.value.modelo | modok | not)
                   then "workers.\(.key): modelo desconocido \(.value.modelo? | tojson) (claude-…, gemini-…, agy:… o codex:… de pa u ollama:… que esté en locales)" else empty end),
                (if (.value | type) == "object" and (.value.effort | efok | not) then "workers.\(.key): effort \(.value.effort | tojson) no existe" else empty end))
             else empty end),
            (if $c.reparto != null and ($c.reparto | tostring | test("^(auto|fijo)$") | not)
               then "reparto \($c.reparto | tojson) (auto o fijo)" else empty end),
            (if $c.lider != null and (($c.lider | type) != "object" or ($c.lider.modelo | modok | not))
               then "lider: modelo desconocido \($c.lider.modelo? | tojson)" else empty end),
            (if $c.gemini != null and ($c.gemini | type) != "object" then "gemini no es un objeto" else empty end),
            (if ($c.gemini | type) == "object" and $c.gemini.cupo_max != null
                and (($c.gemini.cupo_max | type) != "number" or $c.gemini.cupo_max < 1 or $c.gemini.cupo_max > 100)
               then "gemini.cupo_max \($c.gemini.cupo_max | tojson) (un número de 1 a 100)" else empty end),
            (if ($c.gemini | type) == "object" and $c.gemini.sin_claude != null
                and ($c.gemini.sin_claude | tostring | test("^(claude|esperar|fallar)$") | not)
               then "gemini.sin_claude \($c.gemini.sin_claude | tojson) (claude, esperar o fallar)" else empty end),
            (def frac: type == "number" and . >= 0 and . < 1;
             if $c.reserva != null and (($c.reserva | frac) or (($c.reserva | type) == "object" and ($c.reserva | length) > 0
                 and ($c.reserva | keys - ["5h", "7d"] | length) == 0 and ([$c.reserva[] | frac] | all)) | not)
               then "reserva \($c.reserva | tojson) (un número de 0 a 1, {\"5h\":…,\"7d\":…} o null)" else empty end),
            (if $c.excluir != null and (($c.excluir | type) != "array" or ([$c.excluir[] | type == "string" and (gsub("\\s"; "") != "")] | all | not))
               then "excluir \($c.excluir | tojson) (una lista de ids o familias)" else empty end),
            (if $c | has("permitir_max") and ($c.permitir_max | type) != "boolean"
               then "permitir_max \($c.permitir_max | tojson) (true o false)" else empty end),
            (if $c.sin_cupo != null and ($c.sin_cupo | tostring | test("^(otro|esperar|fallar)$") | not)
               then "sin_cupo \($c.sin_cupo | tojson) (otro, esperar o fallar)" else empty end)
          ) else empty end) ] | first // ""' <<<"$txt" 2>/dev/null)" || err="no es JSON válido"
      if [[ -z "$err" ]]; then MODELOS_TXT="$txt"
      else MODELOS_ERR="$err"; echo "pa: $MODELOS_JSON no va ($err); sigo con los modelos de siempre." >&2; fi
    fi
  fi
  [[ -n "$MODELOS_TXT" ]]
}
modelos_worker() {   # $1 = tipo (vacío = default) -> "modelo|effort|clave", o nada (| y no TAB: read junta los TAB vacíos)
  modelos_cargar || return 0
  jq -r --arg t "${1:-default}" '.workers // {} | (if has($t) then $t elif has("default") then "default" else empty end) as $k
    | [.[$k].modelo, (.[$k].effort // ""), $k] | join("|")' <<<"$MODELOS_TXT"
}
modelos_gemini() {   # $1 = campo de .gemini (cupo_max | sin_claude) -> valor, o nada
  modelos_cargar || return 0
  jq -r --arg f "$1" '.gemini[$f]? // empty | tostring' <<<"$MODELOS_TXT"
}
# gemini.cupo_max del archivo reemplaza a PA_GEMINI_CUPO_MAX; sin_claude: claude (lo de siempre) | esperar | fallar.
gemini_politica() {
  local v; v="$(modelos_gemini cupo_max)"
  [[ -n "$v" ]] && { GEMINI_CUPO_MAX="${v%%.*}"; GEMINI_CUPO_DE="gemini.cupo_max de modelos.json"; }
  GEMINI_SIN_CLAUDE="$(modelos_gemini sin_claude)"; GEMINI_SIN_CLAUDE="${GEMINI_SIN_CLAUDE:-claude}"
  # sin_cupo (2026-10-24) generaliza gemini.sin_claude: qué hacer cuando el modelo elegido no tiene cupo,
  # sea de Google o el Claude oficial. otro (default) | esperar | fallar. Sin sin_cupo vale gemini.sin_claude
  # (claude = otro); con sin_cupo, gemini.sin_claude sale de él (otro = claude).
  v="$(modelos_clave sin_cupo)"
  if [[ -n "$v" ]]; then SIN_CUPO="$v"; SIN_CUPO_DE="sin_cupo de modelos.json"
    GEMINI_SIN_CLAUDE="$( [[ "$v" == otro ]] && echo claude || echo "$v")"
  elif [[ "$GEMINI_SIN_CLAUDE" != claude ]]; then SIN_CUPO="$GEMINI_SIN_CLAUDE"; SIN_CUPO_DE="gemini.sin_claude de modelos.json"
  else SIN_CUPO=otro; SIN_CUPO_DE=default; fi
  [[ "$(modelos_clave permitir_max)" == true ]] && PERMITIR_MAX=1 || PERMITIR_MAX=0
}
GEMINI_CUPO_DE="PA_GEMINI_CUPO_MAX"; GEMINI_SIN_CLAUDE=claude SIN_CUPO=otro SIN_CUPO_DE=default PERMITIR_MAX=0
modelos_clave() {   # $1 = clave de primer nivel -> su valor (texto o JSON compacto), o nada
  modelos_cargar || return 0
  jq -r --arg k "$1" '.[$k] // empty | if type == "string" then . else tojson end' <<<"$MODELOS_TXT"
}
# excluir de modelos.json: ids o familias que reparto nunca elige y que -m no acepta sin --ok-dueno.
# Misma regla que `reparto --excluido`: familia (fable, opus, sonnet, haiku, argon, flash, gpt-oss, astra, sol, luna) dentro
# del id, id exacto, prefijo de id seguido de "-", o un patrón que termina en * (agy:*, ollama:*).
excluido_por() {   # $1 = modelo -> la entrada de excluir que lo atrapa, o nada (rc 1)
  modelos_cargar || return 1
  local r
  r="$(jq -r --arg m "${1,,}" '
    def fam: ["fable","opus","sonnet","haiku","argon","flash","gpt-oss","astra","sol","luna"];
    [.excluir[]? | select(type == "string") | . as $p | ($p | ascii_downcase | gsub("^\\s+|\\s+$"; "")) as $q
      | select(($q | length) > 0)
      | select(
          (if ($q | endswith("*")) then ($m | startswith($q[:-1]))
           elif (fam | index($q)) != null then ($m | contains($q))
           else ($m == $q or ($m | startswith($q + "-"))) end))
      | $p][0] // empty' <<<"$MODELOS_TXT")"
  [[ -n "$r" ]] && { printf '%s\n' "$r"; return 0; }
  return 1
}
modelos_reparto() {   # -> auto | fijo (default auto; PA_REPARTO=0 apaga reparto para tests de pa)
  [[ "${PA_REPARTO:-}" == 0 ]] && { echo fijo; return; }
  local v=""
  modelos_cargar && v="$(jq -r '.reparto // empty | tostring' <<<"$MODELOS_TXT")"
  echo "${v:-auto}"
}

# --- modelos locales (Ollama) ------------------------------------------------------------------
# `-m ollama:<x>` (o un tipo de modelos.json que lo pida) corre el MISMO claude CLI contra un servidor
# local que habla la API de Anthropic (Ollama >= 0.14). Las variables ANTHROPIC_* van SÓLO en el
# entorno de ese proceso (ver correr): nunca en otro, nunca en settings.json, nunca para un modelo
# que no sea ollama:* (regla de facturación del dueño). Sin --effort. El servidor se prueba antes de
# lanzar (`<url>/api/tags`): si no contesta, o no tiene el modelo, sale 95.
es_local() { [[ "${1,,}" == ollama:* ]]; }
local_de() {   # $1 = id ollama:… -> "url<TAB>modelo<TAB>nombre" (de locales; si no está, el Ollama de siempre)
  local r=""
  modelos_cargar && r="$(jq -r --arg i "$1" '[.locales[]? | select(.id == $i)][0] // empty | [.url, .modelo, (.nombre // .modelo)] | @tsv' <<<"$MODELOS_TXT")"
  if [[ -z "$r" ]]; then
    local u="${OLLAMA_HOST:-http://localhost:11434}"; [[ "$u" == http* ]] || u="http://$u"
    r="$u"$'\t'"${1#ollama:}"$'\t'"${1#ollama:}"
  fi
  printf '%s\n' "${r%/}"
}
local_tags() { curl -fsS -m "${PA_LOCAL_CHEQUEO_S:-3}" "${1%/}/api/tags" 2>/dev/null; }
local_estado() {   # $1 = url, $2 = modelo -> "ok" | motivo de por qué no
  local t
  command -v curl >/dev/null 2>&1 || { echo "falta curl para probar el servidor"; return; }
  t="$(local_tags "$1")" || { echo "el servidor $1 no responde ($1/api/tags)"; return; }
  # Ollama lista lo que tiene bajado: `qwen3-coder:30b`, o `x:latest` si se bajó sin tag.
  if jq -e '.models | type == "array"' <<<"$t" >/dev/null 2>&1 \
     && ! jq -e --arg m "$2" '[.models[] | .name, .model] | any(. == $m or . == ($m + ":latest"))' <<<"$t" >/dev/null 2>&1; then
    echo "el servidor $1 no tiene el modelo '$2' (ollama pull $2)"; return
  fi
  echo ok
}

# --- pa --modelos [--json]: la tabla efectiva (la lee Trama) ------------------------------------
# tipo → modelo y effort que usaría pa sin -m, y de dónde salió; el líder; la política de Gemini;
# los locales con si responden.
modelo_de_pa() {   # $1 = tipo -> "modelo<TAB>effort" de pa sin archivo (lo de siempre, sin --leer/--seguir)
  local m=claude-sonnet-5-5 e=high
  [[ "$1" == mecanico ]] && { m=claude-haiku-5-5; e=xhigh; }
  printf '%s\t%s\n' "$m" "$e"
}
cmd_modelos() {
  local json=0 t r m e k de filas="" locs="" lid="" url mod nom est rep_modo rep_t rep_j rep_m rep_e rep_mot
  [[ "${1:-}" == --json ]] && json=1
  [[ -n "${1:-}" && "$1" != --json ]] && { echo "uso: pa --modelos [--json]" >&2; return 2; }
  modelos_cargar || true; gemini_politica
  rep_modo="$(modelos_reparto)"
  for t in default ${TIPOS_VALIDOS//|/ }; do
    r="$(modelos_worker "$( [[ "$t" == default ]] || echo "$t")")"
    if [[ -n "$r" ]]; then
      IFS='|' read -r m e k <<<"$r"; de="modelos.json (workers.$k)"
      if [[ -z "$e" ]] && ! es_gemini "$m" && ! es_codex "$m" && ! es_local "$m"; then
        case "${m,,}" in *haiku*) e=xhigh ;; *sonnet*) e=high ;; *opus*) [[ "$PLAN" == pro ]] && e=medium || e=settings ;; esac
      fi
      es_gemini "$m" || es_codex "$m" || es_local "$m" && e="-"
    else
      IFS=$'\t' read -r m e <<<"$(modelo_de_pa "$t")"; de="default de pa"
    fi
    rep_m=""; rep_e=""; rep_mot=""
    if [[ "$rep_modo" == auto && -x "$REPARTO" ]]; then
      rep_t="$( [[ "$t" == default ]] && echo codigo-acotado || echo "$t" )"
      rep_j="$(REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" \
        timeout "${PA_REPARTO_TIMEOUT_S:-15}" "$REPARTO" --tipo "$rep_t" --json 2>/dev/null </dev/null || true)"
      if [[ -n "$rep_j" ]]; then
        IFS='|' read -r rep_m rep_e rep_mot < <(
          jq -r '[(.modelo // ""), (.effort // ""), ((.motivo // "") | gsub("[\\r\\n\\t|]+"; " "))] | join("|")' <<<"$rep_j" 2>/dev/null
        ) || true
      fi
    fi
    filas+="$t"$'\t'"$m"$'\t'"${e:--}"$'\t'"$de"$'\t'"${rep_m:-}"$'\t'"${rep_e:--}"$'\t'"${rep_mot:-}"$'\n'
  done
  modelos_cargar && lid="$(jq -r '.lider // empty | [.modelo, (.effort // "")] | join("|")' <<<"$MODELOS_TXT")"
  if modelos_cargar; then
    while IFS=$'\t' read -r k nom url mod; do
      [[ -n "$k" ]] || continue
      est="$(local_estado "$url" "$mod")"
      locs+="$k"$'\t'"$nom"$'\t'"$url"$'\t'"$mod"$'\t'"$est"$'\n'
    done < <(jq -r '.locales[]? | [.id, (.nombre // .modelo), .url, .modelo] | @tsv' <<<"$MODELOS_TXT")
  fi
  if (( json )); then
    jq -n --arg arch "$MODELOS_JSON" --arg err "$MODELOS_ERR" --arg ok "$( [[ -n "$MODELOS_TXT" ]] && echo 1)" \
          --arg existe "$( [[ -f "$MODELOS_JSON" ]] && echo 1)" --arg rep_modo "$rep_modo" \
          --arg filas "$filas" --arg locs "$locs" --arg lid "$lid" --arg plan "$PLAN" \
          --argjson cupo "$GEMINI_CUPO_MAX" --arg cupo_de "$GEMINI_CUPO_DE" --arg sin "$GEMINI_SIN_CLAUDE" \
          --argjson excluir "$(modelos_clave excluir | grep . || echo '[]')" --argjson pmax "$( (( PERMITIR_MAX )) && echo true || echo false)" \
          --arg sin_cupo "$SIN_CUPO" --arg sin_cupo_de "$SIN_CUPO_DE" --argjson reserva "$(modelos_clave reserva | grep . || echo null)" '
      def lineas($s): $s | split("\n") | map(select(. != "") | split("\t"));
      def motor($m): if ($m | startswith("ollama:")) then "ollama" elif ($m | startswith("codex:")) then "codex" elif (($m | startswith("gemini")) or ($m | startswith("agy:"))) then "agy" else "claude" end;
      { archivo: $arch, existe: ($existe == "1"), valido: ($ok == "1"), error: (if $err == "" then null else $err end), plan: $plan,
        reparto: $rep_modo,
        excluir: $excluir, permitir_max: $pmax, sin_cupo: $sin_cupo, sin_cupo_de: $sin_cupo_de, reserva: $reserva,
        lider: (if $lid == "" then null else ($lid | split("|") | {modelo: .[0], effort: (if (.[1] // "") == "" then null else .[1] end), motor: motor(.[0])}) end),
        workers: ([lineas($filas)[] | {key: .[0], value: ({modelo: .[1], effort: (if .[2] == "-" then null else .[2] end), motor: motor(.[1]), origen: .[3]}
          + (if (.[4] // "") == "" then {reparto: null} else {reparto: {modelo: .[4], effort: (if (.[5] // "-") == "-" or (.[5] // "") == "" then null else .[5] end), motor: motor(.[4]), motivo: (.[6] // "")}} end))}] | from_entries),
        gemini: {cupo_max: $cupo, cupo_max_de: $cupo_de, sin_claude: $sin},
        locales: [lineas($locs)[] | {id: .[0], nombre: .[1], url: .[2], modelo: .[3], responde: (.[4] == "ok"), detalle: (if .[4] == "ok" then null else .[4] end)}] }'
    return 0
  fi
  if [[ -n "$MODELOS_TXT" ]]; then echo "archivo: $MODELOS_JSON"
  elif [[ -n "$MODELOS_ERR" ]]; then echo "archivo: $MODELOS_JSON (inválido: $MODELOS_ERR; no se usa)"
  else echo "archivo: $MODELOS_JSON (no existe: modelos de siempre)"; fi
  [[ -n "$lid" ]] && printf 'líder: %s\n' "${lid//|/ effort }" | sed 's/ effort $//'
  printf '%s' "$filas" | awk -F'\t' 'BEGIN{printf "%-15s %-26s %-8s %s\n", "tipo", "modelo", "effort", "de dónde"} {printf "%-15s %-26s %-8s %s%s\n", $1, $2, $3, $4, ($5 != "" ? "  (reparto hoy: " $5 ($6 != "-" && $6 != "" ? " " $6 : "") ")" : "")}'
  echo "gemini: si cae: $GEMINI_SIN_CLAUDE (el cupo lo elige reparto: modo $rep_modo)"
  echo "sin cupo: $SIN_CUPO ($SIN_CUPO_DE); excluir: $(modelos_clave excluir | jq -r 'if length == 0 then "nada" else join(", ") end' 2>/dev/null || echo nada); reserva del Claude oficial: $(modelos_clave reserva | grep . || echo ninguna); max sin --ok-dueno: $( (( PERMITIR_MAX )) && echo sí || echo no)"
  if [[ -n "$locs" ]]; then
    echo "locales:"
    printf '%s' "$locs" | while IFS=$'\t' read -r k nom url mod est; do
      if [[ "$est" == ok ]]; then printf '  %-30s %s  responde\n' "$k" "$url"; else printf '  %-30s %s  NO: %s\n' "$k" "$url" "$est"; fi
    done
  fi
  echo "(-m en pa siempre le gana al archivo)"
}

# El JSON de estado de una corrida agy, con la forma del de `claude -p` (lo leen medir, --esperar,
# --hilos y la app): result, is_error, num_turns (respuestas del modelo), duration_ms, modelUsage
# (tokens sumados de los step_update.usage; input_tokens de agy ya incluye lo leído de caché) y
# total_cost_usd 0 (se paga con el cupo de Google AI Pro). Sin session_id: no hay --seguir con agy y
# guardarlo haría que el próximo --seguir de Claude intente retomar una conversación de agy.
agy_a_json() {   # $1 = stream-json de agy, $2 = stderr de agy, $3 = modelo, $4 = rc
  jq -Rs --arg m "$3" --arg err "$(tail -c 2000 "$2" 2>/dev/null)" --argjson rc "${4:-0}" '
    [split("\n")[] | fromjson? | objects] as $ev
    | ([$ev[] | select(.event == "result") | .result] | last) as $r
    | [$ev[] | .step_update? | objects | select(.state == "DONE")] as $st
    | ([$st[] | .usage | objects]) as $u0
    | (if ($u0 | length) > 0 then $u0 elif $r.usage then [$r.usage] else [] end) as $u
    | ([$st[] | .tool_info.error.message? // empty] | last) as $ult_error
    | { type: "result", motor: "agy",
        subtype: (if ($r.status // "") == "SUCCESS" then "success" else "error" end),
        is_error: ((($r.status // "") != "SUCCESS") or ($rc != 0)),
        result: ($r.response // (if $err != "" then $err else ($ult_error // "") end)),
        num_turns: ([$st[] | select(.step_type == "agent_response")] | length),
        duration_ms: ((($r.duration_seconds // 0) * 1000) | floor),
        total_cost_usd: 0,
        agy_conversation_id: ($r.conversation_id // ([$ev[] | .conversation_id? // empty] | first)),
        agy_status: ($r.status // null),
        modelUsage: (if ($u | length) == 0 then {} else
          {($m): { inputTokens: ([$u[] | ((.input_tokens // 0) - (.cache_read_tokens // 0))] | add),
                   cacheReadInputTokens: ([$u[] | .cache_read_tokens // 0] | add),
                   cacheCreationInputTokens: 0,
                   outputTokens: ([$u[] | (.output_tokens // 0) + (.thinking_tokens // 0)] | add) }} end) }' "$1"
}

medicion_header_al_dia() {
  local h1 tmp
  [[ -s "$MEDICION" ]] || return 0
  h1="$(sed -n 1p "$MEDICION")"
  [[ "$h1" != "$MEDICION_HEADER" && "$MEDICION_HEADER" == "$h1"$'\t'* ]] || return 0
  tmp="$MEDICION.tmp.$$"
  { printf '%s\n' "$MEDICION_HEADER"; tail -n +2 "$MEDICION"; } >"$tmp" && cat "$tmp" >"$MEDICION"
  rm -f "$tmp"
}
medir() {   # $1 = json de salida de la corrida (puede no existir)
  local nums="" cache="" jsons=() f
  # Con auto-cierre la corrida son DOS llamadas: la que se quedó sin turnos (su JSON quedó en
  # `$json_previo`) y el cierre (`$1`). Una fila con los números sumados, no dos filas con el
  # mismo id (review 2026-09-30 #14). is_error es el de la última.
  for f in "${json_previo:-}" "${1:-}"; do [[ -s "$f" ]] && jsons+=( "$f" ); done
  if (( ${#jsons[@]} )); then
    # tokens = input + cache_read + output, sumados sobre todos los modelos de .modelUsage
    nums="$(jq -rs 'def suma(f): if all(.[]; f == null) then "" else ([.[] | f // 0] | add | tostring) end;
                    [ (.[-1].is_error | if . == null then "" else tostring end),
                      suma(.num_turns),
                      (if all(.[]; .duration_ms == null) then "" else ([.[] | .duration_ms // 0] | add / 1000 | floor | tostring) end),
                      suma(if .modelUsage then ([.modelUsage[] | (.inputTokens//0)+(.cacheReadInputTokens//0)+(.outputTokens//0)] | add // 0) else null end),
                      suma(.total_cost_usd) ] | join("\t")' "${jsons[@]}" 2>/dev/null)" || nums=""
    cache="$(jq -rs 'def suma(f): if all(.[]; f == null) then "" else ([.[] | f // 0] | add | tostring) end;
                     [ suma(if .modelUsage then ([.modelUsage[] | .cacheReadInputTokens // 0] | add // 0) else null end),
                       suma(if .modelUsage then ([.modelUsage[] | .cacheCreationInputTokens // 0] | add // 0) else null end),
                       suma(.usage.cache_creation.ephemeral_1h_input_tokens),
                       suma(.usage.cache_creation.ephemeral_5m_input_tokens) ] | join("\t")' "${jsons[@]}" 2>/dev/null)" || cache=""
  fi
  [[ -n "$nums" ]] || nums=$'\t\t\t\t'
  [[ -n "$cache" ]] || cache=$'\t\t\t'
  # seguir = si la corrida RETOMÓ una sesión: un --seguir cuya sesión ya no existía arrancó limpia
  # (resume=0) y se mide como nueva.
  local linea comp=""
  (( ${#jsons[@]} )) && comp="$(contar_compactaciones "$(transcript_de "${jsons[-1]}")")"
  linea="$(printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t\t%s\t%s\t%s\t%s\t%s\t%s\t\t\t%s' "$(date -Iseconds)" "${ts:-}" "$slug" "$modelo" "${esfuerzo:-${ef_vacio:-settings}}" "$leer" "${resume:-$seguir}" "$nums" "$PLAN" "$comp" "$AUTOCOMPACT" "${lanzo:-jefe}" "$cache" "${tipo:-}" "${cuenta:-}")"
  # flock sobre el mismo archivo: dos corridas que terminan a la vez no se pisan el header ni la línea
  (
    flock 7
    if [[ ! -s "$MEDICION" ]]; then printf '%s\n' "$MEDICION_HEADER" >&7
    else medicion_header_al_dia
    fi
    printf '%s\n' "$linea" >&7
  ) 7>>"$MEDICION"
}

stats_resultado() {   # $1 = json de salida — la línea "— N turnos · …", sin el .result
  local comp; comp="$(contar_compactaciones "$(transcript_de "$1")")"
  local extra=""
  [[ "${comp:-0}" =~ ^[0-9]+$ ]] && (( comp > 0 )) && extra=" · $comp compactación(es)"
  jq -r --arg extra "$extra" '"— \(.num_turns // 0) turnos · \(((.duration_ms // 0)/1000)|floor)s · US$\(.total_cost_usd // 0 | .*10000 | round / 10000)" + $extra' "$1"
  [[ -n "$extra" ]] && echo "  (compactó: la tarea no entró en un contexto. Partila en varias la próxima; un worker que compactó ya no sabe bien qué tocó él.)"
  return 0
}

# La rama de la corrida y cómo integrarla. El `.corrida` vive al lado del `.json`, así que
# `cmd_esperar` (que entrega corridas que no lanzó él) también lo encuentra.
linea_rama() {   # $1 = json de salida
  local c="${1%.json}.corrida" r b bc repo n t p ppal
  [[ -f "$c" ]] || return 0
  r="$(leer_campo "$c" rama)"; bc="$(leer_campo "$c" base)"; repo="$(leer_campo "$c" ruta_trabajo)"
  [[ -n "$r" && -d "$repo" ]] || return 0
  git -C "$repo" rev-parse -q --verify "refs/heads/$r" >/dev/null 2>&1 || return 0
  ppal="$(tree_principal "$repo")"; [[ -n "$ppal" ]] || ppal="$repo"
  # la base real es el merge-base con el HEAD (una rama rebaseada con --actualizar ya no sale de `base=`)
  b="$(git -C "$ppal" merge-base HEAD "$r" 2>/dev/null)" || b="$bc"
  n="$(git -C "$repo" rev-list --count "$b..$r" 2>/dev/null || echo 0)"
  t="$(leer_campo "$c" origen)"; [[ -n "$t" ]] || t="$(basename "${1%.json}")"
  p="$(leer_campo "$c" proyecto)"; [[ -n "$p" ]] || p="$(basename "$(dirname "$1")")"
  if (( n == 0 )); then
    if [[ -n "$bc" && "$(git -C "$repo" rev-list --count "$bc..$r" 2>/dev/null)" != 0 ]]; then
      echo "— rama $r: sus commits ya están todos en el tree principal. Nada que integrar."
    else
      echo "— rama $r sin commits: no cambió nada. Se tira con: pa '$p' --descartar $t"
    fi
  else
    echo "— rama $r: $n commit(s) sobre ${b:0:7}. NO está en main hasta que la integres: pa '$p' --integrar $t"
    # otras ramas sin integrar del mismo proyecto que tocan lo mismo. En subshell: `--esperar`
    # entrega corridas que no lanzó él y no tiene ruta/dir/proyecto de ESE proyecto a mano.
    ( ruta="$ppal"; dir="$(dirname "$1")"; proyecto="$p"
      solapamiento "$t" "$(git -C "$ppal" diff --name-only "$b" "$r" 2>/dev/null)" )
  fi
}

mostrar_resultado() {   # $1 = json de salida
  jq -r '.result // "(sin resultado)"' "$1"
  stats_resultado "$1"
  linea_rama "$1"
}

# ========================================================================================
# parseo de argumentos
# ========================================================================================

case "${1:-}" in
  --estado)  cmd_estado; exit 0 ;;
  # `pa --plan max|pro`: lo corre el jefe cuando el dueño dice que cambió de suscripción (el dueño no se
  # acuerda de rutas). Sin argumento dice el vigente. PA_PLAN del entorno le gana al archivo: avisa.
  --plan)
    if [[ -z "${2:-}" ]]; then echo "plan: $PLAN"; exit 0; fi
    case "${2,,}" in
      pro|max) echo "${2,,}" >"$STATE/plan"
               echo "pa: plan ${2,,} guardado en $STATE/plan$([[ "${2,,}" == pro ]] && echo ' (modo ahorro: opus effort medium, tope 100 turnos)' || echo ' (opus con el effort de settings, tope 150)')."
               [[ -n "${PA_PLAN:-}" && "${PA_PLAN,,}" != "${2,,}" ]] && echo "pa: ojo, PA_PLAN=$PA_PLAN en este entorno le gana al archivo." >&2
               exit 0 ;;
      *) echo "uso: pa --plan [pro|max]" >&2; exit 2 ;;
    esac ;;
  --esperar) shift; cmd_esperar "$@"; exit $? ;;
  --esperar-todos) shift; cmd_esperar_todos "$@"; exit $? ;;
  --bien) shift; cmd_bien "$@"; exit $? ;;
  --bien-auto) shift; cmd_bien_auto "$@"; exit $? ;;
  --rinde)    shift; cmd_rinde "$@"; exit $? ;;
  --cupo-gemini) shift; cmd_cupo_gemini "$@"; exit $? ;;
  --modelos) shift; cmd_modelos "$@"; exit $? ;;
  --gemini-proyectos) shift; cmd_gemini_proyectos "$@"; exit $? ;;
  --revertir) shift; cmd_revertir "$@"; exit $? ;;
  --parar)    shift; cmd_parar "$@"; exit $? ;;
  --archivar) shift; cmd_archivar "$@"; exit $? ;;
  --hilos)    shift; cmd_hilos "$@"; exit $? ;;
  --hilo)     shift; cmd_hilo "$@"; exit $? ;;
  --descartar) shift; cmd_descartar_id "$@"; exit $? ;;
  --traspaso) cmd_traspaso; exit 0 ;;
  --limpiar) shift; cmd_limpiar "$@"; exit $? ;;
  --nota) [[ -n "${2:-}" ]] || { echo "uso: pa --nota \"<texto>\"  (pedido de $(nombre_dueno), decisión, qué sigue)" >&2; exit 2; }
          anotar "$2"; echo "pa: anotado."; exit 0 ;;
  -h|--help|--ayuda)
    awk 'NR>1 && /^#/{sub(/^# ?/,""); print; next} NR>1{exit}' "$0"; exit 0 ;;
esac

[[ $# -ge 1 ]] || { echo "uso: pa <proyecto> \"<tarea>\"  |  pa --estado  |  pa --esperar <proyecto>" >&2; exit 2; }

proyecto="$1"; shift

modelo=""   # vacío = el default de la política (abajo, después de saber si es --leer)
esfuerzo="${PA_EFFORT:-}"
esfuerzo_flag=0
leer=0
seguir=0
olvidar=0
matar=0
con_mcp=0
async=0
# Tope de turnos por default. Sin un número, `pa` no exporta PA_MAX_TURNS y el aviso de "te
# quedan N turnos" de latido.sh NO CORRE NUNCA: la red de contención del bug 1 estaba apagada
# salvo que el que llama pasara un flag que nadie pasaba. `--max-turns 0` lo saca.
#
# 60 estaba MAL calibrado y mató la primera corrida sana que se le cruzó (widgets-reactivos,
# 2026-09-13, 61 turnos). Se había elegido mirando las corridas que morían polleando un
# background (85, 122 y 13 turnos) — que es un fallo que el bloqueo de `run_in_background`
# ya evita — en vez de mirar el trabajo productivo. Medido sobre las 329 corridas de
# ~/.local/state/pa/*/*.json: p50=26, p75=64, p90=104, p95=125, máximo 464 (US$20,65).
# O sea: el tope estaba DEBAJO del percentil 75 del trabajo que sale bien.
# 150 queda arriba del p95 y sigue cortando la corrida desbocada. Es anti-fuga, no presupuesto.
max_turns="150"
# Plan pro: 100 (≈ p90 de las corridas medidas). Con tareas partidas más chicas el p75 baja; lo
# que pase de 100 en pro es casi siempre una tarea que había que partir, y el auto-cierre la cierra.
[[ "$PLAN" == pro ]] && max_turns="100"
max_budget=""
run_id=""
sucio_mio=0
# --aca: correr en el tree principal en vez del worktree del proyecto. Es el caso "seguí lo
# que estoy haciendo" (el dueño tiene cambios sin commitear que el worker TIENE que ver).
# --sucio-mio lo implica: si lo sucio del tree principal es del worker, ahí tiene que trabajar.
aca=0
integrar=""; integrar_tests=0; descartar=""; ramas=0
# --actualizar <id>: corrida LIMPIA (sesión nueva, barata) en el puesto de esa corrida y sobre SU
# rama, con una tarea fija: rebasearla sobre el HEAD de main resolviendo los conflictos. Es el
# camino de un `--integrar` que salió 80. Graba origen=<id>, así se integra con el mismo id.
actualizar=""
force=0
tarea=""
# --tipo: qué clase de tarea es (ver TIPOS_VALIDOS). Opcional; vacío = sin clasificar (`?` en --rinde).
tipo="${PA_TIPO:-}"
# --ok-dueno: el dueño aprobó esta corrida (opus max, sonnet max, fable). Sólo por flag, a propósito:
# una variable de entorno se hereda de una llamada a la otra y la aprobación es por corrida.
ok_dueno=0 modelo_de_m=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --seguir)          seguir=1; shift ;;
    --nuevo)           shift ;;   # ya es el default; se acepta para no romper scripts viejos
    --leer)            leer=1; shift ;;
    --olvidar)         olvidar=1; shift ;;
    --matar)           matar=1; shift ;;
    --mcp)             con_mcp=1; shift ;;
    --async)           async=1; shift ;;
    --sin-jefe)        export PA_JEFE="" PA_JEFE_ID=""; shift ;;
    --max-turns)       max_turns="$2"; [[ "$max_turns" == 0 ]] && max_turns=""; shift 2 ;;
    --id)              run_id="$2"; shift 2 ;;
    --sucio-mio)       sucio_mio=1; aca=1; shift ;;
    --aca)             aca=1; shift ;;
    --integrar)        integrar="$2"; shift 2 ;;
    --tests)           integrar_tests=1; shift ;;
    --descartar)       descartar="$2"; shift 2 ;;
    --actualizar)      actualizar="$2"; shift 2 ;;
    --ramas)           ramas=1; shift ;;
    --force)           force=1; shift ;;
    --nota)            anotar "$2"; shift 2 ;;   # la nota del jefe va pegada a esta llamada (ver anotar)
    --max-budget-usd)  max_budget="$2"; shift 2 ;;
    -m|--model)        modelo="$2"; modelo_de_m=1; shift 2 ;;
    --effort)          esfuerzo="$2"; esfuerzo_flag=1; export PA_EFFORT="$2"; shift 2 ;;
    --tipo)            tipo="$2"; shift 2 ;;
    --ok-dueno)        ok_dueno=1; shift ;;
    --cuenta)          cuenta_flag="$2"; shift 2 ;;
    --)                shift; tarea="$*"; break ;;
    -*)                # alias: --ok-<nombre del dueño en minúscula> (el nombre viejo del flag)
                       if [[ "$1" == "--ok-$(nombre_dueno | tr 'A-Z' 'a-z')" || ( -n "${USER:-}" && "$1" == "--ok-$USER" ) ]]; then ok_dueno=1; shift
                       else echo "pa: opción desconocida: $1" >&2; exit 2; fi ;;
    *)                 tarea="$*"; break ;;
  esac
done
if (( integrar_tests )) && [[ -z "$integrar" ]]; then
  echo "pa: --tests va con --integrar: pa <proy> --integrar <id> --tests" >&2; exit 2
fi

# --- política de modelos (el dueño, 2026-09-30; plan pro 2026-10-02; por situación 2026-10-10) ---
# El modelo se elige por situación, no por un índice promedio, y para elegir hay que poder medir:
# la tabla ya no niega lo "dominado" (opus low, sonnet fuera de high).
# Tabla: haiku → low|medium|high|xhigh|max (default xhigh); sonnet (y el default de --leer) →
# low|medium|high|xhigh (default high); opus → low|medium|high|xhigh.
# Salen 2, salvo con --ok-dueno (el dueño aprobó ESA corrida): max fuera de haiku (opus max rinde
# 1,5 puntos más por 65 % más de costo) y cualquier fable (en `-p` cobra créditos sin preguntar y
# usa hasta la mitad del límite semanal). --ok-dueno no tiene variable de entorno y --seguir no lo
# hereda: va en cada llamada. El padre de --async se lo pasa al hijo.
# El candado va acá, antes de resolver el proyecto y de lanzar nada: es determinista, no una
# sugerencia en el SKILL que el jefe puede olvidarse.
# Defaults sin --effort: haiku xhigh y sonnet high en los dos planes. Opus: plan max → el de
# settings (effortLevel) si es medium|high|xhigh (o vacío = el de claude); si settings dice otra
# cosa (low, max) va high explícito. Plan pro (modo ahorro) → medium explícito.
# El hijo de --async recibe -m explícito y el effort por PA_EFFORT, así que pasa por lo mismo.
# Sólo en los caminos que lanzan un claude: un PA_EFFORT=low heredado no puede impedir un --matar,
# --integrar, --descartar, --ramas u --olvidar (--esperar y --estado ya salieron arriba).
lanza=1; (( matar || ramas || olvidar )) && lanza=0; [[ -n "$integrar$descartar" ]] && lanza=0
# El tipo se valida igual que el effort: sólo donde se lanza (un PA_TIPO heredado no traba la gestión).
tipo="${tipo,,}"; [[ "$tipo" == diseño ]] && tipo=diseno
if (( lanza )) && [[ -n "$tipo" && ! "$tipo" =~ ^($TIPOS_VALIDOS)$ ]]; then
  echo "pa: --tipo '$tipo' no existe. Válidos: ${TIPOS_VALIDOS//|/, }${PA_TIPO:+ (ojo: puede venir de PA_TIPO)}." >&2
  exit 2
fi
# Sin -m, si reparto está en auto, `reparto --tipo <tipo> --json` elige modelo y effort según calidad
# y cupo libre. Con --seguir se conserva el modelo de la corrida que se retoma (agy no retoma sesiones).
# Si reparto falla o vence el tope (PA_REPARTO_TIMEOUT_S, default 15 s), cae a modelos.json o al default.
vino_de_reparto=0; reparto_fallo=""
# El tipo con el que reparto eligió, para pedirle el siguiente candidato si agy contesta 429 (el hijo de
# --async lo recibe por el entorno: el padre es el que eligió).
reparto_tipo_relanzable="${PA_REPARTO_TIPO:-}"; unset PA_REPARTO_TIPO
# sin_cupo=esperar con todo lleno: el padre de --async lo marca y el hijo hace cola (más abajo, ya con su id).
reparto_esperar="${PA_REPARTO_ESPERAR:-}"; unset PA_REPARTO_ESPERAR
if [[ -z "$modelo" ]] && (( lanza )) && [[ "$(modelos_reparto)" == auto ]]; then
  if (( seguir )); then
    if [[ -n "$run_id" || -z "$tipo" ]]; then
      ruta_s="$(proyecto-ruta "$proyecto" 2>/dev/null || true)"
      if [[ -n "$ruta_s" ]]; then
        slug_s="$(slug_de "$ruta_s")"
        ts_seg="$run_id"
        [[ -z "$ts_seg" ]] && (( ! leer )) && ts_seg="$(cat "$STATE/$slug_s.session.ts" 2>/dev/null || true)"
        if [[ -n "$ts_seg" && -f "$STATE/$slug_s/$ts_seg.hilo" ]]; then
          m_seg="$(leer_campo "$STATE/$slug_s/$ts_seg.hilo" modelo)"
          e_seg="$(leer_campo "$STATE/$slug_s/$ts_seg.hilo" effort)"
          if [[ "$m_seg" == claude-* && ( "$m_seg" != *fable* || $ok_dueno -eq 1 ) ]]; then
            modelo="$m_seg"
            [[ -z "$esfuerzo" && -n "$e_seg" && "$e_seg" != "-" && "$e_seg" != "settings" ]] \
              && { esfuerzo="$e_seg"; export PA_EFFORT="$e_seg"; }
          fi
        fi
      fi
    fi
  elif [[ -n "$tarea$actualizar" && -z "${PA_ASYNC:-}" ]] && (( ! aca && ! con_mcp )) \
       && [[ -z "$max_budget" && ! "${esfuerzo,,}" =~ ^(xhigh|max)$ ]] \
       && proyecto-ruta "$proyecto" >/dev/null 2>&1; then
    tipo_rep="$tipo"
    [[ -n "$tipo_rep" ]] || { (( leer )) && tipo_rep=lectura || tipo_rep=codigo-acotado; }
    rep_rc=0; rep_json=""
    if [[ -x "$REPARTO" ]]; then
      rep_json="$(REPARTO_RESERVAR=1 REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" \
        timeout "${PA_REPARTO_TIMEOUT_S:-15}" "$REPARTO" --tipo "$tipo_rep" ${cuenta_flag:+--cuenta "$cuenta_flag"} --json 2>/dev/null </dev/null)" || rep_rc=$?
    else
      rep_rc=127
    fi
    m_rep=""; e_rep=""; mot_rep=""
    if (( rep_rc == 0 )) && [[ -n "$rep_json" ]]; then
      IFS='|' read -r m_rep e_rep mot_rep < <(
        jq -r '[(.modelo // ""), (.effort // ""), ((.motivo // "") | gsub("[\\r\\n\\t|]+"; " "))] | join("|")' <<<"$rep_json" 2>/dev/null
      ) || true
    fi
    if [[ -n "$m_rep" ]]; then
      modelo="$m_rep"; vino_de_reparto=1; reparto_tipo_relanzable="$tipo_rep"
      if [[ -n "$e_rep" ]] && ! es_gemini "$modelo" && ! es_codex "$modelo" && ! es_local "$modelo"; then
        [[ -z "$esfuerzo" ]] && { esfuerzo="$e_rep"; export PA_EFFORT="$e_rep"; }
      fi
      if (( esfuerzo_flag )) && { es_gemini "$modelo" || es_codex "$modelo"; } && [[ "$modelo" =~ ^(.*)-(low|medium|high)$ ]]; then
        base_rep="${BASH_REMATCH[1]}"
        case "${esfuerzo,,}" in
          low|medium|high)
            [[ "$base_rep" == "agy:gpt-oss-120b" ]] && modelo="${base_rep}-medium" || modelo="${base_rep}-${esfuerzo,,}"
            esfuerzo_flag=0; esfuerzo=""; unset PA_EFFORT ;;
        esac
      fi
      echo "pa: reparto ($tipo_rep) → $modelo${esfuerzo:+ effort $esfuerzo}: $mot_rep" >&2
      # Todo lleno (2026-10-24): reparto dio el más barato que alcanza, que va a chocar el límite.
      # sin_cupo dice qué hacer: otro (default) lanza igual y, si choca al arrancar, relanza con el
      # siguiente; esperar hace cola con --async; fallar sale 96.
      if [[ "$(jq -r '.todo_lleno // false' <<<"$rep_json" 2>/dev/null)" == true ]]; then
        gemini_politica
        case "$SIN_CUPO" in
          fallar)
            echo "pa: no hay cupo para $tipo_rep (todo lleno o en reserva) y modelos.json dice sin_cupo=fallar ($SIN_CUPO_DE): no lanzo." >&2
            exit 96 ;;
          esperar)
            if (( async )); then
              export PA_REPARTO_ESPERAR=1
              echo "pa: no hay cupo para $tipo_rep y modelos.json dice sin_cupo=esperar: queda en cola hasta que haya." >&2
            else
              echo "pa: no hay cupo para $tipo_rep (todo lleno o en reserva) y modelos.json dice sin_cupo=esperar: lanzalo con --async (hace cola hasta que haya cupo)." >&2
              exit 75
            fi ;;
        esac
      fi
    else
      if (( rep_rc == 124 || rep_rc == 137 )); then reparto_fallo="timeout tras ${PA_REPARTO_TIMEOUT_S:-15}s"
      elif (( rep_rc == 127 )); then reparto_fallo="no existe $REPARTO"
      else reparto_fallo="rc $rep_rc"; fi
    fi
  fi
fi
# modelos.json (si existe y es válido): con reparto=fijo o si reparto falló, el tipo (o `default`)
# elige modelo y effort. El effort del archivo no le gana a --effort ni a PA_EFFORT.
if [[ -z "$modelo" ]] && (( lanza )) && modelos_cargar; then
  IFS='|' read -r m_cfg e_cfg k_cfg <<<"$(modelos_worker "$tipo")" || true
  if [[ -n "${m_cfg:-}" ]]; then
    modelo="$m_cfg"
    [[ -n "$e_cfg" && -z "$esfuerzo" ]] && { esfuerzo="$e_cfg"; export PA_EFFORT="$e_cfg"; }   # el hijo de --async lo lee de ahí
  fi
fi
if [[ -z "$modelo" ]]; then
  # Default Sonnet (el dueño, 2026-10-13: cupo de uso). Opus se pide a mano con -m.
  # Excepción: --tipo mecanico (sin --leer ni --seguir) → Haiku; su effort sale xhigh abajo.
  modelo="claude-sonnet-5-5"
  if [[ "$tipo" == mecanico ]] && (( ! leer && ! seguir )); then modelo="claude-haiku-5-5"; fi
fi
[[ -n "$reparto_fallo" ]] && echo "pa: reparto falló ($reparto_fallo); sigo con $modelo." >&2
# --- Gemini y Claude/GPT por agy: validar, mirar el plugin y privacidad, o caer al equivalente Claude ---
# docs/gemini-workers-agy.md. Lo que agy no tiene (retomar sesión, MCP de claude.ai, tope de gasto
# en US$, el tree principal sin worktree) se niega acá en vez de lanzar algo que no es lo pedido.
motor=claude; gemini_pedido=""
# La cuenta de la retomada (--seguir sin --cuenta): mismo puesto, misma suscripción.
if (( lanza && seguir )) && [[ -z "$cuenta_flag" ]] && ruta_c="$(proyecto-ruta "$proyecto" 2>/dev/null)" && [[ -n "$ruta_c" ]]; then
  slug_c="$(slug_de "$ruta_c")"; ts_c="$run_id"
  [[ -z "$ts_c" ]] && (( ! leer )) && ts_c="$(cat "$STATE/$slug_c.session.ts" 2>/dev/null || true)"
  [[ -n "$ts_c" ]] && cuenta_seguir="$(leer_campo "$STATE/$slug_c/$ts_c.hilo" cuenta || true)"
fi
# La cuenta de agy va ANTES del chequeo: /hooks corre con el HOME de esa cuenta.
(( lanza )) && es_gemini "$modelo" && cuenta_resolver google
if (( lanza )) && es_gemini "$modelo"; then
  if [[ ! "${modelo,,}" =~ ^($GEMINI_MODELOS)$ ]]; then
    echo "pa: modelo '$modelo' no va. Modelos de agy en pa: gemini-{4-argon,3.8-flash}-{low,medium,high}, agy:claude-{opus,sonnet}-5-5-{low,medium,high} o agy:gpt-oss-120b-medium." >&2
    exit 2
  fi
  modelo="${modelo,,}"
  if (( esfuerzo_flag )); then
    echo "pa: --effort no va con '$modelo': en agy el effort es parte del nombre (…-low, …-medium, …-high)." >&2
    exit 2
  fi
  esfuerzo=""; unset PA_EFFORT    # uno heredado no aplica: el hijo de --async no lo tiene que ver
  for no_va in "seguir:--seguir (agy no retoma una sesión de pa)" "aca:--aca/--sucio-mio (un worker de agy trabaja siempre en su worktree)" "con_mcp:--mcp (los MCP de claude.ai no existen en agy)"; do
    v_no_va="${no_va%%:*}"
    if (( ${!v_no_va} )); then echo "pa: ${no_va#*:} no va con '$modelo'. Sacalo, o usá un modelo Claude." >&2; exit 2; fi
  done
  [[ -n "$max_budget" ]] && { echo "pa: --max-budget-usd no va con '$modelo' (agy se paga con el cupo, no en US$)." >&2; exit 2; }
  # El chequeo lo hace el padre de --async (o el pa en primer plano): el hijo ya recibe el modelo
  # final. Excepción: con gemini.sin_claude=esperar, el padre pasa PA_GEMINI_REVISAR=1.
  gemini_politica
  if [[ -z "${PA_ASYNC:-}" || -n "${PA_GEMINI_REVISAR:-}" ]]; then
    gemini_chequear "$modelo"
    if [[ -z "$motivo_cae" ]]; then
      motor=agy
    elif (( vino_de_reparto )) || [[ "$GEMINI_SIN_CLAUDE" == claude ]]; then
      read -r m_eq e_eq <<<"$(gemini_equivalente "$modelo")"
      echo "pa: $modelo → $m_eq effort $e_eq: $motivo_cae." >&2
      gemini_pedido="$modelo"; modelo="$m_eq"; esfuerzo="$e_eq"; export PA_EFFORT="$e_eq"
    elif [[ "$GEMINI_SIN_CLAUDE" == fallar || "$clase_cae" == fijo ]]; then
      echo "pa: $modelo no está disponible ($motivo_cae) y modelos.json dice gemini.sin_claude=$GEMINI_SIN_CLAUDE: no caigo a Claude.$([[ "$GEMINI_SIN_CLAUDE" == esperar ]] && echo ' Esperar no lo arregla.')" >&2
      exit 96
    elif [[ -n "${PA_ASYNC:-}" ]]; then
      motor=agy; gemini_esperar=1     # el hijo de --async: hace cola más abajo, ya con su id
    elif (( async )); then
      motor=agy; export PA_GEMINI_REVISAR=1   # el padre: lanza igual; el hijo vuelve a mirar y espera
    else
      echo "pa: $modelo no está disponible ahora ($motivo_cae) y modelos.json dice gemini.sin_claude=esperar: lanzalo con --async (hace cola hasta que haya cupo)." >&2
      exit 75
    fi
  else
    motor=agy
  fi
fi
# --- ChatGPT por codex: validar, privacidad, codex y su login, o caer al equivalente Claude ------
# docs/codex-workers.md. Como agy: sin --seguir, --aca, --mcp ni --max-budget-usd.
if (( lanza )) && es_codex "$modelo"; then
  if [[ ! "${modelo,,}" =~ ^($CODEX_MODELOS)$ ]]; then
    echo "pa: modelo '$modelo' no va. Modelos de codex en pa: codex:{gpt-6.1-sol,gpt-6-sol,gpt-6-luna,gpt-6-astra}-{low,medium,high}." >&2
    exit 2
  fi
  modelo="${modelo,,}"
  if (( esfuerzo_flag )); then
    echo "pa: --effort no va con '$modelo': en codex el effort es parte del nombre (…-low, …-medium, …-high)." >&2
    exit 2
  fi
  esfuerzo=""; unset PA_EFFORT
  for no_va in "seguir:--seguir (codex no retoma una sesión de pa)" "aca:--aca/--sucio-mio (un worker de codex trabaja siempre en su worktree)" "con_mcp:--mcp (los MCP de claude.ai no existen en codex)"; do
    v_no_va="${no_va%%:*}"
    if (( ${!v_no_va} )); then echo "pa: ${no_va#*:} no va con '$modelo'. Sacalo, o usá un modelo Claude." >&2; exit 2; fi
  done
  [[ -n "$max_budget" ]] && { echo "pa: --max-budget-usd no va con '$modelo' (codex se paga con la suscripción de ChatGPT, no en US\$)." >&2; exit 2; }
  gemini_politica
  if [[ -z "${PA_ASYNC:-}" ]]; then
    codex_chequear "$modelo"
    if [[ -z "$motivo_cae" ]]; then
      motor=codex
    elif (( vino_de_reparto )) || [[ "$GEMINI_SIN_CLAUDE" == claude ]]; then
      read -r m_eq e_eq <<<"$(codex_equivalente "$modelo")"
      echo "pa: $modelo → $m_eq effort $e_eq: $motivo_cae." >&2
      gemini_pedido="$modelo"; modelo="$m_eq"; esfuerzo="$e_eq"; export PA_EFFORT="$e_eq"
    else
      echo "pa: $modelo no está disponible ($motivo_cae) y modelos.json dice sin_cupo=$SIN_CUPO: no caigo a Claude. Esperar no lo arregla." >&2
      exit 96
    fi
  else
    motor=codex
  fi
fi
# La cuenta de Claude (o ninguna, para un local). Si agy cayó al equivalente Claude, la --cuenta pedida
# era de Google: no aplica, se elige la de Claude.
if (( lanza )) && [[ "$motor" != agy ]]; then
  if [[ -n "$gemini_pedido" && -n "$cuenta_flag" ]]; then
    echo "pa: la cuenta $cuenta_flag es de agy y caí a $modelo: uso una cuenta de Claude." >&2
    cuenta_flag=""
  fi
  cuenta_resolver "$(proveedor_de_modelo "$modelo")"
fi
[[ -n "$cuenta" && "$cuenta" != claude && "$cuenta" != google ]] && echo "pa: cuenta $cuenta." >&2
# --- modelo local (ollama:*): validar y probar el servidor antes de lanzar nada -----------------
# Lo prueba el padre de --async (o el pa en primer plano); el hijo recibe el mismo -m y no repite.
local_url="" local_modelo=""
if (( lanza )) && es_local "$modelo"; then
  [[ "$modelo" =~ ^[Oo][Ll][Ll][Aa][Mm][Aa]:[^[:space:]]+$ ]] || { echo "pa: modelo '$modelo' no va: un local es ollama:<modelo> (ej. ollama:qwen3-coder:30b)." >&2; exit 2; }
  modelo="ollama:${modelo#*:}"
  if (( esfuerzo_flag )); then echo "pa: --effort no va con '$modelo': un modelo local no tiene effort." >&2; exit 2; fi
  [[ -n "$max_budget" ]] && { echo "pa: --max-budget-usd no va con '$modelo' (un local no se paga en US\$)." >&2; exit 2; }
  esfuerzo=""; unset PA_EFFORT    # uno heredado (o el de modelos.json) no aplica
  IFS=$'\t' read -r local_url local_modelo _ <<<"$(local_de "$modelo")"
  if [[ -z "${PA_ASYNC:-}" ]]; then
    est_local="$(local_estado "$local_url" "$local_modelo")"
    if [[ "$est_local" != ok ]]; then
      echo "pa: no lanzo '$modelo': $est_local. Levantá el servidor (ollama serve) o elegí otro modelo con -m." >&2
      exit 95
    fi
  fi
  motor=ollama
fi
[[ "$motor" == agy || "$motor" == codex || "$motor" == ollama ]] && ef_vacio="-"   # medicion.tsv y .hilo: sin effort (agy y codex: va en el nombre)
ojo_env="${PA_EFFORT:+ (ojo: puede venir de PA_EFFORT)}"
ef="${esfuerzo,,}"
(( lanza )) && gemini_politica
if (( lanza && ! ok_dueno )); then
  m="${modelo,,}"
  con_ok="$(D "Si @DUENO@ aprobó esta corrida, repetila con --ok-dueno")"
  # excluir de modelos.json (2026-10-24): un -m que el archivo excluye no corre sin --ok-dueno. El hijo
  # de --async no lo mira: su -m lo puso el padre, que ya pasó por acá.
  if (( modelo_de_m )) && [[ -z "${PA_ASYNC:-}" ]] && excl="$(excluido_por "$modelo")"; then
    echo "pa: modelo '$modelo' está excluido en modelos.json (excluir: $excl). $con_ok; si no, elegí otro con -m o sacalo de excluir." >&2
    exit 2
  fi
  if [[ "$m" == *fable* ]]; then
    echo "pa: modelo '$modelo' no va sin --ok-dueno: Fable en \`-p\` cobra créditos sin preguntar y usa hasta la mitad del límite semanal. $con_ok; si no, para frontend/diseño o algo difícil: -m claude-opus-5-5 --effort xhigh." >&2
    exit 2
  elif [[ "$ef" == max && "$m" != *haiku* ]] && ! (( PERMITIR_MAX )); then
    if [[ "$m" == *opus* ]]; then
      echo "pa: effort 'max' con opus no va sin --ok-dueno: rinde 1,5 puntos más por 65 % más de costo. $con_ok; si no, usá low, medium, high o xhigh$ojo_env." >&2
    else
      echo "pa: effort 'max' con '$modelo' no va sin --ok-dueno (sin flag, max sólo con claude-haiku-5-5). $con_ok; si no, usá low, medium, high o xhigh$ojo_env." >&2
    fi
    exit 2
  fi
fi
if [[ -z "$esfuerzo" && "$motor" == claude ]]; then
  if [[ "${modelo,,}" == *haiku* ]]; then esfuerzo="xhigh"
  elif [[ "${modelo,,}" == *sonnet* ]]; then esfuerzo="high"
  elif [[ "$PLAN" == pro ]]; then esfuerzo="medium"
  elif (( leer )); then esfuerzo="high"
  elif [[ "${modelo,,}" == *opus* ]]; then
    # PA_CLAUDE_SETTINGS: para los tests (nunca el settings real).
    ef_settings="$(jq -r '.effortLevel // empty' "${PA_CLAUDE_SETTINGS:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json}" 2>/dev/null)"
    case "${ef_settings,,}" in ''|medium|high|xhigh) ;; *) esfuerzo="high" ;; esac
  fi
fi

ruta="$(proyecto-ruta "$proyecto")"
fijar_proyecto

if [[ $matar -eq 1 ]]; then cmd_matar "$slug"; exit $?; fi
if [[ -n "$integrar" ]];  then cmd_integrar "$integrar"; exit $?; fi
if [[ -n "$descartar" ]]; then cmd_descartar "$descartar"; exit $?; fi
if (( ramas )); then cmd_ramas; exit $?; fi

if [[ $olvidar -eq 1 ]]; then
  rm -f "$sfile"
  echo "pa: sesión de '$slug' descartada."
  exit 0
fi

if [[ -n "$actualizar" ]]; then
  (( seguir || leer || aca )) && { echo "pa: --actualizar no va con --seguir, --leer ni --aca: es una corrida limpia sobre la rama de esa corrida." >&2; exit 2; }
  c_act="$dir/$actualizar.corrida"
  [[ -f "$c_act" && -n "$(leer_campo "$c_act" rama)" ]] \
    || { echo "pa: no hay una corrida '$actualizar' de '$slug' con rama propia (falta $c_act o corrió en el tree principal)." >&2; exit 2; }
  git -C "$ruta" rev-parse -q --verify "refs/heads/$(leer_campo "$c_act" rama)" >/dev/null 2>&1 \
    || { echo "pa: la rama $(leer_campo "$c_act" rama) ya no existe (¿integrada o descartada?)." >&2; exit 2; }
else
  [[ -n "$tarea" ]] || { echo "pa: falta la tarea." >&2; exit 2; }
fi

# --- --leer --seguir -------------------------------------------------------------------------
# Una corrida --leer no guarda casillero `<slug>.session` (es del que escribe), así que sin --id
# no hay "última sesión" que retomar. Y no puede retomar la de un worker que escribe: ésa vive en
# su worktree y el --leer corre en el tree principal. Retoma la de otro --leer (`--id`).
if (( leer && seguir )); then
  if [[ -z "$run_id" ]]; then
    echo "pa: --leer --seguir necesita --id <corrida>: las corridas --leer no guardan un casillero de sesión (es del worker que escribe). El id lo imprime pa --async; ver también: pa --estado." >&2
    exit 2
  fi
  if [[ -f "$dir/$run_id.corrida" && -n "$(leer_campo "$dir/$run_id.corrida" rama)" ]]; then
    echo "pa: la corrida $run_id de '$slug' escribió en su worktree (rama $(leer_campo "$dir/$run_id.corrida" rama)); un --leer corre en el tree principal y no la ve. Retomala sin --leer." >&2
    exit 2
  fi
fi
# La conversación que ya está corriendo en otro proceso no se retoma: dos claude sobre el mismo
# session_id se pisan el transcript. Al que escribe lo cubre el lock; a un --leer, no.
if (( seguir )); then
  sid_pedido=""
  if [[ -n "$run_id" ]]; then sid_pedido="$(cat "$dir/$run_id.sid" 2>/dev/null || true)"
  elif (( ! leer )); then sid_pedido="$(cat "$sfile" 2>/dev/null || true)"; fi
  if [[ -n "$sid_pedido" ]]; then
    for f_run in "$STATE/$slug.running" "$STATE/$slug"@*.running "$STATE/$slug".leer-*.running; do
      [[ -f "$f_run" ]] || continue
      vivo "$f_run" && [[ "$(leer_campo "$f_run" sid)" == "$sid_pedido" ]] || continue
      echo "pa: esa conversación ya está corriendo ($(basename "$f_run")). Esperala con: pa --esperar '$proyecto' --id $(leer_campo "$f_run" id)" >&2
      exit 75
    done
  fi
fi

# `--seguir` sin --id retoma el casillero `<slug>.session`, que es del ÚLTIMO writer que terminó
# bien. Con puestos ése puede ser de OTRA sesión de Claude trabajando en el mismo proyecto: retomar
# la conversación del otro sería meterse en su trabajo. Si el casillero es de otro jefe, se pide --id.
if (( seguir && ! leer )) && [[ -z "$run_id" && -f "$sfile.ts" ]]; then
  ts_casillero="$(cat "$sfile.ts" 2>/dev/null || true)"
  if [[ -n "$ts_casillero" && -f "$dir/$ts_casillero.corrida" ]]; then
    j_casillero="$(leer_campo "$dir/$ts_casillero.corrida" jefe_id)"; yo_jefe="$(jefe_id)"
    if [[ -n "$j_casillero" && -n "$yo_jefe" && "$j_casillero" != "$yo_jefe" ]]; then
      echo "pa: la última sesión guardada de '$slug' (corrida $ts_casillero) es de otro jefe ($(leer_campo "$dir/$ts_casillero.corrida" jefe)). No la retomo sin --id: pa '$proyecto' --seguir --id <tu corrida> '...'" >&2
      exit 2
    fi
  fi
fi

# --- --seguir sobre una sesión de caché frío ---------------------------------------------------
# El caché de prompt dura 1 h: retomar después reescribe TODO el contexto viejo a precio de escritura
# (medido en medicion.tsv, 12-13/10/2026: US$6,5 por corrida retomada contra US$2,7 de las nuevas, y 6
# de 7 compactaron). Pasado el umbral no se retoma: se arranca una sesión nueva, en el mismo puesto y
# rama que la retomada (como --actualizar). `frio` lo lee el bloque de sesión de más abajo. El
# auto-cierre por falta de turnos retoma en la misma corrida, con el caché caliente: no pasa por acá.
frio=0; frio_edad_min=""
CACHE_FRIO_MIN="${PA_CACHE_FRIO_MIN:-55}"
[[ "$CACHE_FRIO_MIN" =~ ^[0-9]+$ ]] || CACHE_FRIO_MIN=55
if (( seguir && CACHE_FRIO_MIN > 0 )); then
  if [[ -n "$run_id" ]]; then frio_sid="$(cat "$dir/$run_id.sid" 2>/dev/null || true)"; frio_arch="$dir/$run_id.sid"
  elif (( ! leer )); then frio_sid="$(cat "$sfile" 2>/dev/null || true)"; frio_arch="$sfile"
  else frio_sid=""; frio_arch=""; fi
  if [[ -n "$frio_sid" ]]; then
    frio_edad_min="$(sesion_edad_min "$frio_sid" "$frio_arch")"
    if [[ "$frio_edad_min" =~ ^[0-9]+$ ]] && (( frio_edad_min > CACHE_FRIO_MIN )); then
      frio=1
      if (( frio_edad_min >= 120 )); then frio_txt="$(( frio_edad_min / 60 ))h"; else frio_txt="${frio_edad_min}min"; fi
      echo "pa: sesión de hace $frio_txt: caché frío, arranco nueva." >&2
    fi
  fi
fi

# --- --seguir sobre una sesión que ya compactó ------------------------------------------------
# Antes del fork de --async, así el jefe se entera al toque y no por --esperar.
if (( seguir && ! frio )); then
  comp=""; terminada=0
  read -r comp terminada < <(seguir_compactada) || true
  if [[ -n "$comp" ]]; then
    if (( terminada && ! force )); then
      echo "pa: NO retomo: esa sesión de '$slug' ya compactó $comp vez/veces. Retomarla arranca con el contexto casi lleno y vuelve a compactar enseguida (una tarea chica costó 5 compactaciones)." >&2
      echo "pa: lanzá una corrida limpia con la tarea autocontenida (sin --seguir). Si de verdad necesitás ese hilo: agregá --force." >&2
      exit 2
    fi
    (( terminada )) || echo "pa: (esa sesión ya compactó $comp vez/veces; la retomo igual porque la corrida quedó sin cerrar)" >&2
  fi
fi

# --- límite de sesión conocido ----------------------------------------------------------
# Si un worker ya chocó el límite de la suscripción, lanzar otro antes del reset es tirar el
# intento (vuelve en <1s con num_turns:1). El wrapper viejo no lo sabía y reintentaba a ciegas:
# tres intentos en 50 segundos, y cada uno destruía la sesión guardada. Es el límite del Claude oficial:
# una corrida de agy o de un local no lo mira.
if [[ "$motor" == claude && -f "$LIMITE" ]]; then
  hasta="$(cat "$LIMITE")"
  if [[ "$hasta" =~ ^[0-9]+$ ]] && (( hasta > $(date +%s) )); then
    echo "pa: límite de sesión de la suscripción hasta las $(date -d "@$hasta" '+%H:%M'). No lanzo." >&2
    echo "pa: si creés que ya se liberó: rm $LIMITE" >&2
    exit 76
  fi
  rm -f "$LIMITE"
fi

# --- sesión: limpia por default ---------------------------------------------------------
# Medido: retomar un .session de hace días arranca en 56-83k tokens de contexto; arrancar
# limpio (sin MCP) cuesta ~15k. Y las tareas ya se escriben autocontenidas. Así que el resume
# es opt-in (--seguir), no el default como era antes.
sid=""
resume=0
edad_h=""
# `<slug>.session` es UN casillero por proyecto: con dos corridas en el mismo repo, la que
# termina última lo pisa y un `--seguir` retoma la conversación EQUIVOCADA. Pasó el 2026-09-12:
# la corrida que había que cerrar (salió 78, sin commitear) quedó tapada por la siguiente, y
# cerrarla costó una corrida nueva de US$2,5 en vez de un resume de centavos. Con
# `--seguir --id <corrida>` se retoma esa corrida exacta, leyendo su sid del `<ts>.sid`.
if (( seguir )) && [[ -n "$run_id" ]]; then
  [[ -f "$dir/$run_id.sid" ]] || { echo "pa: no tengo el session_id de la corrida '$run_id' de '$slug' (falta $dir/$run_id.sid)." >&2; exit 1; }
  sid="$(cat "$dir/$run_id.sid")"
  resume=1
  edad_h=$(( ( $(date +%s) - $(stat -c %Y "$dir/$run_id.sid") ) / 3600 ))
elif (( seguir )) && [[ -f "$sfile" ]]; then
  sid="$(cat "$sfile")"
  resume=1
  # medirla ANTES de correr: al guardar el session_id nuevo se pisa el mtime
  edad_h=$(( ( $(date +%s) - $(stat -c %Y "$sfile") ) / 3600 ))
fi
# Caché frío (ver arriba): la sesión no se retoma, pero el puesto y la rama siguen siendo los de la
# corrida que se iba a retomar (`resume` queda en 0 -> sesión nueva, con ficha, y medicion.tsv dice seguir=0).
retoma_trabajo=$resume
if (( frio )); then resume=0; retoma_trabajo=1; fi
# Sesión nueva con id propio: así la ruta del transcript se conoce ANTES de arrancar y
# `workers` no tiene que adivinar qué jsonl está escribiendo el worker (era el bug: cualquier
# jsonl nuevo en ese cwd le ganaba al del worker).
(( resume )) || sid="$(uuidgen)"

# Con --seguir se vuelve al puesto y la rama de la corrida que se retoma (la del --id, o la
# última buena vía `<slug>.session.ts`); una corrida nueva saca rama nueva del HEAD. Se calcula
# ANTES de tomar puesto: el puesto de un --seguir es el de su corrida.
ts_retomada=""
if (( retoma_trabajo )); then
  if [[ -n "$run_id" ]]; then ts_retomada="$run_id"; else ts_retomada="$(cat "$sfile.ts" 2>/dev/null || true)"; fi
  [[ -n "$ts_retomada" ]] || ts_retomada="-"     # sesión guardada sin .ts: tree principal, como antes
fi
# --actualizar: sesión nueva, pero el puesto y la rama son los de esa corrida
[[ -n "$actualizar" ]] && ts_retomada="$actualizar"

# --- claude instalado y sano ----------------------------------------------------------------
# Un `claude --version` cuesta milisegundos y no gasta sesión. En el hijo de --async no se repite
# (el padre acaba de hacerlo, y un hijo que sale antes de tomar el lock no deja .listo); si se
# rompe a mitad de corrida lo agarra el camino 3c de abajo.
if [[ -z "${PA_ASYNC:-}" ]] && ! claude_sano; then
  rc_c="$(claude_rc)"; claude_falla "$rc_c" "$claude_err"
  exit "$rc_c"
fi

# --- async: relanzarse desacoplado y volver ----------------------------------------------
# El Bash tool del orquestador tiene tope de 10 min y al vencer mata al worker a mitad de
# fase. Con --async el pa real vive fuera de esa sesión (setsid) y el resultado se recoge
# después con `pa --esperar`. Reemplaza los scripts `setsid nohup ... EXIT $?` escritos a mano.
if [[ $async -eq 1 ]]; then
  # El $$ no es decorativo: con resolución de un segundo, dos corridas del mismo proyecto
  # en el mismo segundo (una cola de --async, un reintento rápido) escribían el MISMO
  # archivo, y el .ultimo de la primera terminaba apuntando al JSON de la segunda.
  ts="$(date +%Y%m%d-%H%M%S)-$$"
  log="$dir/$ts.log"
  # La marca de "esta corrida es --leer" va ANTES del fork: `pa --esperar --id` la lee para saber
  # que no hay lock que esperar, y puede llegar antes de que el hijo escriba nada.
  (( leer )) && : >"$dir/$ts.leer"
  # El .log también va ANTES del fork. Lo abre el redirect `>"$log"` del hijo, o sea DESPUÉS del
  # fork, mientras que el .pid lo escribe el padre enseguida: un hijo matado en esa ventana
  # (bajo carga, un STOP+KILL apenas aparece el .pid) dejaba un .pid sin .log, y `--esperar --id`
  # contestaba "no existe la corrida" (rc 1) en vez de "murió en cola" (82).
  : >"$log"
  hijo_args=( "$proyecto" -m "$modelo" )
  (( leer ))    && hijo_args+=( --leer )
  (( seguir ))  && hijo_args+=( --seguir )
  (( con_mcp )) && hijo_args+=( --mcp )
  # `--max-turns` va SIEMPRE, con 0 si lo apagaron: si no lo mandáramos, el hijo se aplicaría
  # el default y `--max-turns 0` no apagaría nada en async. El hijo mapea 0 -> sin tope.
  hijo_args+=( --max-turns "${max_turns:-0}" )
  [[ -n "$max_budget" ]] && hijo_args+=( --max-budget-usd "$max_budget" )
  [[ -n "$run_id" ]]     && hijo_args+=( --id "$run_id" )
  [[ -n "$actualizar" ]] && hijo_args+=( --actualizar "$actualizar" )
  (( sucio_mio ))        && hijo_args+=( --sucio-mio )
  (( aca ))              && hijo_args+=( --aca )
  (( force ))            && hijo_args+=( --force )
  [[ -n "$tipo" ]]       && hijo_args+=( --tipo "$tipo" )
  (( ok_dueno ))         && hijo_args+=( --ok-dueno )
  [[ -n "$cuenta" ]]     && hijo_args+=( --cuenta "$cuenta" )
  hijo_args+=( -- "$tarea" )
  # De quién es la corrida, ANTES del fork: mientras espera en cola no tiene `.corrida`, y
  # `--esperar` pelado necesita saber si es de su jefe para esperarla (y no cobrarle la del otro).
  jefe_async="$(jefe_nombre)"; jefe_id_async="$(jefe_id)"
  (( leer )) || printf 'jefe=%s\njefe_id=%s\n' "$jefe_async" "$jefe_id_async" >"$dir/$ts.jefe"
  PA_TS="$ts" PA_JEFE="$jefe_async" PA_JEFE_ID="$jefe_id_async" PA_ASYNC=1 PA_REPARTO_TIPO="$reparto_tipo_relanzable" setsid nohup "$0" "${hijo_args[@]}" >"$log" 2>&1 &
  lanzado=$!
  disown || true
  # El pid del hijo, ya: mientras espera en cola (`flock 9` bloqueante, más abajo) es la ÚNICA
  # señal de que sigue vivo. Si lo matan minutos después (no en los ~100ms que cubre el loop de
  # abajo), `pa` ya volvió hace rato; `--esperar --id`/`--estado` son quienes releen este archivo
  # para notar que el pid se murió sin dejar `.listo`. Se pisa solo si el ts se reusa (no pasa:
  # el ts lleva $$).
  printf '%s' "$lanzado" >"$dir/$ts.pid"
  # No volvemos hasta que el hijo tenga puesto (o esté en cola). Si volvemos antes, un
  # `pa --esperar` pegado atrás puede no ver todavía nada vivo de esta corrida y decir "nada
  # pendiente". Señales, todas escritas por el hijo: `$ts.puesto` (tomó puesto, antes de
  # cualquier git), `$ts.cola` (sin puesto libre o con el tope global lleno: espera), `$ts.listo`
  # (ya terminó).
  # El kill -0 va primero: un hijo que se muere antes de dejar ninguna se ve acá.
  murio=0
  for _ in $(seq 100); do
    kill -0 "$lanzado" 2>/dev/null || { murio=1; break; }  # el hijo murió (en cola o al arrancar)
    [[ -f "$dir/$ts.listo" ]] && break
    if (( leer )); then
      # --leer no toma puesto: la señal de "arrancó" es su .running (con el pid del claude ya
      # puesto, para que un --matar inmediato lo encuentre).
      [[ -n "$(leer_campo "$STATE/$slug.leer-$ts.running" pid)" ]] && break
      [[ -f "$dir/$ts.cola" ]] && break   # tope global lleno: espera lugar
    else
      [[ -f "$dir/$ts.puesto" || -f "$dir/$ts.cola" ]] && break
    fi
    sleep 0.1
  done
  # `kill -0` solo no alcanza: un hijo que ya tomó puesto, corrió y salió (rápido, <0.1s)
  # se ve idéntico a uno que nunca llegó a tomarlo. El `.listo` lo escribe el trap de EXIT
  # SOLO después de tomar puesto (ver más abajo), así que su ausencia sí distingue "murió
  # antes de arrancar" de "terminó normal y ya se fue".
  if (( murio )) && [[ ! -f "$dir/$ts.listo" ]]; then
    if (( leer )); then echo "pa: '$slug' (id: $ts) murió antes de arrancar. Mirá el log: $log" >&2
    else echo "pa: '$slug' (id: $ts) murió antes de tomar el lock de un puesto. Mirá el log: $log" >&2; fi
    exit 1
  fi
  if (( ! leer )); then
    if [[ -f "$dir/$ts.puesto" ]]; then
      pst="$(cat "$dir/$ts.puesto")"
      avisar_paralelo "$ts" "$pst"
      [[ "$pst" == aca ]] && pst="el tree principal" || pst="el puesto $pst"
      echo "pa: '$slug' lanzado en background en $pst (id: $ts, log: $log)."
    elif [[ -f "$dir/$ts.cola" ]]; then
      echo "pa: '$slug' lanzado en background, EN COLA: $(cat "$dir/$ts.cola") (id: $ts, log: $log). Arranca solo cuando se libere."
    else
      echo "pa: '$slug' lanzado en background (id: $ts, log: $log)."
    fi
  elif [[ -f "$dir/$ts.cola" ]]; then
    echo "pa: '$slug' lanzado en background, EN COLA: $(cat "$dir/$ts.cola") (id: $ts, log: $log). Arranca solo cuando se libere."
  else
    echo "pa: '$slug' lanzado en background (id: $ts, log: $log)."
  fi
  echo "pa: para esperarlo: pa --esperar '$proyecto' --id $ts"
  exit 0
fi

# --- puesto -----------------------------------------------------------------------------
# Dos pa en el mismo worktree se pisan (mismo repo, y si resumen, el mismo session_id): cada
# writer toma un PUESTO (ver tomar_puesto). En primer plano, sin puesto libre sale 75; con
# --async hace cola en vez de fallar.
# El $$ no es decorativo: con resolución de un segundo, dos corridas del mismo proyecto
# en el mismo segundo (una cola de --async, un reintento rápido) escribían el MISMO
# archivo, y el .ultimo de la primera terminaba apuntando al JSON de la segunda.
# Con --async el padre ya eligió el ts (es el id que imprimió); el hijo lo hereda para que
# `--esperar --id` encuentre el .listo. Va ANTES del lock porque la rama del worktree lo lleva.
ts="${PA_TS:-$(date +%Y%m%d-%H%M%S)-$$}"
# gemini.sin_claude=esperar (sólo el hijo de --async llega acá): cola SIN puesto ni lugar del tope,
# mirando el cupo cada PA_GEMINI_ESPERA_S (300 s) hasta PA_GEMINI_ESPERA_MAX_MIN (720). `$ts.cola` dice
# por qué (lo leen --estado y el padre). Si el motivo pasa a ser fijo o se vence el plazo, sale 96.
if (( gemini_esperar )); then
  g_ini="$SECONDS"
  while [[ -n "$motivo_cae" ]]; do
    if [[ "$clase_cae" != cupo ]] || (( SECONDS - g_ini >= ${PA_GEMINI_ESPERA_MAX_MIN:-720} * 60 )); then
      rm -f "$dir/$ts.cola"
      echo "pa: $modelo no está disponible ($motivo_cae) y modelos.json dice gemini.sin_claude=esperar: dejo de esperar, no caigo a Claude." >&2
      exit 96
    fi
    cola_clase=""; escribir_cola "gemini: $motivo_cae; espera cupo (gemini.sin_claude=esperar)"
    sleep "${PA_GEMINI_ESPERA_S:-300}"
    gemini_chequear "$modelo"
  done
  rm -f "$dir/$ts.cola"
fi
# sin_cupo=esperar con todo lleno (sólo el hijo de --async llega acá): cola SIN puesto ni lugar del tope,
# preguntándole a reparto cada PA_GEMINI_ESPERA_S (300 s) hasta que haya un candidato con cupo; a los
# PA_GEMINI_ESPERA_MAX_MIN (720) sale 96. Si el candidato cambió, corre con ése.
if [[ -n "$reparto_esperar" && -n "$reparto_tipo_relanzable" && -x "$REPARTO" ]]; then
  r_ini="$SECONDS"
  while :; do
    rep_json="$(REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE"       timeout "${PA_REPARTO_TIMEOUT_S:-15}" "$REPARTO" --tipo "$reparto_tipo_relanzable" --json 2>/dev/null </dev/null)" || rep_json=""
    m_rep=""; e_rep=""
    [[ -n "$rep_json" ]] && IFS='|' read -r m_rep e_rep < <(jq -r '[(.modelo // ""), (.effort // "")] | join("|")' <<<"$rep_json" 2>/dev/null) || true
    [[ -n "$m_rep" && "$(jq -r '.todo_lleno // false' <<<"$rep_json" 2>/dev/null)" != true ]] && break
    if (( SECONDS - r_ini >= ${PA_GEMINI_ESPERA_MAX_MIN:-720} * 60 )); then
      rm -f "$dir/$ts.cola"
      echo "pa: sigue sin haber cupo para $reparto_tipo_relanzable y modelos.json dice sin_cupo=esperar: dejo de esperar." >&2
      exit 96
    fi
    cola_clase=""; escribir_cola "sin cupo: todo lleno para $reparto_tipo_relanzable; espera cupo (sin_cupo=esperar)"
    sleep "${PA_GEMINI_ESPERA_S:-300}"
  done
  rm -f "$dir/$ts.cola"
  if [[ "$m_rep" != "$modelo" ]] && ! es_local "$m_rep"; then
    echo "pa: volvió el cupo: corro con $m_rep${e_rep:+ effort $e_rep} (reparto)." >&2
    modelo="$m_rep"; esfuerzo=""; unset PA_EFFORT
    if es_gemini "$modelo"; then
      gemini_chequear "$modelo"
      if [[ -n "$motivo_cae" ]]; then
        read -r m_eq e_eq <<<"$(gemini_equivalente "$modelo")"
        echo "pa: $modelo → $m_eq effort $e_eq: $motivo_cae." >&2
        gemini_pedido="$modelo"; modelo="$m_eq"; esfuerzo="$e_eq"; export PA_EFFORT="$e_eq"; motor=claude; ef_vacio=""
      else
        motor=agy; ef_vacio="-"
      fi
    elif es_codex "$modelo"; then
      codex_chequear "$modelo"
      if [[ -n "$motivo_cae" ]]; then
        read -r m_eq e_eq <<<"$(codex_equivalente "$modelo")"
        echo "pa: $modelo → $m_eq effort $e_eq: $motivo_cae." >&2
        gemini_pedido="$modelo"; modelo="$m_eq"; esfuerzo="$e_eq"; export PA_EFFORT="$e_eq"; motor=claude; ef_vacio=""
      else
        motor=codex; ef_vacio="-"
      fi
    else
      motor=claude; ef_vacio=""
      [[ -n "$e_rep" ]] && { esfuerzo="$e_rep"; export PA_EFFORT="$e_rep"; }
    fi
  fi
fi
# Para el `.hilo`: la tarea como la escribió el jefe (abajo se le suman avisos o se reemplaza con
# la de --actualizar) y quién lanzó (PA_ORIGEN: `app`, `nightloop`…; default `jefe`).
tarea_jefe="$tarea"
lanzo="${PA_ORIGEN:-jefe}"; [[ "$lanzo" =~ ^[a-z0-9_-]+$ ]] || lanzo=jefe

tengo_lock=0
puesto=""
if (( leer )); then
  # --leer NO toma el lock del proyecto. El lock existe por el worktree único y por el estado
  # por proyecto (.running, .heartbeat, .ultimo, .session), y un --leer no escribe en el repo ni
  # toca nada de eso: su estado va por corrida (`<slug>.leer-<ts>.running`, `<ts>.listo`,
  # `<ts>.sid`). Así corre en paralelo con el worker que escribe y con otros --leer.
  # `run` y `hb` propios, ANTES de armar settings_json (que lleva el hb adentro).
  run="$STATE/$slug.leer-$ts.running"
  hb="$STATE/$slug.leer-$ts.heartbeat"
  # Puesto no, pero lugar del tope global sí (un --leer también es un claude entero en RAM). Va
  # antes de la marca `.leer`: en primer plano con el tope lleno sale 75 sin dejar nada.
  esperar_lugar
  : >"$dir/$ts.leer"
  # Sin lock nadie limpia el .running de un --leer que murió a lo bruto (kill -9): cada --leer
  # barre los muertos de su proyecto, y así --estado no los muestra como HUÉRFANO para siempre.
  for f_run in "$STATE/$slug".leer-*.running; do
    [[ -f "$f_run" ]] || continue
    vivo "$f_run" || rm -f "$f_run" "${f_run%.running}.heartbeat" "${f_run%.running}.heartbeat.turnos"
  done
else
  tomar_puesto
fi

limpiar() { rm -f "$run" "$hb" "$hb.turnos"; }
rm -f "$hb.turnos"
# TODO camino de salida de acá para abajo tiene que dejar el .ultimo. Si no lo deja, el
# `pa --esperar` que está bloqueado en el lock lee el .ultimo de la corrida ANTERIOR y
# devuelve un resultado viejo con rc=0, como si esta corrida hubiera salido bien. Pasaba
# con 76 (límite de sesión) y con 77. Por eso se escribe en el trap de EXIT y no en cada
# `exit`: el próximo camino de salida que agreguemos ya queda cubierto solo.
# Sólo desde que tenemos el lock: antes, escribirlo pisaría el resultado del worker que
# SÍ está corriendo ahí.
al_salir() {
  local rc=$?
  # la hora de muerte exacta, antes de todo lo demás (medir y el tablero tardan)
  anotar_fin "$dir" "$ts" 2>/dev/null || true
  # .ultimo (un casillero por proyecto) lo lee `workers ultimo`. El .listo por corrida es lo
  # que entrega `pa --esperar`: con dos --async encolados el casillero único se pisaba y un
  # resultado salía dos veces mientras el otro no salía nunca (BUGS.md, 2026-09-09).
  # Sólo las corridas --async dejan .listo: un pa en primer plano ya entregó su resultado por
  # stdout, y si dejara uno, un --esperar posterior lo devolvería como si fuera nuevo.
  # Los dos atómicos (tmp + mv): con puestos, dos writers del mismo proyecto pueden terminar a la
  # vez, y un `--esperar --id` sondea el .listo y no puede leerlo a medio escribir.
  # Medir PRIMERO: el .listo es la señal de "terminó" que mira `--esperar`, y antes salía sin
  # la fila de medicion.tsv todavía escrita (review 2026-09-30 #13).
  # `out` existe desde que se armó la corrida: antes de eso no se lanzó nada que medir.
  [[ -n "${out:-}" ]] && { medir "$out" 2>/dev/null || true; }
  [[ -n "${out:-}" ]] && { anotar_decision "$out" 2>/dev/null || true; }
  # El puesto queda libre: su build (target-wt/ y cía.) se va, ANTES del .ultimo/.listo (un
  # --integrar justo después del --esperar necesita el puesto suelto). `|| true`: con set -e, un
  # rm que falle acá mataba el trap sin .ultimo.
  (( tengo_lock && usa_worktree )) && { limpiar_build "$ruta_trabajo" 2>/dev/null || true; }
  local linea; linea="$(printf 'salida=%s\nrc=%s\nsid=%s' "${out:-}" "$rc" "${sid:-}")"
  if (( tengo_lock )); then
    printf '%s\n' "$linea" >"$ult.tmp.$$" && mv -f "$ult.tmp.$$" "$ult"
    [[ -n "${PA_ASYNC:-}" ]] && printf '%s\n' "$linea" >"$dir/$ts.listo.tmp" && mv -f "$dir/$ts.listo.tmp" "$dir/$ts.listo"
  elif (( leer )) && [[ -n "${PA_ASYNC:-}" ]]; then
    # --leer: sin lock ni .ultimo (es del que escribe). Sólo el .listo por corrida, atómico
    # (un `--esperar --id` lo sondea y no puede leerlo a medio escribir).
    printf 'salida=%s\nrc=%s\nsid=%s\n' "${out:-}" "$rc" "${sid:-}" >"$dir/$ts.listo.tmp" \
      && mv -f "$dir/$ts.listo.tmp" "$dir/$ts.listo"
  fi
  limpiar
  # último: cuando la app ve el `fin`, el .listo/.ultimo y la fila de medicion.tsv ya están. El
  # puesto se suelta ANTES (ya no queda nada suyo que tocar): un `pa` en primer plano pegado al
  # `--esperar` que leyó el .listo encontraba el puesto tomado mientras corría el jq y salía 75.
  # El lugar del tope global (fd 6) se suelta con él.
  exec 9>&- 6>&-
  # el tablero después de todo lo que alguien espera (.listo, puesto): si tarda, no frena a nadie
  [[ -n "${out:-}" ]] && { anotar_tablero 2>/dev/null || true; }
  [[ -n "${evento_inicio:-}" ]] && evento fin "$ts" "$slug" "$rc"
  return 0
}
# TERM/INT: bajar al claude con nosotros. Sin esto, matar a pa dejaba el claude corriendo.
al_matar() {
  # Ignorar (no `trap -`) los que sigan llegando: con la señal en default, un segundo TERM
  # mataba al pa a mitad de esto y sin su trap de EXIT, o sea sin .ultimo.
  trap '' TERM INT
  # El árbol entero, no sólo $hijo: $hijo es el launcher bash de claude, y matarlo a él solo
  # deja al claude.exe huérfano trabajando (ver matar_arbol).
  local quedan=""
  [[ -n "${hijo:-}" ]] && { quedan="$(matar_arbol "${sid:-}" "" "$hijo")" || true; }
  if [[ -n "$quedan" ]]; then
    echo "pa: matado, pero del worker de '$slug' siguen vivos: $(echo $quedan)." >&2
  else
    echo "pa: matado; el worker de '$slug' también." >&2
  fi
  exit 130
}
trap al_salir EXIT
trap al_matar TERM INT

# --- worktree ---------------------------------------------------------------------------
preparar_worktree "$ts_retomada" "$puesto" || exit $?
(( leer )) || avisar_paralelo "$ts" "$puesto"

# El lock serializa a los workers en el TIEMPO, pero todos comparten UN working tree. Un worker
# que murió sin commitear (o una sesión `p` del dueño) le deja archivos ajenos al siguiente, que
# no tiene forma de saber cuáles son suyos: el 2026-09-12 uno se negó a commitear la mitad de
# su propio trabajo para no bundlear el del anterior. No falla, avisa: el worker necesita saber
# qué había antes de él.
# Con --seguir NO va: un resume continúa su propia corrida, y los archivos sucios son los
# que dejó él mismo. Decirle "no son tuyos, no los commitees" es justo lo contrario de lo que
# hay que hacer para cerrar un worker que murió sin commitear. --sucio-mio hace lo mismo para
# una tarea de cierre escrita de cero.
sucios_base=""
sucios_previos=0
if ! (( seguir || sucio_mio || leer )); then
  sucios_base="$(sucios_de "$ruta")"
  sucios_previos="$(contar_lineas "$sucios_base")"
fi
# Lo que se le compara al worker al terminar: en el worktree el baseline es vacío (arrancó
# limpio); en el tree principal, lo que había.
base_delta="$sucios_base"; (( usa_worktree )) && base_delta=""
if (( sucios_previos > 0 )) && (( usa_worktree )); then
  # El worker no lo ve (está aislado), pero el jefe sí tiene que saberlo: si la rama toca
  # esos archivos, `--integrar` se va a negar hasta que el dueño decida qué hacer con ellos.
  echo "pa: el tree principal de '$slug' tiene $sucios_previos archivo(s) sin commitear$(edad_sucios "$ruta" "$sucios_base"). El worker no los ve: trabaja aislado en su worktree." >&2
elif (( sucios_previos > 0 )); then
  tarea="$tarea

AVISO DEL ORQUESTADOR: cuando arrancaste, el repo YA tenía $sucios_previos archivos sin commitear
de otra sesión. No son tuyos:
$(printf '%s\n' "$sucios_base" | sed -n '1,20s/^/  /p')
No los toques ni los metas en tus commits: commiteá SOLO los archivos que tocaste vos, uno por
uno. Si tu cambio cae encima de uno de esos, trabajá arriba de lo que hay y decilo en DECISION
en vez de bundlearlo o revertirlo."

  # Y avisarle al JEFE, no sólo al worker. Hasta el 2026-09-13 el baseline sólo viajaba adentro
  # del prompt: el orquestador nunca se enteraba de que el repo tenía trabajo huérfano, así que
  # (a) cada worker gastaba turnos haciendo cirugía con `git add -p` en vez de `git add <archivo>`
  # y (b) al morir uno, el jefe leía "N archivos sin commitear" y narraba lo ajeno como trabajo
  # perdido del worker. En widgets-reactivos había dos archivos sucios desde hacía OCHO días.
  # Sólo informa: qué hacer con ellos lo decide el dueño.
  echo "pa: '$slug' arranca SUCIO: $sucios_previos archivo(s) sin commitear que NO son de este worker$(edad_sucios "$ruta" "$sucios_base")." >&2
  echo "    Los va a esquivar, y gastar turnos en eso. Si es trabajo huérfano: commitealo, mandalo a una rama, o tiralo." >&2
fi


transcript="$PROJ/$(escapar "$ruta_trabajo")/$sid.jsonl"
# `claude --resume` busca el transcript bajo la carpeta de proyecto del cwd. Un --seguir de una
# corrida integrada/descartada corre en el tree principal, pero su transcript quedó bajo la del
# worktree: sin esto el CLI contestaba "No conversation found" y pa arrancaba una sesión limpia
# (contexto perdido, sin más aviso). Un symlink: el resume sigue escribiendo en el MISMO archivo.
if (( resume )) && [[ ! -e "$transcript" ]]; then
  for f in "$PROJ"/*/"$sid.jsonl"; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    mkdir -p "${transcript%/*}" && ln -s "$f" "$transcript" 2>/dev/null \
      && echo "pa: el transcript de la sesión vivía en ${f%/*}; lo enlacé para retomarla desde $ruta_trabajo." >&2
    break
  done
fi

# --- hooks propios del worker -----------------------------------------------------------
# Se inyectan con --settings (JSON inline). Escriben el latido que lee `workers` y bloquean
# `git stash` / `git add -A`. El destructive-guard va explícito acá también: --settings se
# mergea con ~/.claude/settings.json, pero repetirlo no cuesta nada y no depende de eso.
# En --leer el latido recibe además "leer": ahí es el que deja pasar sólo git de lectura por Bash.
# enabledPlugins: el plugin caveman apagado para el worker (2026-10-10). Su hook de arranque le
# cargaba el ruleset y las descripciones de sus skills en cada corrida, y la prosa de un worker no
# la lee nadie: sólo el bloque RESULTADO. Va por --settings, sin tocar ~/.claude/settings.json (ahí
# sigue prendido para las sesiones del dueño). Es el mismo settings_json de writers, --leer,
# --seguir, --aca y el auto-cierre. Medido con scripts/medir-plugin.sh (docs/modelos-effort-plan-y-ahorro.md).
modo_latido=""; (( leer )) && modo_latido=" leer"
settings_json="$(jq -cn --arg latido "$LATIDO" --arg guard "$GUARD" --arg hb "$hb" --arg modo "$modo_latido" --arg home "$HOME" '
  {crossSessionInbound: "accept",
   claudeMdExcludes: [($home + "/CLAUDE.md")],
   enabledPlugins: {"caveman@caveman": false},
   hooks: {
     PreToolUse: [ {matcher: "Bash", hooks: [ {type:"command", command:("bash " + $guard)} ]},
                   {hooks: [ {type:"command", command:("bash " + $latido + " " + $hb + " pre" + $modo)} ]} ],
     PostToolUse: [ {hooks: [ {type:"command", command:("bash " + $latido + " " + $hb + " post")} ]} ]
   }}')"

# --- --actualizar: la tarea es fija --------------------------------------------------------
if [[ -n "$actualizar" ]]; then
  sha_main="$(git -C "$ruta" rev-parse HEAD)"; rama_main="$(git -C "$ruta" rev-parse --abbrev-ref HEAD)"
  extra="$tarea"
  tarea="Actualizá tu rama $rama: rebaseala sobre $sha_main (el HEAD actual de $rama_main del tree principal) con \`git rebase $sha_main\`.
Mientras tanto entraron a $rama_main cambios de otros workers que tocan lo mismo que vos, y el jefe no pudo integrarla sin conflictos.
Si el rebase choca: mirá los dos lados (lo tuyo y lo que entró: \`git log -p $base..$sha_main -- <archivo>\`), resolvé ENTENDIENDO los dos cambios (no te quedes con uno solo a ciegas), \`git add <archivo>\` y \`git rebase --continue\`. Nunca \`git rebase --skip\` sobre un commit tuyo.
Después corré los tests del proyecto (si los hay) y arreglá lo que se haya roto. Commiteá archivo por archivo.
En RESULTADO decí qué conflictos hubo y cómo los resolviste. Si no pudiste, \`git rebase --abort\` y explicá por qué en DECISION."
  [[ -n "$extra" ]] && tarea+=$'\n\n'"Contexto del jefe: $extra"
  # la rama va a quedar sobre este HEAD: la base de la corrida original pasa a ser ésa
  c_orig="$dir/$actualizar.corrida"
  sed "s/^base=.*/base=$sha_main/" "$c_orig" >"$c_orig.tmp" && mv -f "$c_orig.tmp" "$c_orig"
fi

# --- armado de la llamada ---------------------------------------------------------------
# armar_llamada: contrato, prompt y args según `modelo`/`motor`. Es función porque un 429 de agy relanza la corrida
# con otro modelo (otro motor, a veces) y hay que rearmarlo todo.
armar_llamada() {
jefe="$(jefe_nombre)"; jefe_ident="$(jefe_id)"
# Un Gemini no tiene SendMessage: corre como sin jefe (pregunta en DECISION).
if [[ "$motor" == agy ]]; then contrato="$CONTRATO_AGY"$'\n'"$SIN_JEFE"
elif [[ "$motor" == codex ]]; then contrato="$CONTRATO_CODEX"$'\n'"$SIN_JEFE"
elif [[ -n "$jefe" ]]; then contrato="$CONTRATO"$'\n'"$(con_jefe "$jefe")"; else contrato="$CONTRATO"$'\n'"$SIN_JEFE"; fi
contrato="$(D "$contrato")"
# Orientación, no aislamiento (el aislamiento ya es estructural): un worker que ve una rama rara
# en `git log` puede intentar `git checkout main` (falla: está en el tree principal) y gastar turnos.
if [[ -n "$actualizar" ]]; then
  contrato+=$'\n'"Estás en la rama $rama de un worktree propio ($ruta_trabajo). Tu tarea es rebasearla: \`git rebase $sha_main\` está AUTORIZADO, igual que \`git add <archivo>\`, \`git rebase --continue\` y \`git rebase --abort\`. No cambies a otra rama, no mergees, no toques el tree principal: integra el jefe. Los editores de git están apagados (GIT_EDITOR=true): el mensaje de cada commit queda como estaba."
elif (( usa_worktree )); then
  contrato+=$'\n'"Estás en la rama $rama de un worktree propio ($ruta_trabajo), sacada del HEAD del tree principal del proyecto. Commiteá ahí, archivo por archivo. No cambies de rama, no mergees, no toques el tree principal: integra el jefe."
fi
# El mapa de interconexiones está partido en un archivo por proyecto (bin/mapa-partir): el worker
# toca SÓLO el suyo, con el slug real en la ruta. Sin archivo (proyecto sin bloque, o MAPA todavía
# sin partir) no se dice nada. PA_MAPA_DIR: sólo para los tests.
mapa_proy="${PA_MAPA_DIR:-$HOME/Proyectos/mapa}/$slug.md"
if (( ! leer )) && [[ -z "$actualizar" && -f "$mapa_proy" ]]; then
  contrato+=$'\n'"Si tu cambio modificó lo que este proyecto expone, consume o escribe para OTROS proyectos (CLIs, puertos, archivos compartidos, units), actualizá su bloque del mapa en $mapa_proy y poné la fecha de hoy en su \`verificado:\`. Sólo ese archivo: no abras ~/Proyectos/MAPA.md (es un índice generado) ni los bloques de otros proyectos. Si no cambió nada de eso, no lo toques."
fi
# En paralelo con otros writers del mismo proyecto (puestos): que sepa con quién comparte el repo.
if (( ! leer )); then
  paralelos="$(otros_writers "$ts" | while IFS=$'\t' read -r o_id o_p o_j o_t; do printf -- '- %s (%s): %.120s\n' "$o_id" "$([[ "$o_p" == aca ]] && echo 'tree principal' || echo "puesto $o_p")" "$o_t"; done)"
  if [[ -n "$paralelos" ]]; then
    contrato+=$'\n'"En este mismo proyecto están corriendo AHORA otros workers, cada uno en su worktree y su rama:
$paralelos
Comparten con vos el target de cargo, node_modules/.venv y lo que corra en la máquina (puertos, bases locales). No mates procesos que no lanzaste vos. Un puerto ocupado o un \"Blocking waiting for file lock\" de cargo puede ser el otro: esperá y reintentá, no lo 'arregles'. No instales ni saques dependencias (un hook lo bloquea): si hace falta, decilo en DECISION. No coordines con ellos ni toques sus ramas: si tocan lo mismo, se resuelve al integrar."
  fi
fi
(( leer )) && contrato+=$'\n'"Modo LECTURA: no escribís nada. Bash existe SOLO para git de lectura (log, diff, show, status, rev-list, rev-parse, merge-base, ls-files, ls-tree, blame, shortlog, describe, cat-file, grep, branch --list, worktree list, stash list/show), con -C <ruta> en vez de cd, y a lo sumo un pipe a head/tail/grep/wc/cut. Nada de ;, &&, redirecciones ni \$(...): un hook bloquea todo lo demás."
# Plan pro: el worker gasta lo mínimo. Lo que más pesa en una corrida no es lo que escribe sino lo
# que RELEE: cada turno reenvía todo el contexto, así que cada archivo leído de más y cada salida
# de comando sin filtrar se paga una vez por cada turno que queda.
[[ "$PLAN" == pro ]] && contrato+=$'\n'"Modo ahorro (la suscripción es chica): leé SOLO lo que la tarea necesita; si te dieron rutas, empezá por ahí y no recorras el repo. Buscá con Grep/Glob antes de abrir archivos enteros, y leé rangos (offset/limit) en archivos largos. Filtrá la salida de los comandos (\`| tail -n 40\`, \`| grep -E 'FAIL|error'\`): todo lo que entra al contexto se vuelve a pagar en cada turno. Verificá con el test más acotado que pruebe tu cambio, no la suite entera, salvo que la tarea lo pida. No lances subagentes. Si la tarea resulta mucho más grande de lo que pinta, hacé la parte que cierra, commiteala y decí en DECISION cómo partir el resto."
# Abanico de Haikus (2026-10-09): en plan max el worker sí tiene Agent. Demo de Anthropic: Opus solo
# 3 min / 25 intentos; Opus + 10 Haiku <1 min / 86 intentos y un tercio del costo.
if [[ "$PLAN" != pro && "$motor" == claude ]] && (( ! leer )); then
  contrato+=$'\n'"Abanico de Haikus: cuando muchos intentos verificables valen más que uno pensado (buscar algo que un grep no encuentra, revisar muchos archivos o candidatos, probar variantes contra un test o chequeo), repartilo en paralelo entre subagentes (Agent con model \"haiku\" y effort xhigh si se puede; hasta ~10, un pedazo cada uno, que devuelvan algo verificable) y verificá vos. No para diseño, decisiones ni código donde un intento malo cuesta caro. Esos subagentes no son delegar: siguen siendo tu trabajo."
fi
# El nombre con el que el jefe le escribe (SendMessage). Con puestos hay varios writers por proyecto:
# el del puesto 1 sigue siendo `pa/<slug>`, el k es `pa/<slug>@k` y el del tree principal `pa/<slug>@aca`.
nombre_worker="pa/$slug"; (( leer )) || nombre_worker+="$(suf_puesto "$puesto")"
# La ficha del proyecto (commit, ramas sin integrar, sigue, qué espera del dueño, últimas corridas):
# el worker arranca sabiendo dónde quedó. Va en la TAREA y no en el contrato: cambia de una
# corrida a la otra, y el contrato es system prompt (prefijo del cache: un --seguir lo
# reescribiría entero). Un resume ya trae su contexto: no se le manda. Sin tablero, si falla, si
# tarda más de 2 s o si no dice nada: se omite, sin aviso. A un Gemini no se le manda: son los
# pendientes y esperas personales del dueño, y lo que va a Google no se recupera.
prompt="$tarea"
if (( ! resume )) && [[ "$motor" != agy && "$motor" != codex ]]; then
  ficha="$(tablero_mudo 2 ficha "$slug" --corta)" || ficha=""
  if [[ -n "$ficha" ]]; then prompt+=$'\n\n'"Dónde quedó este proyecto:"$'\n'"$ficha"; fi
fi
args=( -p "$prompt"
       --model "${local_modelo:-$modelo}"
       ${esfuerzo:+--effort "$esfuerzo"}
       --output-format json
       --append-system-prompt "$contrato"
       --permission-mode bypassPermissions
       --autocompact "$AUTOCOMPACT"
       --settings "$settings_json"
       --name "$nombre_worker" )
# --autocompact (180000 o PA_AUTOCOMPACT): con la ventana de 1M por default el worker no compactaba
# nunca y 20 de 185 corridas pasaron los 200k por turno. Hasta 2026-09 el motivo era el recargo
# long-context (input al doble arriba de 200k); desde los modelos 5.5 ese recargo no existe, y el
# motivo es el volumen: cada turno relee todo el contexto.

# Los MCP de claude.ai (Gmail, Calendar, Drive, Notion, Spotify, IBKR, S&P: ~100 tools) van
# apagados porque hacen que --leer NO sea de lectura: un worker "de sólo lectura" con Notion
# y Gmail conectados puede mandar un mail o editar una página. Lo que pesan en contexto
# varía (125k el 2026-09-07 a las 12:45, 3k a las 15:50) según si el CLI difiere los schemas
# de las tools, y eso no lo manejamos nosotros: no es el motivo. --mcp los devuelve.
if (( ! con_mcp )); then
  args+=( --strict-mcp-config --mcp-config '{"mcpServers":{}}' )
fi

# En modo lectura le sacamos las herramientas de escritura en vez de confiar en que se porte
# bien. Bash va, pero atado: `hooks/latido.sh ... leer` sólo deja pasar git de lectura (allowlist,
# no denylist). Sin Bash no había git, los objetos de git están comprimidos y Read/Grep no los
# tocan: `pa --leer 'auditá la rama X'` —la receta de NightLoop del ~/CLAUDE.md— nunca anduvo.
(( leer )) && args+=( --tools "Read,Grep,Glob,Bash,ToolSearch,ListAgents,SendMessage" )
# Plan pro: sin subagentes. Cada uno arranca en frío (system prompt, tools, CLAUDE.md) y en una
# suscripción chica el total de tokens es lo que importa, no el contexto del worker.
(( ! leer )) && [[ "$PLAN" == pro ]] && args+=( --disallowedTools "Agent" )
# Plan pro: latido.sh recorta la salida de los tests a las últimas 150 líneas (ver el hook).
if [[ "$PLAN" == pro ]]; then export PA_RECORTE="${PA_RECORTE:-150}"; else export PA_RECORTE=0; fi
[[ -n "$max_turns" ]]  && { args+=( --max-turns "$max_turns" ); export PA_MAX_TURNS="$max_turns"; }
[[ -n "$max_budget" ]] && args+=( --max-budget-usd "$max_budget" )
(( resume )) && args+=( --resume "$sid" ) || args+=( --session-id "$sid" )

# --- armado de la llamada a agy (Gemini) ---------------------------------------------------
# agy no tiene system prompt por flag ni lee CLAUDE.md (sí AGENTS.md/GEMINI.md): el contrato, el
# ~/.claude/CLAUDE.md del dueño y el CLAUDE.md del proyecto van adelante de la tarea. Los hooks y
# las skills los pone el plugin pa-worker (ver hooks/agy-pa.sh); acá van por entorno los datos que
# el adaptador necesita para atar al worker a su worktree.
if [[ "$motor" == agy ]]; then
  prompt_agy="INSTRUCCIONES DEL ORQUESTADOR (valen como system prompt):"$'\n'"$contrato"
  for md in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md" "$ruta_trabajo/CLAUDE.md"; do
    [[ -s "$md" ]] || continue
    prompt_agy+=$'\n\n'"INSTRUCCIONES ($md; valen igual que las de arriba):"$'\n'"$(cat "$md")"
  done
  prompt_agy+=$'\n\n'"TAREA:"$'\n'"$prompt"
  args=( -p "$prompt_agy"
         --model "${modelo#agy:}"
         --output-format stream-json
         --dangerously-skip-permissions
         --print-timeout "${PA_AGY_TIMEOUT:-3600}s" )
  export PA_AGY_HB="$hb" PA_AGY_RAIZ="$ruta_trabajo" PA_AGY_PPAL="$ruta" PA_AGY_RAMA="$rama" PA_AGY_MAPA="$mapa_proy"
  if (( leer )); then export PA_AGY_MODO=leer; else export PA_AGY_MODO=""; fi
  if [[ -n "$actualizar" ]]; then export PA_AGY_REBASE=1; else export PA_AGY_REBASE=0; fi
  transcript="$dir/$ts.stream.jsonl"
fi

# --- armado de la llamada a codex (ChatGPT) ------------------------------------------------
# Como agy: el contrato y los CLAUDE.md van adelante de la tarea (codex lee AGENTS.md, no CLAUDE.md).
# Sandbox de codex: workspace-write (escribe en el worktree y en el .git común, que es donde commitea un
# worktree; sin red) o read-only en --leer. Sin aprobaciones: no hay nadie para contestarlas.
if [[ "$motor" == codex ]]; then
  prompt_cx="INSTRUCCIONES DEL ORQUESTADOR (valen como system prompt):"$'\n'"$contrato"
  for md in "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/CLAUDE.md" "$ruta_trabajo/CLAUDE.md"; do
    [[ -s "$md" ]] || continue
    prompt_cx+=$'\n\n'"INSTRUCCIONES ($md; valen igual que las de arriba):"$'\n'"$(cat "$md")"
  done
  prompt_cx+=$'\n\n'"TAREA:"$'\n'"$prompt"
  cx_base="${modelo#codex:}"
  args=( exec --json
         -m "${cx_base%-*}"
         -c "model_reasoning_effort=\"${modelo##*-}\""
         -c 'approval_policy="never"'
         --sandbox "$( (( leer )) && echo read-only || echo workspace-write)"
         -C "$ruta_trabajo"
         --output-last-message "$dir/$ts.codex-ultimo" )
  if (( ! leer )); then
    cx_git="$(git -C "$ruta_trabajo" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    [[ -n "$cx_git" ]] && args+=( --add-dir "$cx_git" )
    [[ -n "${CARGO_TARGET_DIR:-}" ]] && args+=( --add-dir "$CARGO_TARGET_DIR" )
    [[ -f "$mapa_proy" ]] && args+=( --add-dir "$(dirname "$mapa_proy")" )
  fi
  args+=( "$prompt_cx" )
  transcript="$dir/$ts.stream.jsonl"
fi
}
armar_llamada

out="$dir/$ts.json"
err="$dir/$ts.err"
# El sid de ESTA corrida, para que `--seguir --id $ts` pueda retomarla aunque otra corrida del
# mismo proyecto pise el `<slug>.session` después. Se escribe ya (no en el trap): una corrida
# que muere a mitad es justo la que hay que poder retomar.
printf '%s' "$sid" >"$dir/$ts.sid"
# Dónde corrió y en qué rama: lo leen --seguir (para volver al mismo worktree), --integrar y
# --ramas. Sólo si la corrida es nueva: un resume ya tiene el suyo.
# Un resume graba además `origen=`: el ts de la corrida que sacó la rama, que es el id con el
# que se integra o se descarta (una rama, un id; no uno por cada --seguir).
origen=""; [[ -n "$ts_retomada" && "$ts_retomada" != "-" && -f "$dir/$ts_retomada.corrida" ]] && origen="$(leer_campo "$dir/$ts_retomada.corrida" origen)"
[[ -n "$origen" ]] || origen="${ts_retomada:-}"; [[ "$origen" == "-" ]] && origen=""
# Un --seguir (o --actualizar) sin --tipo hereda el de la corrida que retoma: es la misma tarea.
if [[ -z "$tipo" && -n "$ts_retomada" && -f "$dir/$ts_retomada.hilo" ]]; then
  tipo="$(leer_campo "$dir/$ts_retomada.hilo" tipo)" || tipo=""
  [[ "$tipo" =~ ^($TIPOS_VALIDOS)$ ]] || tipo=""
fi
# `puesto=` (dónde vuelve un --seguir; sin él se deduce de ruta_trabajo) y `jefe=`/`jefe_id=` (de
# quién es: --esperar/--matar/--seguir pelados eligen por jefe_id, el nombre es para SendMessage).
[[ -f "$dir/$ts.corrida" ]] || printf 'ruta_trabajo=%s\nrama=%s\nbase=%s\nproyecto=%s\norigen=%s\nleer=%s\npuesto=%s\njefe=%s\njefe_id=%s\n' \
  "$ruta_trabajo" "$rama" "$base" "$proyecto" "$origen" "$leer" "$puesto" "$jefe" "$jefe_ident" >"$dir/$ts.corrida"

# --- rastro de worker vivo ---------------------------------------------------------------
# El JSON de arriba recién existe cuando el worker termina, así que mientras corre este
# archivo es lo único que dice que hay alguien laburando. Lo lee `workers`.
# pid = el CLAUDE (no pa): con el pid de pa, matar a pa dejaba al claude huérfano quemando
# límite de sesión mientras `workers` lo mostraba como muerto.
inicio="$(date +%s)"
# El registro durable de la corrida (lo lee la app y --bien-auto): la `.corrida` se borra al
# integrar/descartar, el `.hilo` nunca. Al salir se le suman decision/decision_nada/sigue.
[[ -f "$dir/$ts.hilo" ]] || {
  printf 'tarea=%s\nmodelo=%s\neffort=%s\ninicio=%s\nproyecto=%s\nruta_trabajo=%s\nrama=%s\norigen=%s\nleer=%s\npuesto=%s\nlanzo=%s\njefe=%s\njefe_id=%s\ntipo=%s\ncuenta=%s\n' \
    "${tarea_jefe//$'\n'/ }" "$modelo" "${esfuerzo:-${ef_vacio:-settings}}" "$inicio" "$slug" "$ruta_trabajo" "$rama" "$origen" "$leer" "$puesto" "$lanzo" "$jefe" "$jefe_ident" "$tipo" "$cuenta" \
    >"$dir/$ts.hilo"
} 2>/dev/null || true
escribir_running() {
  {
    printf 'pid=%s\n'        "${hijo:-}"
    printf 'pa_pid=%s\n'     "$$"
    printf 'inicio=%s\n'     "$inicio"
    printf 'proyecto=%s\n'   "$slug"
    printf 'id=%s\n'         "$ts"
    printf 'ruta=%s\n'       "$ruta"
    printf 'ruta_trabajo=%s\n' "$ruta_trabajo"
    printf 'rama=%s\n'       "$rama"
    printf 'modelo=%s\n'     "$modelo"
    printf 'cuenta=%s\n'     "$cuenta"
    printf 'leer=%s\n'       "$leer"
    printf 'jefe=%s\n'       "$jefe"
    printf 'jefe_id=%s\n'    "$jefe_ident"
    printf 'puesto=%s\n'     "$puesto"
    printf 'salida=%s\n'     "$out"
    printf 'sid=%s\n'        "$sid"
    printf 'transcript=%s\n' "$transcript"
    printf 'tarea=%s\n'      "${tarea//$'\n'/ }"
  } >"$run"
}
hijo=""
escribir_running
evento inicio "$ts" "$slug"; evento_inicio=1


correr() {
  # 9>&- cierra el fd del lock del puesto en el hijo (y 8>&- el del candado de git, por las dudas;
  # 6>&- el del lugar del tope global, por lo mismo que el 9). El flock se suelta cuando se cierra el ÚLTIMO fd que
  # apunta a esa file description, y el claude se la pasa a todo lo que lanza: un `cargo test`
  # o un `sleep` que sobreviva al worker dejaba el candado tomado y el siguiente `pa` salía 75
  # sobre un proyecto sin nadie trabajando. pa se queda con su fd 9 y sigue siendo el dueño.
  # GIT_EDITOR/GIT_SEQUENCE_EDITOR=true: en headless no hay TTY, y un `git rebase --continue` (o un
  # merge sin -m) abría un editor que nadie iba a cerrar: el worker quedaba colgado hasta el timeout.
  if [[ "$motor" == agy ]]; then
    # El stream crudo va aparte (es el "transcript" de la corrida); el .json se arma al terminar.
    ( cd "$ruta_trabajo" && export PA_WORKER=1 GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true && exec "${cuenta_env[@]}" agy "${args[@]}" ) \
        </dev/null >"$transcript" 2>"$err" 9>&- 8>&- 6>&- 5>&- &
  elif [[ "$motor" == codex ]]; then
    # Los shims de codex/bin van primeros en el PATH: son las guardias de git y cargo (codex no tiene hooks).
    rm -f "$dir/$ts.codex-ultimo"
    ( cd "$ruta_trabajo" && export PA_WORKER=1 GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true PATH="$CODEX_SHIMS:$PATH" && exec codex "${args[@]}" ) \
        </dev/null >"$transcript" 2>"$err" 9>&- 8>&- 6>&- 5>&- &
  elif [[ "$motor" == ollama ]]; then
    # Las ANTHROPIC_* del servidor local, SÓLO en este proceso (regla de facturación: nunca en otro, nunca
    # en settings.json). Los DEFAULT_*_MODEL y el de subagentes también apuntan al local: nada de lo que
    # lance este claude pide un claude-* a un servidor que no lo tiene.
    ( cd "$ruta_trabajo" && export PA_WORKER=1 GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true \
        ANTHROPIC_BASE_URL="$local_url" ANTHROPIC_AUTH_TOKEN=ollama ANTHROPIC_API_KEY="" \
        ANTHROPIC_DEFAULT_OPUS_MODEL="$local_modelo" ANTHROPIC_DEFAULT_SONNET_MODEL="$local_modelo" \
        ANTHROPIC_DEFAULT_HAIKU_MODEL="$local_modelo" CLAUDE_CODE_SUBAGENT_MODEL="$local_modelo" && exec claude "${args[@]}" ) \
        </dev/null >"$out" 2>"$err" 9>&- 8>&- 6>&- 5>&- &
  else
    # La cuenta (cuenta_env: `env -u ANTHROPIC_API_KEY … CLAUDE_CONFIG_DIR=…`) va SÓLO en este proceso.
    ( cd "$ruta_trabajo" && export PA_WORKER=1 GIT_EDITOR=true GIT_SEQUENCE_EDITOR=true && exec "${cuenta_env[@]}" claude "${args[@]}" ) \
        </dev/null >"$out" 2>"$err" 9>&- 8>&- 6>&- 5>&- &
  fi
  hijo=$!
  escribir_running          # ahora sí con el pid del claude
  local rc=0 lat="" t0="$SECONDS"
  if [[ "$motor" == codex ]]; then
    ( while kill -0 "$hijo" 2>/dev/null; do codex_latido; sleep "${PA_CODEX_LATIDO_S:-15}"; done ) </dev/null >/dev/null 2>&1 9>&- 8>&- 6>&- 5>&- &
    lat=$!
  fi
  wait "$hijo" || rc=$?
  hijo=""
  [[ -n "$lat" ]] && { kill "$lat" 2>/dev/null; wait "$lat" 2>/dev/null; }
  if [[ "$motor" == agy ]]; then agy_a_json "$transcript" "$err" "$modelo" "$rc" >"$out" 2>/dev/null || true; fi
  if [[ "$motor" == codex ]]; then codex_a_json "$transcript" "$err" "$modelo" "$rc" "$dir/$ts.codex-ultimo" "$((SECONDS - t0))" >"$out" 2>/dev/null || true; fi
  # Un local: el .json dice motor "ollama" y el modelo de pa (ollama:…), y no cuesta US$ (el CLI no
  # conoce el precio del modelo y podría inventar uno).
  if [[ "$motor" == ollama ]] && jq -e 'type == "object"' "$out" >/dev/null 2>&1; then
    jq --arg m "$modelo" '. + {motor: "ollama", modelo_local: $m, total_cost_usd: 0}' "$out" >"$out.tmp" 2>/dev/null && mv -f "$out.tmp" "$out" || rm -f "$out.tmp"
  fi
  return "$rc"
}

# --- clasificación del fallo -------------------------------------------------------------
# `claude -p` sale con código 1 cuando is_error es true, y el motivo REAL vive en .result del
# JSON, no en stderr (que suele estar vacío). El wrapper viejo trataba cualquier fallo como
# "no pude retomar la sesión": borraba el .session, relanzaba limpio, y volvía a chocar el
# mismo límite. Ocho veces en un día en un proyecto, y cada intento destruyó la sesión guardada.
res_texto() { jq -r '.result // ""' "$out" 2>/dev/null || true; }
es_error()  { [[ "$(jq -r '.is_error // false' "$out" 2>/dev/null)" == "true" ]]; }

rc=0
correr || rc=$?

# --- sin cupo al arrancar: marcar el grupo agotado y relanzar con el siguiente candidato de reparto ----
# agy contesta RESOURCE_EXHAUSTED / "Individual quota reached" cuando el grupo se quedó sin cupo, y los cupos de
# agy son chicos (el grupo Claude/GPT pasó del 26 % a 0 en 2 minutos, más rápido que la caché de /quota). Si pasa
# al arrancar (nada commiteado ni sucio en el worktree) y el modelo lo había elegido reparto (no un -m del jefe),
# `reparto --agotar` marca ese grupo hasta su vuelve y se relanza, en la misma corrida y el mismo id, con lo que
# reparto elige ahora. Hasta 3 veces (cada una agota un grupo distinto).
# Desde 2026-10-24 vale también al revés (sin_cupo=otro, el default): si el Claude oficial dice límite (sesión,
# semanal, rate limit, 429), se marca agotado hasta su reset (`reparto --agotar <modelo> --hasta`, y $LIMITE) y
# se relanza con el candidato que quede, que puede ser de Google. Con sin_cupo esperar o fallar no se relanza.
agy_sin_cupo() {
  [[ "$motor" == agy ]] || return 1
  local t; t="$(cat "$err" 2>/dev/null; res_texto)"
  grep -qiE 'RESOURCE_EXHAUSTED|Individual quota reached|(^|[^0-9])429([^0-9]|$)' <<<"$t"
}
claude_sin_cupo() {
  [[ "$motor" == claude ]] || return 1
  local t; t="$(res_texto)"
  grep -qiE 'session limit|usage limit|weekly limit|hit your limit|rate.?limit|(^|[^0-9])429([^0-9]|$)' <<<"$t"
}
# codex: "You've hit your usage limit" / rate limit / 429 (en el stream, en stderr o en el result).
codex_sin_cupo() {
  [[ "$motor" == codex ]] || return 1
  local t; t="$(cat "$err" "$transcript" 2>/dev/null; res_texto)"
  grep -qiE 'usage limit|hit your limit|rate.?limit|Too Many Requests|quota|(^|[^0-9])429([^0-9]|$)' <<<"$t"
}
sin_cupo_al_arrancar() { agy_sin_cupo || codex_sin_cupo || claude_sin_cupo; }
sin_trabajo_hecho() {
  [[ -z "$(git -C "$ruta_trabajo" status --porcelain 2>/dev/null)" ]] \
    && [[ "$(git -C "$ruta_trabajo" rev-list --count "${base:-HEAD}..HEAD" 2>/dev/null || echo 1)" == 0 ]]
}
cambiar_de_modelo() {   # $1 = modelo nuevo, $2 = su effort (sólo Claude)
  modelo="$1"; esfuerzo=""; unset PA_EFFORT
  if es_gemini "$modelo"; then
    motor=agy; ef_vacio="-"
  elif es_codex "$modelo"; then
    motor=codex; ef_vacio="-"
  else
    motor=claude; ef_vacio=""
    [[ -n "${2:-}" ]] && { esfuerzo="$2"; export PA_EFFORT="$2"; }
    # Sesión nueva: la del intento que chocó el límite puede haber quedado creada con ese id.
    (( resume )) || { sid="$(uuidgen)"; printf '%s' "$sid" >"$dir/$ts.sid"; }
    transcript="$PROJ/$(escapar "$ruta_trabajo")/$sid.jsonl"
  fi
  armar_llamada
  sed -i -e "s|^modelo=.*|modelo=$modelo|" -e "s|^effort=.*|effort=${esfuerzo:-${ef_vacio:-settings}}|" -e "s|^cuenta=.*|cuenta=$cuenta|" "$dir/$ts.hilo" 2>/dev/null || true
  escribir_running
}
reintentos_cupo=0
while (( reintentos_cupo < 3 )) && [[ "$SIN_CUPO" == otro && -n "$reparto_tipo_relanzable" && -x "$REPARTO" ]] \
      && { (( rc != 0 )) || es_error; } && sin_cupo_al_arrancar && sin_trabajo_hecho; do
  reintentos_cupo=$((reintentos_cupo+1))
  m_ant="$modelo"; hasta_args=()
  if [[ "$motor" == claude ]]; then
    quien="Claude dijo límite"
    if hasta="$(epoch_reset "$(res_texto)")"; then
      printf '%s' "$hasta" >"$LIMITE"
      hasta_args=( --hasta "$(date -u -d "@$hasta" +%Y-%m-%dT%H:%M:%SZ)" )
    fi
  elif [[ "$motor" == codex ]]; then
    quien="codex dijo sin cupo"
  else
    quien="agy dijo 429"
  fi
  # Se agota el grupo de ESA cuenta; el siguiente candidato prefiere otra cuenta del mismo proveedor.
  c_ant="$cuenta"; p_ant="$(proveedor_de_modelo "$m_ant")"
  REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" "$REPARTO" --agotar "$m_ant" "${hasta_args[@]}" ${c_ant:+--cuenta "$c_ant"} >/dev/null 2>&1 </dev/null || true
  rep_json="$(REPARTO_STATE="${REPARTO_STATE:-$STATE/reparto}" PA_STATE="$STATE" \
    timeout "${PA_REPARTO_TIMEOUT_S:-15}" "$REPARTO" --tipo "$reparto_tipo_relanzable" ${p_ant:+--mismo-proveedor "$p_ant"} --json 2>/dev/null </dev/null)" || rep_json=""
  m_rep=""; e_rep=""; mot_rep=""
  [[ -n "$rep_json" ]] && IFS='|' read -r m_rep e_rep mot_rep < <(
    jq -r '[(.modelo // ""), (.effort // ""), ((.motivo // "") | gsub("[\\r\\n\\t|]+"; " "))] | join("|")' <<<"$rep_json" 2>/dev/null
  ) || true
  # Todo lleno: reparto da el más barato, que también va a chocar; no vale relanzar.
  [[ "$(jq -r '.todo_lleno // false' <<<"$rep_json" 2>/dev/null)" == true ]] && m_rep=""
  c_rep="$(jq -r '.cuenta // ""' <<<"$rep_json" 2>/dev/null)"; [[ -n "$c_rep" ]] || c_rep="$(proveedor_de_modelo "$m_rep")"
  if [[ -z "$m_rep" || ( "$m_rep" == "$m_ant" && "$c_rep" == "${c_ant:-$p_ant}" ) ]] || es_local "$m_rep" || [[ "${m_rep,,}" != @(claude-*|gemini-*|agy:*|codex:*) ]] \
     || { ! es_codex "$m_rep" && ! cuenta_preparar "$c_rep" "$(proveedor_de_modelo "$m_rep")" 2>/dev/null; }; then
    echo "pa: $quien (sin cupo) con $m_ant, lo marqué como agotado, pero reparto no ofrece otro candidato con cupo; sigo como falló." >&2
    cuenta_preparar "${c_ant:-$p_ant}" "$p_ant" 2>/dev/null || true
    break
  fi
  if es_gemini "$m_rep" || es_codex "$m_rep"; then
    if es_codex "$m_rep"; then codex_chequear "$m_rep"; else gemini_chequear "$m_rep"; fi
    if [[ -n "$motivo_cae" ]]; then
      echo "pa: $quien (sin cupo) con $m_ant; reparto ofrece $m_rep pero no puede correr ($motivo_cae); sigo como falló." >&2
      cuenta_preparar "${c_ant:-$p_ant}" "$p_ant" 2>/dev/null || true
      break
    fi
  fi
  c_txt=""; [[ "$cuenta" != "$c_ant" && "$cuenta" != claude && "$cuenta" != google ]] && c_txt=" (cuenta $cuenta)"
  echo "pa: $quien (sin cupo) con $m_ant: lo marco agotado hasta que vuelva y relanzo con $m_rep${e_rep:+ effort $e_rep}$c_txt: $mot_rep" >&2
  cambiar_de_modelo "$m_rep" "$e_rep"
  rc=0; correr || rc=$?
done

if (( rc != 0 )) || es_error; then
  texto="$(res_texto)"

  # 1. límite de sesión de la suscripción. No es rate limit: no se arregla reintentando.
  if [[ "$texto" == *"session limit"* ]]; then
    if hasta="$(epoch_reset "$texto")"; then
      printf '%s' "$hasta" >"$LIMITE"
      echo "pa: límite de sesión de la suscripción. Se libera $(date -d "@$hasta" '+%H:%M'). Sesión de '$slug' INTACTA." >&2
    else
      echo "pa: límite de sesión de la suscripción (no pude parsear la hora de reset). Sesión de '$slug' INTACTA." >&2
    fi
    echo "$texto" >&2
    exit 76
  fi

  # 2. 529: server-side y temporal. Un reintento, y con el MISMO sid.
  if [[ "$texto" == *"529"* || "$texto" == *"Overloaded"* ]]; then
    echo "pa: API sobrecargada (529). Reintento único en 60s…" >&2
    sleep 60
    rc=0; correr || rc=$?
    if (( rc == 0 )) && ! es_error; then
      : # salió bien, sigue el camino normal abajo
    else
      echo "pa: sigue sobrecargada. Sesión de '$slug' INTACTA, reintentá más tarde." >&2
      res_texto >&2
      exit 77
    fi
  fi
fi

# 3. sesión guardada que ya no existe: el ÚNICO caso donde relanzar limpio es correcto.
if (( rc != 0 )) || es_error; then
  if (( resume )) && grep -q 'No conversation found with session ID' "$err" 2>/dev/null; then
    echo "pa: la sesión guardada de '$slug' ya no existe; arranco una limpia." >&2
    (( leer )) || rm -f "$sfile"
    resume=0; sid="$(uuidgen)"
    transcript="$PROJ/$(escapar "$ruta_trabajo")/$sid.jsonl"
    # Por índice y no con "${args[@]/…}": esa expansión sustituye el texto en TODOS los
    # elementos, incluida la tarea, y una tarea que menciona --resume salía reescrita.
    for i in "${!args[@]}"; do
      [[ "${args[$i]}" == "--resume" ]] || continue
      args[$i]="--session-id"; args[$((i+1))]="$sid"
    done
    escribir_running
    rc=0; correr || rc=$?
  fi
fi

# 3b. se quedó sin turnos. No es un fallo de infra y el trabajo casi siempre está en el
# working tree, así que NO puede caer en el camino 4 (que sale 1 sin guardar la sesión y deja
# al jefe sin forma de cerrarlo). Para el jefe es el mismo caso que un worker que terminó sin
# el bloque RESULTADO: código 78, cuántos archivos quedaron sucios, y cómo cerrarlo.
if [[ "$(jq -r '.subtype // ""' "$out" 2>/dev/null)" == "error_max_turns" ]]; then
  nuevo_sid="$(jq -r '.session_id // empty' "$out")"
  [[ -n "$nuevo_sid" ]] && guardar_sesion "$nuevo_sid"
  res_texto >&2
  stats_resultado "$out" >&2
  echo "pa: el worker de '$slug' se quedó sin turnos (tope ${max_turns:-?})." >&2

  # Auto-cierre. En este estado la única acción sensata es un resume corto que commitee lo
  # suyo y reporte, y hasta el 2026-09-13 eso lo tenía que escribir el jefe a mano: un viaje
  # de ida y vuelta de minutos, y (el caso que motivó todo esto) una oportunidad más para que
  # el jefe INVENTE qué quedó colgando antes de saberlo.
  # Va EN ESTE PROCESO, no con un `pa` hijo: el hijo chocaría contra nuestro propio flock y
  # saldría 75. PA_CIERRE corta cualquier recursión: un cierre que también se queda sin turnos
  # no se auto-cierra.
  # En --leer no hay nada que commitear ni sesión que valga la pena gastar: no se auto-cierra.
  if [[ -n "$nuevo_sid" && -z "${PA_CIERRE:-}" ]] && (( ! leer )); then
    echo "pa: lo cierro solo (resume de hasta $CIERRE_TURNOS turnos)…" >&2
    cp -f "$out" "$dir/$ts.sin-turnos.json" 2>/dev/null || true
    # La corrida que se quedó sin turnos también se mide, en la MISMA fila que el cierre: el
    # trap suma este JSON con el del cierre (medir).
    json_previo="$dir/$ts.sin-turnos.json"
    args=( -p "$CIERRE_TAREA"
           --model "$modelo"
           ${esfuerzo:+--effort "$esfuerzo"}
           --output-format json
           --append-system-prompt "$contrato"
           --permission-mode bypassPermissions
           --autocompact "$AUTOCOMPACT"
           --settings "$settings_json"
           --name "$nombre_worker"
           --resume "$nuevo_sid"
           --max-turns "$CIERRE_TURNOS" )
    (( con_mcp )) || args+=( --strict-mcp-config --mcp-config '{"mcpServers":{}}' )
    # Las mismas tools que la corrida: el cache es prefijo (tools → system → mensajes) y una lista
    # distinta reescribiría TODO el contexto del resume a precio de escritura.
    [[ "$PLAN" == pro ]] && args+=( --disallowedTools "Agent" )
    [[ -n "$max_budget" ]] && args+=( --max-budget-usd "$max_budget" )
    export PA_MAX_TURNS="$CIERRE_TURNOS" PA_CIERRE=1
    rm -f "$hb.turnos"
    rc=0; correr || rc=$?
    if (( rc == 0 )) && ! es_error && grep -q 'RESULTADO:' <<<"$(res_texto)"; then
      echo "pa: cerrado. (El worker se había quedado sin turnos; esto es el resultado del cierre.)" >&2
      mostrar_resultado "$out"
      nuevo_sid="$(jq -r '.session_id // empty' "$out")"
      [[ -n "$nuevo_sid" ]] && guardar_sesion "$nuevo_sid"
      delta_sucios "$ruta_trabajo" "$base_delta" "$inicio" | sed 's/^/pa: /' >&2 || true
      exit 0
    fi
    echo "pa: el cierre automático tampoco terminó bien." >&2
  fi

  delta_sucios "$ruta_trabajo" "$base_delta" "$inicio" | sed 's/^/pa: /' >&2 || true
  echo "pa: para cerrarlo a mano: pa '$proyecto' --seguir --id $ts 'commiteá lo que hiciste y reportá'." >&2
  exit 78
fi

# 3c. la instalación de claude se rompió (un auto-update a mitad de la corrida, o entre el chequeo
# de arriba y el lanzamiento). No es un fallo del worker: código propio, y el arreglo escrito.
if (( rc != 0 )) || es_error; then
  # Sólo stderr y 127, no el .result: un worker que falla por otra cosa citando este bug (la
  # frase está en BUGS-WORKERS-2026-09-14.md) saldría 81 en vez de 1.
  if [[ "$motor" == claude ]] && { (( rc == 127 )) || es_claude_roto "$(cat "$err" 2>/dev/null)"; }; then
    rc_c="$(claude_rc)"; claude_falla "$rc_c" "$(cat "$err" 2>/dev/null)"
    exit "$rc_c"
  fi
fi

# 4. cualquier otro fallo: mostrar el motivo de verdad (.result), NO tocar la sesión guardada.
if (( rc != 0 )) || es_error; then
  echo "pa: el worker de '$slug' falló." >&2
  texto="$(res_texto)"
  if [[ -n "$texto" ]]; then echo "$texto" >&2; else tail -n 20 "$err" >&2; fi
  exit 1
fi

# --- salida ------------------------------------------------------------------------------
mostrar_resultado "$out"

# El session_id se guarda SÓLO si el run salió bien: un run que falló devuelve un id de una
# sesión que no sirve, y guardarlo pisaba el bueno.
nuevo_sid="$(jq -r '.session_id // empty' "$out")"
[[ -n "$nuevo_sid" ]] && guardar_sesion "$nuevo_sid"

# Terminó "bien" pero sin el bloque pactado: típico worker que se quedó sin turnos esperando
# un comando en background ("Waiting for the background test run…") y dejó todo sin
# commitear. No es un éxito: código propio, y se muestra cuánto quedó sin commitear. La
# sesión ya quedó guardada arriba, así que un `--seguir "commiteá y reportá"` la cierra.
# Con el tree limpio es otra cosa y no hay que tratarla igual: el worker que manda el
# resultado por SendMessage a veces acorta la respuesta final a "ya te avisé por mensaje", y
# ahí no hay trabajo en riesgo, sólo un bloque mal formateado. El 78 se mantiene (el que llama
# tiene que poder distinguirlo de un éxito) pero el mensaje no manda a cerrar nada que ya está
# cerrado. El CONTRATO ahora dice explícito que el mensaje no reemplaza la respuesta final.
if ! grep -q 'RESULTADO:' <<<"$(res_texto)"; then
  echo "pa: el worker de '$slug' terminó SIN el bloque RESULTADO (arriba está lo que dijo)." >&2
  # El delta, no el total: lo que ya estaba sucio al arrancar no es trabajo de este worker en
  # riesgo, y tratarlo como si lo fuera es lo que hizo que el jefe reportara como perdido un
  # rediseño de otra sesión que llevaba ocho días sin commitear (2026-09-13, widgets-reactivos).
  if msg="$(delta_sucios "$ruta_trabajo" "$base_delta" "$inicio")"; then
    echo "pa: $msg Cerralo con: pa '$proyecto' --seguir --id $ts 'commiteá lo que hiciste y reportá'." >&2
  else
    echo "pa: $msg No hay nada que cerrar. Si te mandó el resultado por SendMessage, ése es el bueno; si no, pedíselo con: pa '$proyecto' --seguir --id $ts 'reportá lo que hiciste'." >&2
  fi
  exit 78
fi

if (( resume )) && [[ -n "$edad_h" ]] && (( edad_h >= 24 )); then
  echo "— (retomaste una sesión de hace ${edad_h}h; sin --seguir arranca limpia y pesa menos)"
fi
exit 0
